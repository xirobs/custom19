<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_insurance_policy" model="ir.sequence">
            <field name="name">Número de póliza</field>
            <field name="code">insurance.policy</field>
            <field name="prefix">POL/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_insurance_claim" model="ir.sequence">
            <field name="name">Folio de siniestro</field>
            <field name="code">insurance.claim</field>
            <field name="prefix">SIN/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
