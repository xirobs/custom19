<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="module_category_insurance_management">
            <field name="name">Gestión de Seguros</field>
            <field name="description">Niveles de acceso al módulo de aseguradoras</field>
            <field name="sequence">20</field>
        </record>

        <record id="privilege_insurance_management" model="res.groups.privilege">
            <field name="name">Gestión de Seguros</field>
            <field name="category_id" ref="module_category_insurance_management"/>
        </record>

        <record id="group_insurance_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="privilege_id" ref="privilege_insurance_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_invoice')), (4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <record id="group_insurance_manager" model="res.groups">
            <field name="name">Administrador</field>
            <field name="privilege_id" ref="privilege_insurance_management"/>
            <field name="implied_ids" eval="[(4, ref('group_insurance_user'))]"/>
        </record>
    </data>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_insurance_manager'))]"/>
    </record>
</odoo>
