<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_insurance_policy" model="ir.actions.report">
        <field name="name">Resumen de póliza</field>
        <field name="model">insurance.policy</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">insurance_management.report_insurance_policy_document</field>
        <field name="report_file">insurance_management.report_insurance_policy_document</field>
        <field name="print_report_name">'Póliza - %s' % (object.name)</field>
        <field name="binding_type">report</field>
        <field name="binding_model_id" ref="model_insurance_policy"/>
    </record>

    <record id="action_report_insurance_receipt" model="ir.actions.report">
        <field name="name">Comprobante de pago</field>
        <field name="model">insurance.installment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">insurance_management.report_insurance_receipt_document</field>
        <field name="report_file">insurance_management.report_insurance_receipt_document</field>
        <field name="print_report_name">'Comprobante - %s cuota %s' % (object.policy_id.name, object.number)</field>
        <field name="binding_type">report</field>
        <field name="binding_model_id" ref="model_insurance_installment"/>
    </record>

    <record id="action_report_insurance_claim" model="ir.actions.report">
        <field name="name">Seguimiento de siniestro</field>
        <field name="model">insurance.claim</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">insurance_management.report_insurance_claim_document</field>
        <field name="report_file">insurance_management.report_insurance_claim_document</field>
        <field name="print_report_name">'Siniestro - %s' % (object.name)</field>
        <field name="binding_type">report</field>
        <field name="binding_model_id" ref="model_insurance_claim"/>
    </record>
</odoo>
