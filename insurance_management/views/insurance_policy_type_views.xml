<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_insurance_policy_type_list" model="ir.ui.view">
        <field name="name">insurance.policy.type.list</field>
        <field name="model">insurance.policy.type</field>
        <field name="arch" type="xml">
            <list string="Ramos">
                <field name="name"/>
                <field name="code"/>
                <field name="offer_count"/>
                <field name="scheme_count"/>
            </list>
        </field>
    </record>

    <record id="view_insurance_policy_type_form" model="ir.ui.view">
        <field name="name">insurance.policy.type.form</field>
        <field name="model">insurance.policy.type</field>
        <field name="arch" type="xml">
            <form string="Ramo">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Descripción del ramo..."/>
                    <separator string="Ofertas del ramo"/>
                    <field name="offer_ids" context="{'default_ramo_id': id}">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="parent_id" string="Sub-oferta de"/>
                            <field name="sub_offer_free_text"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_insurance_policy_type" model="ir.actions.act_window">
        <field name="name">Ramos</field>
        <field name="res_model">insurance.policy.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
