<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_insurance_company_list" model="ir.ui.view">
        <field name="name">insurance.company.list</field>
        <field name="model">insurance.company</field>
        <field name="arch" type="xml">
            <list string="Compañías aseguradoras">
                <field name="name"/>
                <field name="code"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="policy_count"/>
            </list>
        </field>
    </record>

    <record id="view_insurance_company_form" model="ir.ui.view">
        <field name="name">insurance.company.form</field>
        <field name="model">insurance.company</field>
        <field name="arch" type="xml">
            <form string="Compañía aseguradora">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_policies" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="policy_count" widget="statinfo" string="Pólizas"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="partner_id"/>
                            <field name="vat"/>
                            <field name="country_id"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="website"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notas internas..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_insurance_company_search" model="ir.ui.view">
        <field name="name">insurance.company.search</field>
        <field name="model">insurance.company</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
            </search>
        </field>
    </record>

    <record id="action_insurance_company" model="ir.actions.act_window">
        <field name="name">Compañías aseguradoras</field>
        <field name="res_model">insurance.company</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_insurance_company_search"/>
    </record>
</odoo>
