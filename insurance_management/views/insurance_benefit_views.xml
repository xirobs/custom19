<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_insurance_benefit_list" model="ir.ui.view">
        <field name="name">insurance.benefit.list</field>
        <field name="model">insurance.benefit</field>
        <field name="arch" type="xml">
            <list string="Beneficios" editable="bottom">
                <field name="code"/>
                <field name="name" placeholder="Ej. Vida Mujer — beneficio básico"/>
                <field name="ramo_id" options="{'no_create': True}"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_insurance_benefit_search" model="ir.ui.view">
        <field name="name">insurance.benefit.search</field>
        <field name="model">insurance.benefit</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="ramo_id"/>
                <filter name="archived" string="Archivados" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_ramo" string="Ramo" context="{'group_by': 'ramo_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_insurance_benefit" model="ir.actions.act_window">
        <field name="name">Beneficios</field>
        <field name="res_model">insurance.benefit</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_insurance_benefit_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registre las claves de beneficio de la aseguradora</p>
            <p>Se crean solas al cargar una carátula (VM, BAM UI, PCF A…). Aquí puede agregar su descripción.</p>
        </field>
    </record>
</odoo>
