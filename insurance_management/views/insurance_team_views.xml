<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== Tipos de trámite ===================== -->
    <record id="view_insurance_procedure_type_list" model="ir.ui.view">
        <field name="name">insurance.procedure.type.list</field>
        <field name="model">insurance.procedure.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="days"/>
                <field name="icon"/>
                <field name="requirements"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_insurance_procedure_type" model="ir.actions.act_window">
        <field name="name">Tipos de trámite</field>
        <field name="res_model">insurance.procedure.type</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <!-- ===================== Trámites ===================== -->
    <record id="view_insurance_procedure_search" model="ir.ui.view">
        <field name="name">insurance.procedure.search</field>
        <field name="model">insurance.procedure</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="policy_id"/>
                <field name="type_id"/>
                <field name="user_id"/>
                <filter name="mine" string="Asignados a mí" domain="[('user_id', '=', uid)]"/>
                <filter name="open" string="Abiertos" domain="[('state', 'not in', ['done', 'cancelled'])]"/>
                <filter name="late" string="Atrasados" domain="[('is_late', '=', True)]"/>
                <separator/>
                <filter name="group_type" string="Trámite" context="{'group_by': 'type_id'}"/>
                <filter name="group_user" string="Asignado a" context="{'group_by': 'user_id'}"/>
                <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_insurance_procedure_list" model="ir.ui.view">
        <field name="name">insurance.procedure.list</field>
        <field name="model">insurance.procedure</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_late" decoration-muted="state in ('done', 'cancelled')">
                <field name="name"/>
                <field name="type_id"/>
                <field name="partner_id"/>
                <field name="policy_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="date_deadline"/>
                <field name="insurer_folio" optional="hide"/>
                <field name="is_late" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'" decoration-warning="state in ('in_progress', 'insurer')"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_insurance_procedure_kanban" model="ir.ui.view">
        <field name="name">insurance.procedure.kanban</field>
        <field name="model">insurance.procedure</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="is_late"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="type_id" class="fw-bold"/>
                            <field name="name" class="text-muted small"/>
                        </div>
                        <field name="partner_id"/>
                        <field name="policy_id" class="small text-muted"/>
                        <footer class="d-flex justify-content-between align-items-center">
                            <span t-att-class="record.is_late.raw_value ? 'text-danger fw-bold' : ''">
                                <i class="fa fa-calendar me-1" title="Fecha límite"/><field name="date_deadline"/>
                            </span>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_insurance_procedure_form" model="ir.ui.view">
        <field name="name">insurance.procedure.form</field>
        <field name="model">insurance.procedure</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Empezar" class="btn-primary"
                            invisible="state != 'new'"/>
                    <button name="action_to_insurer" type="object" string="Enviado a la aseguradora"
                            invisible="state not in ('new', 'in_progress')"/>
                    <button name="action_done" type="object" string="Terminado" class="btn-primary"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reopen" type="object" string="Reabrir"
                            invisible="state not in ('done', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,in_progress,insurer,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="type_id" options="{'no_create': True}"/>
                            <field name="policy_id"/>
                            <field name="partner_id"/>
                            <field name="insurer_folio"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="date_deadline"/>
                            <field name="date_done" invisible="state != 'done'"/>
                            <field name="is_late" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status" invisible="not requirements">
                        <strong>Requisitos:</strong> <field name="requirements" class="d-inline"/>
                    </div>
                    <group>
                        <field name="description" placeholder="Qué pide el cliente…"/>
                        <field name="result" placeholder="Cómo se resolvió…"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_insurance_procedure" model="ir.actions.act_window">
        <field name="name">Trámites</field>
        <field name="res_model">insurance.procedure</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra el primer trámite</p>
            <p>Cambio de tarjeta o beneficiarios, envío de documentos, actualización de datos, vencimientos,
               rehabilitaciones, cambio de domicilio y beneficio de maternidad. Asígnalo a alguien del equipo
               y lo verá en su portal.</p>
        </field>
    </record>

    <!-- ===================== Emisiones (pólizas por etapa) ===================== -->
    <record id="view_insurance_policy_emission_kanban" model="ir.ui.view">
        <field name="name">insurance.policy.emission.kanban</field>
        <field name="model">insurance.policy</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <kanban default_group_by="emission_stage" quick_create="false">
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold"/>
                            <field name="state" widget="badge" class="small"/>
                        </div>
                        <field name="partner_id"/>
                        <div class="small text-muted"><field name="policy_type_id"/> · <field name="insurance_company_id"/></div>
                        <footer class="d-flex justify-content-between align-items-center">
                            <field name="policy_amount" widget="monetary"/>
                            <field name="team_user_id" widget="many2one_avatar_user"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_insurance_emission" model="ir.actions.act_window">
        <field name="name">Emisiones</field>
        <field name="res_model">insurance.policy</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_insurance_policy_emission_kanban')})]"/>
        <field name="domain">[('state', '!=', 'cancelled')]</field>
        <field name="context">{'default_emission_stage': 'request'}</field>
    </record>

    <!-- Póliza: emisión, entrega y asignación -->
    <record id="view_insurance_policy_form_team" model="ir.ui.view">
        <field name="name">insurance.policy.form.team</field>
        <field name="model">insurance.policy</field>
        <field name="inherit_id" ref="view_insurance_policy_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_procedures" type="object" class="oe_stat_button" icon="fa-tasks">
                    <field name="procedure_count" widget="statinfo" string="Trámites"/>
                </button>
            </div>
            <field name="user_id" position="after">
                <field name="team_user_id" widget="many2one_avatar_user"/>
                <field name="emission_stage"/>
                <field name="delivery_date" invisible="emission_stage != 'delivered'"/>
                <field name="delivery_method" invisible="emission_stage != 'delivered'"/>
            </field>
        </field>
    </record>

    <record id="view_insurance_claim_form_team" model="ir.ui.view">
        <field name="name">insurance.claim.form.team</field>
        <field name="model">insurance.claim</field>
        <field name="inherit_id" ref="view_insurance_claim_form"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="team_user_id" widget="many2one_avatar_user"/>
            </field>
        </field>
    </record>

    <record id="view_crm_lead_form_team" model="ir.ui.view">
        <field name="name">crm.lead.form.team</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="view_crm_lead_form_insurance"/>
        <field name="arch" type="xml">
            <field name="insurance_origin" position="after">
                <field name="team_user_id" widget="many2one_avatar_user"/>
                <field name="insurance_lost_note"/>
            </field>
        </field>
    </record>

    <!-- Usuarios: qué bloques del portal del equipo ve cada persona -->
    <record id="view_users_form_insurance_team" model="ir.ui.view">
        <field name="name">res.users.form.insurance.team</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Vive Seguro · Portal del equipo" name="insurance_team_portal"
                      groups="insurance_management.group_insurance_manager">
                    <p class="text-muted">
                        Marca lo que esta persona trabaja. Lo verá en <b>/equipo</b> (desde su cuenta del portal o
                        del sistema), en el celular o la computadora.
                    </p>
                    <group>
                        <group string="Bloques">
                            <field name="ins_portal_portfolio"/>
                            <field name="ins_agent_ids" widget="many2many_tags" readonly="1" invisible="not ins_agent_ids"
                                   string="Asesor vinculado"/>
                            <div colspan="2" class="text-muted small" invisible="not ins_portal_portfolio or ins_agent_ids">
                                Para ver su cartera, vincula a esta persona en Seguros › Asesores (campo «Usuario»).
                            </div>
                            <field name="ins_portal_emission"/>
                            <field name="ins_portal_procedure"/>
                            <field name="ins_portal_claim"/>
                            <field name="ins_portal_collection"/>
                            <field name="ins_portal_crm"/>
                            <field name="ins_portal_renewal"/>
                            <field name="ins_portal_anniversary"/>
                        </group>
                        <group string="Supervisión">
                            <field name="ins_portal_all"/>
                        </group>
                    </group>
                    <field name="share" invisible="1"/>
                    <div invisible="share" class="alert alert-info d-flex align-items-center gap-3" role="status">
                        <div class="flex-grow-1">
                            Este usuario es <b>interno</b>: ocupa licencia y entra al sistema completo.
                            Si solo va a trabajar en el portal del equipo, conviértelo en usuario de portal
                            (conserva lo que marcaste arriba).
                        </div>
                        <button name="action_insurance_make_portal" type="object" class="btn btn-secondary"
                                string="Convertir en usuario de portal"
                                confirm="Este usuario dejará de entrar al sistema completo y solo usará el portal (/equipo y Mi cuenta). ¿Continuar?"/>
                    </div>
                    <div invisible="not share" class="alert alert-success" role="status">
                        Usuario de <b>portal</b>: entra a <b>/equipo</b> con su correo y contraseña. No ocupa licencia.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Asesor: activar su acceso al portal (celular o tablet) -->
    <record id="view_insurance_agent_form_portal" model="ir.ui.view">
        <field name="name">insurance.agent.form.portal</field>
        <field name="model">insurance.agent</field>
        <field name="inherit_id" ref="view_insurance_agent_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <field name="portal_ready" invisible="1"/>
                    <button name="action_insurance_portal_access" type="object" class="btn-primary" icon="fa-mobile"
                            string="Activar acceso al portal" invisible="portal_ready"
                            groups="insurance_management.group_insurance_manager"
                            confirm="Se creará (o activará) su usuario de portal con «Mi cartera» y CRM, y se le enviará la invitación por correo. ¿Continuar?"/>
                    <span invisible="not portal_ready" class="badge text-bg-success align-self-center">
                        <i class="fa fa-mobile me-1" title="Portal"/>Con acceso al portal
                    </span>
                </header>
            </xpath>
        </field>
    </record>

    <!-- Ramo: qué seguimiento anual lleva (renovación GMM / aniversario vida) -->
    <record id="view_insurance_policy_type_list_followup" model="ir.ui.view">
        <field name="name">insurance.policy.type.list.followup</field>
        <field name="model">insurance.policy.type</field>
        <field name="inherit_id" ref="view_insurance_policy_type_list"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="renewal_kind"/>
            </field>
        </field>
    </record>
    <record id="view_insurance_policy_type_form_followup" model="ir.ui.view">
        <field name="name">insurance.policy.type.form.followup</field>
        <field name="model">insurance.policy.type</field>
        <field name="inherit_id" ref="view_insurance_policy_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//field[@name='name']" position="after">
                <field name="renewal_kind"/>
            </xpath>
        </field>
    </record>

    <!-- ===================== Menús ===================== -->
    <menuitem id="menu_insurance_emissions" name="Emisiones"
              parent="menu_insurance_policy_root" action="action_insurance_emission" sequence="12"/>
    <menuitem id="menu_insurance_procedures" name="Trámites"
              parent="menu_insurance_root" action="action_insurance_procedure" sequence="28"/>
    <menuitem id="menu_insurance_procedure_type" name="Tipos de trámite"
              parent="menu_insurance_config" action="action_insurance_procedure_type" sequence="52"/>
</odoo>
