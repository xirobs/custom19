<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_insurance" model="ir.ui.view">
        <field name="name">crm.lead.form.insurance</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_insurance_policy" type="object"
                        string="Crear póliza" class="btn-primary"
                        invisible="not (insurance_scheme_id or insurance_policy_type_id) or insurance_policy_id"/>
                <button name="action_open_insurance_policy" type="object"
                        string="Ver póliza"
                        invisible="not insurance_policy_id"/>
                <button name="action_send_insurance_message" type="object"
                        string="Enviar mensaje" invisible="not is_insurance_opportunity"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Seguros" name="insurance">
                    <group>
                        <group>
                            <field name="is_insurance_opportunity"/>
                            <field name="insurance_origin"/>
                            <field name="insurance_policy_type_id" options="{'no_create': True}"/>
                            <field name="insurance_offer_id" options="{'no_create': True}"/>
                            <field name="insurance_scheme_id"/>
                            <field name="insurance_company_id"/>
                            <field name="insurance_policy_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="estimated_premium"/>
                            <field name="estimated_insured_amount"/>
                            <field name="insurance_coverage_mode"/>
                            <field name="insurance_duration_months"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_crm_lead_search_insurance" model="ir.ui.view">
        <field name="name">crm.lead.search.insurance</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="insurance_opps" string="Oportunidades de seguros"
                        domain="['|', '|', ('is_insurance_opportunity', '=', True), ('insurance_scheme_id', '!=', False), ('insurance_policy_id', '!=', False)]"/>
                <filter name="insurance_with_offer" string="Con oferta o póliza"
                        domain="['|', ('insurance_scheme_id', '!=', False), ('insurance_policy_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_crm_lead_search_insurance_pipeline" model="ir.ui.view">
        <field name="name">crm.lead.search.insurance.pipeline</field>
        <field name="model">crm.lead</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <search string="Oportunidades de seguros">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="insurance_policy_type_id"/>
                <field name="insurance_scheme_id"/>
                <field name="insurance_company_id"/>
                <filter name="cross_sell" string="Venta cruzada" domain="[('insurance_origin', '=', 'cross_sell')]"/>
                <filter name="this_month" string="Creados este mes" domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <filter name="assigned_to_me" string="Mis oportunidades" domain="[('user_id', '=', uid)]"/>
                <filter name="unassigned" string="Sin asignar" domain="[('user_id', '=', False)]"/>
                <filter name="insurance_with_offer" string="Con oferta o póliza"
                        domain="['|', ('insurance_scheme_id', '!=', False), ('insurance_policy_id', '!=', False)]"/>
                <separator/>
                <filter name="inactive" string="Archivadas" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_stage" string="Etapa" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_user" string="Comercial" context="{'group_by': 'user_id'}"/>
                    <filter name="group_scheme" string="Oferta" context="{'group_by': 'insurance_scheme_id'}"/>
                    <filter name="group_ramo" string="Ramo" context="{'group_by': 'insurance_policy_type_id'}"/>
                    <filter name="group_origin" string="Origen" context="{'group_by': 'insurance_origin'}"/>
                    <filter name="group_month" string="Mes de creación" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_insurance_crm_leads" model="ir.actions.act_window">
        <field name="name">Oportunidades de seguros</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph,activity</field>
        <field name="search_view_id" ref="view_crm_lead_search_insurance_pipeline"/>
        <field name="domain">['&amp;', ('type', '=', 'opportunity'), '|', '|', ('is_insurance_opportunity', '=', True), ('insurance_scheme_id', '!=', False), ('insurance_policy_id', '!=', False)]</field>
        <field name="context">{
            'default_type': 'opportunity',
            'default_is_insurance_opportunity': True,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree la primera oportunidad de seguros</p>
            <p>Queda en este tablero, no en el CRM comercial, aunque todavía no elija la oferta.</p>
        </field>
    </record>

    <!-- El tablero del CRM comercial no mezcla oportunidades de seguros. -->
    <record id="crm.crm_lead_opportunities" model="ir.actions.act_window">
        <field name="domain">[('type', '=', 'opportunity'), ('is_insurance_opportunity', '=', False)]</field>
    </record>
    <record id="crm.crm_lead_action_pipeline" model="ir.actions.act_window">
        <field name="domain">[('type', '=', 'opportunity'), ('is_insurance_opportunity', '=', False)]</field>
    </record>
    <record id="crm.crm_lead_action_forecast" model="ir.actions.act_window">
        <field name="domain">[('type', '=', 'opportunity'), ('is_insurance_opportunity', '=', False)]</field>
    </record>
    <record id="crm.crm_case_form_view_salesteams_opportunity" model="ir.actions.act_window">
        <field name="domain">[('type', '=', 'opportunity'), ('is_insurance_opportunity', '=', False)]</field>
    </record>
</odoo>
