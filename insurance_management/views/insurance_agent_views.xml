<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_insurance_agent_list" model="ir.ui.view">
        <field name="name">insurance.agent.list</field>
        <field name="model">insurance.agent</field>
        <field name="arch" type="xml">
            <list string="Agentes">
                <field name="name"/>
                <field name="agent_code"/>
                <field name="branch_id"/>
                <field name="insurance_company_id"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="policy_count"/>
                <field name="commission_month" optional="show"/>
                <field name="commission_to_pay" optional="show"/>
                <field name="company_currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_insurance_agent_form" model="ir.ui.view">
        <field name="name">insurance.agent.form</field>
        <field name="model">insurance.agent</field>
        <field name="arch" type="xml">
            <form string="Agente">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_policies" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="policy_count" widget="statinfo" string="Pólizas"/>
                        </button>
                        <button name="action_open_commissions" type="object" class="oe_stat_button" icon="fa-percent">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="commission_to_pay" widget="monetary"/></span>
                                <span class="o_stat_text">Comisión por liquidar</span>
                            </div>
                        </button>
                        <field name="company_currency_id" invisible="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="agent_code"/>
                            <field name="partner_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="branch_id"/>
                            <field name="insurance_company_id"/>
                            <field name="mobile"/>
                            <field name="email"/>
                            <field name="date_start"/>
                            <field name="commission_rate" string="Comisión por defecto (%)"/>
                            <field name="commission_month"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Comisiones según contrato" name="rules">
                            <div class="text-muted mb-2">
                                Se aplica la regla más específica (aseguradora y ramo). Si no hay regla, se usa la comisión por defecto.
                            </div>
                            <field name="commission_rule_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="insurance_company_id" placeholder="Todas"/>
                                    <field name="ramo_id" placeholder="Todos"/>
                                    <field name="rate_first_year"/>
                                    <field name="rate_renewal"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Claves y carteras" name="keys">
                            <field name="key_ids">
                                <list editable="bottom">
                                    <field name="insurance_company_id"/>
                                    <field name="name"/>
                                    <field name="portfolio_name"/>
                                    <field name="date_start"/>
                                    <field name="policy_count"/>
                                    <field name="customer_count"/>
                                    <button name="action_open_portfolio" type="object" string="Ver cartera" icon="fa-folder-open"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_insurance_agent" model="ir.actions.act_window">
        <field name="name">Detalle del agente</field>
        <field name="res_model">insurance.agent</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
