<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_discuss_meeting_recording_send_wizard_form" model="ir.ui.view">
        <field name="name">discuss.meeting.recording.send.wizard.form</field>
        <field name="model">discuss.meeting.recording.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Meeting Recording &amp; Notes">
                <group>
                    <field name="recording_id" invisible="1"/>
                    <field name="partner_ids" widget="many2many_tags"
                           options="{'no_create': True}"
                           placeholder="Attendees with an email on file..."/>
                    <field name="extra_emails" placeholder="guest1@example.com, guest2@example.com"/>
                    <field name="note" placeholder="Optional message to include above the notes..."/>
                </group>
                <footer>
                    <button name="action_send" string="Send" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_discuss_meeting_recording_send_wizard" model="ir.actions.act_window">
        <field name="name">Send Meeting Recording &amp; Notes</field>
        <field name="res_model">discuss.meeting.recording.send.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
