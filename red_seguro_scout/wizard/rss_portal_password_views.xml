<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rss_portal_password_view_form" model="ir.ui.view">
        <field name="name">rss.portal.password.form</field>
        <field name="model">rss.portal.password</field>
        <field name="arch" type="xml">
            <form string="Contraseña del portal" class="o_rss">
                <div class="alert alert-info" role="status">
                    Asigna la contraseña y compártela con la persona por WhatsApp.
                    Después ella la puede cambiar desde <b>Mi cuenta › Seguridad</b>.
                </div>
                <group>
                    <field name="user_id" invisible="1"/>
                    <field name="login" readonly="1"/>
                    <field name="portal_url" readonly="1" widget="url"/>
                    <field name="password" password="True"/>
                    <field name="confirm" password="True"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Asignar contraseña" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
