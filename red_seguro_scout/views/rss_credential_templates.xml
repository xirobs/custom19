<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Credencial del seguro: 62 × 84 mm, frente y reverso. Medidas en mm para imprimir a tamaño real.
         Variable c = rss.insured._credential_values() -->
    <template id="rss_credential_styles" name="Credencial: estilos">
        <style>
            .rssc-pair { display: inline-block; white-space: nowrap; margin: 0 0 4mm 0; page-break-inside: avoid; }
            .rssc { position: relative; display: inline-block; vertical-align: top; width: 62mm; height: 84mm; overflow: hidden;
                border-radius: 4.5mm; background: #FBF4EA; color: #1E2B3A; white-space: normal; margin-right: 4mm; text-align: left;
                font-family: "Montserrat", "Segoe UI", Helvetica, Arial, sans-serif; box-shadow: 0 0.6mm 2mm rgba(0, 0, 0, .25);
                border: 0.2mm solid #e7dccd; }
            .rssc:last-child { margin-right: 0; }
            .rssc * { box-sizing: border-box; }
            .rssc .abs { position: absolute; }
            .rssc .mnt { position: absolute; left: 0; top: 18mm; width: 62mm; height: 34mm; opacity: .55; }
            /* Frente */
            .rssc .logos { left: 3.5mm; top: 3mm; width: 55mm; height: 20mm; }
            .rssc .logo-rss { position: absolute; left: 0; top: 0; width: 22mm; height: 20mm; }
            .rssc .logo-rss img { width: 20mm; height: 20mm; border-radius: 3.5mm; }
            .rssc .vline { position: absolute; left: 25.5mm; top: 2.5mm; width: 0.35mm; height: 15mm; background: #8a7d70; }
            .rssc .logo-grp { position: absolute; left: 30mm; top: 0; width: 20mm; height: 20mm; text-align: center; }
            .rssc .logo-grp img { width: 20mm; height: 20mm; object-fit: contain; }
            .rssc .logos.solo .logo-rss { left: 16.5mm; }
            .rssc .photo { left: 3.5mm; top: 25.5mm; width: 21mm; height: 26mm; border-radius: 2.6mm; background: #f3ece2;
                border: 0.8mm solid #fff; box-shadow: 0 0.4mm 1.2mm rgba(0, 0, 0, .25); overflow: hidden; }
            .rssc .photo img { width: 100%; height: 100%; object-fit: cover; }
            .rssc .who { left: 26.5mm; top: 25.5mm; width: 33mm; }
            .rssc .who.nophoto { left: 4mm; width: 54mm; text-align: center; top: 25mm; }
            .rssc .name { font-size: 4.1mm; font-weight: 900; line-height: 1.08; color: #16212d; }
            .rssc .who.nophoto .name { font-size: 5.2mm; }
            .rssc .badge { display: inline-block; margin-top: 1.4mm; background: #6E0B14; color: #fff; font-weight: 700;
                font-size: 2.6mm; padding: 0.7mm 2.6mm; border-radius: 3mm; }
            .rssc .info { margin-top: 1.6mm; font-size: 2.65mm; line-height: 1.25; }
            .rssc .info td { vertical-align: top; padding: 0.35mm 0; }
            .rssc .info .i { width: 5mm; }
            .rssc .who.nophoto .info { margin-left: auto; margin-right: auto; }
            .rssc .info b { font-weight: 800; }
            .rssc .band { left: 0; top: 57mm; width: 62mm; height: 27mm; }
            .rssc .band-txt { left: 3.5mm; top: 67mm; width: 55mm; color: #fff; }
            .rssc .band-txt td { vertical-align: middle; color: #fff; }
            .rssc .band-txt .l { font-size: 2.6mm; line-height: 1.2; padding-left: 1mm; }
            .rssc .band-txt .l b { font-size: 2.9mm; font-weight: 800; }
            .rssc .band-txt .sep { width: 0.3mm; background: #E9A825; }
            .rssc .band-txt .r { font-size: 2.55mm; text-align: center; line-height: 1.25; padding-left: 1.5mm; }
            .rssc .stamp { right: 2.5mm; top: 2.5mm; z-index: 3; background: #b42318; color: #fff; font-size: 2.2mm; font-weight: 800;
                padding: 0.6mm 2mm; border-radius: 2mm; letter-spacing: .03em; }
            /* Reverso */
            .rssc .bhead { left: 0; top: 0; width: 62mm; height: 19mm; }
            .rssc .bhead-txt { left: 3mm; top: 2.2mm; width: 56mm; }
            .rssc .bhead-txt td { vertical-align: middle; color: #fff; }
            .rssc .bhead-txt img { width: 11.5mm; height: 11.5mm; border-radius: 2mm; }
            .rssc .bhead-txt .brand { font-size: 3.1mm; font-weight: 900; line-height: 1.02; padding-left: 1.3mm; }
            .rssc .bhead-txt .brand span { color: #F2B530; }
            .rssc .bhead-txt .sep { width: 0.3mm; background: rgba(255, 255, 255, .7); }
            .rssc .bhead-txt .ttl { font-size: 3.5mm; font-weight: 800; padding-left: 2mm; }
            .rssc .rows { left: 3.5mm; top: 19.5mm; width: 55mm; font-size: 2.45mm; line-height: 1.2; }
            .rssc .rows td { vertical-align: top; padding: 0.55mm 0; border-bottom: 0.2mm solid #e6d9c7; text-align: left; }
            .rssc .rows tr:last-child td { border-bottom: 0; }
            .rssc .rows .i { width: 5mm; padding-top: 0.6mm; }
            .rssc .rows b { font-weight: 800; }
            .rssc .em-h { left: 3mm; top: 50mm; width: 56mm; background: #6E0B14; color: #fff; font-weight: 800; font-size: 2.6mm;
                border-radius: 3mm; padding: 0.8mm 2.5mm; z-index: 2; }
            .rssc .em-b { left: 4mm; top: 53.3mm; width: 54mm; background: #EBDCC6; border-radius: 0 0 2.5mm 2.5mm; padding: 1.6mm 2.2mm 1.4mm; }
            .rssc .em-b td { vertical-align: middle; font-size: 2.35mm; line-height: 1.12; }
            .rssc .em-b .nm b { display: block; max-height: 5.4mm; overflow: hidden; }
            .rssc .em-b .ph { font-weight: 900; font-size: 2.8mm; text-align: right; white-space: nowrap; width: 21mm; }
            .rssc .bband { left: 0; top: 65mm; width: 62mm; height: 19mm; }
            .rssc .bband-txt { left: 3.5mm; top: 72mm; width: 36mm; color: #fff; }
            .rssc .bband-txt td { color: #fff; vertical-align: middle; font-size: 2.3mm; line-height: 1.2; }
            .rssc .bband-txt b { font-size: 2.7mm; font-weight: 800; }
            .rssc .qr { right: 3mm; top: 63mm; width: 18mm; height: 18mm; background: #fff; border-radius: 2.2mm; padding: 1mm;
                box-shadow: 0 0.4mm 1.2mm rgba(0, 0, 0, .3); border: 0.4mm solid #6E0B14; }
            .rssc .qr img { width: 100%; height: 100%; }
        </style>
    </template>

    <template id="rss_cred_icon" name="Credencial: icono">
        <svg t-if="icon == 'tent'" width="3.6mm" height="3.2mm" viewBox="0 0 46 38"><path fill="#1E2B3A" d="M23 2l3 4-3 4 20 26H33L23 20 13 36H3L23 10l-3-4z"/></svg>
        <svg t-elif="icon == 'people'" width="3.8mm" height="3mm" viewBox="0 0 46 36"><g t-att-fill="color or '#1E2B3A'"><circle cx="23" cy="9" r="7"/><circle cx="9" cy="12" r="5.5"/><circle cx="37" cy="12" r="5.5"/><path d="M11 34c0-8 5-13 12-13s12 5 12 13z"/><path d="M0 34c0-6 3.5-10 9-10 2 0 3.6.5 5 1.4C11.6 27.8 10 31 10 34z"/><path d="M46 34c0-6-3.5-10-9-10-2 0-3.6.5-5 1.4 2.4 2.4 4 5.6 4 8.6z"/></g></svg>
        <svg t-elif="icon == 'shield'" t-att-width="size or '3.4mm'" t-att-height="size or '3.4mm'" viewBox="0 0 38 42"><path fill="none" t-att-stroke="color or '#1E2B3A'" stroke-width="3.5" d="M19 2l16 6v11c0 10-7 17-16 21C10 36 3 29 3 19V8z"/><path t-att-fill="color or '#1E2B3A'" d="M16 28l-7-7 3-3 4 4 10-10 3 3z"/></svg>
        <svg t-elif="icon == 'doc'" width="3.2mm" height="3.6mm" viewBox="0 0 34 40"><rect x="2" y="2" width="30" height="36" rx="4" fill="none" stroke="#1E2B3A" stroke-width="3.5"/><path stroke="#1E2B3A" stroke-width="3" d="M9 13h16M9 20h16M9 27h10"/></svg>
        <svg t-elif="icon == 'cal'" width="3.4mm" height="3.4mm" viewBox="0 0 40 40"><rect x="2" y="5" width="36" height="33" rx="4" fill="none" stroke="#1E2B3A" stroke-width="3.5"/><path stroke="#1E2B3A" stroke-width="3.5" d="M2 14h36M11 1v8M29 1v8"/><g fill="#1E2B3A"><rect x="9" y="19" width="5" height="5"/><rect x="18" y="19" width="5" height="5"/><rect x="27" y="19" width="5" height="5"/><rect x="9" y="28" width="5" height="5"/><rect x="18" y="28" width="5" height="5"/></g></svg>
        <svg t-elif="icon == 'phone'" t-att-width="size or '3.4mm'" t-att-height="size or '3.4mm'" viewBox="0 0 40 40"><path t-att-fill="color or '#1E2B3A'" d="M9 2l7 9-4 5c2 5 7 10 12 12l5-4 9 7-4 7C20 38 2 20 1 6z"/></svg>
        <svg t-elif="icon == 'user'" width="3.6mm" height="3.8mm" viewBox="0 0 36 40"><circle cx="18" cy="10" r="9" fill="#1E2B3A"/><path fill="#1E2B3A" d="M0 40c0-11 8-18 18-18s18 7 18 18z"/></svg>
        <svg t-elif="icon == 'mobile'" width="4.6mm" height="7mm" viewBox="0 0 26 40"><rect x="2" y="2" width="22" height="36" rx="4" fill="none" stroke="#fff" stroke-width="3"/><circle cx="13" cy="32" r="2" fill="#fff"/></svg>
    </template>

    <!-- Fondo: montañas y pinos suaves -->
    <template id="rss_cred_mountains" name="Credencial: montañas">
        <svg class="mnt" viewBox="0 0 620 340" preserveAspectRatio="none">
            <path fill="#e9dfd2" d="M0 210 L120 120 L210 190 L330 80 L450 180 L540 120 L620 170 L620 340 L0 340z"/>
            <path fill="#ddd0bf" d="M0 260 L90 200 L200 250 L310 170 L430 240 L520 190 L620 230 L620 340 L0 340z"/>
            <g fill="#cfc1ae"><path d="M520 120l18 40h-10l16 36h-12l14 34h-52l14-34h-12l16-36h-10z"/><path d="M570 150l14 32h-8l12 28h-9l11 26h-40l11-26h-9l12-28h-8z"/></g>
        </svg>
    </template>

    <template id="rss_credential_front" name="Credencial: frente">
        <t t-set="color" t-value="False"/><t t-set="size" t-value="False"/>
        <div class="rssc">
            <t t-call="red_seguro_scout.rss_cred_mountains"/>
            <div t-attf-class="abs logos #{'' if c['group_logo'] else 'solo'}">
                <div class="logo-rss"><img t-att-src="c['logo']" alt="Red Seguro Scout"/></div>
                <t t-if="c['group_logo']"><div class="vline"/><div class="logo-grp"><img t-att-src="c['group_logo']" alt="Grupo"/></div></t>
            </div>
            <div t-if="c['photo']" class="abs photo"><img t-att-src="c['photo']" alt="Foto"/></div>
            <div t-attf-class="abs who #{'' if c['photo'] else 'nophoto'}">
                <div class="name"><t t-out="c['first']"/><br/><t t-out="c['last']"/></div>
                <div class="badge" t-out="c['badge']"/>
                <table class="info">
                    <tr t-if="c['section']"><td class="i"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'tent'"/></t></td><td><b t-out="c['section']"/></td></tr>
                    <tr><td class="i"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'people'"/><t t-set="color" t-value="False"/></t></td>
                        <td><b t-out="c['group']"/><br t-if="c['city']"/><t t-out="c['city']"/></td></tr>
                </table>
            </div>
            <div t-if="not c['active']" class="abs stamp" t-out="c['state_label'].upper()"/>
            <svg class="abs band" viewBox="0 0 620 270" preserveAspectRatio="none">
                <path fill="#F0A21E" d="M0 60 C150 0 330 70 620 10 L620 270 L0 270z"/>
                <path fill="#6E0B14" d="M0 82 C160 20 340 95 620 34 L620 270 L0 270z"/>
            </svg>
            <table class="abs band-txt"><tr>
                <td style="width: 6mm"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'shield'"/><t t-set="color" t-value="'#fff'"/><t t-set="size" t-value="'5.4mm'"/></t></td>
                <td class="l">Asegurado en la<br/><b>Red Seguro Scout</b></td>
                <td class="sep"/>
                <td class="r">Vigencia<br/><t t-out="c['start']"/> –<br/><t t-out="c['end']"/></td>
            </tr></table>
        </div>
    </template>

    <template id="rss_credential_back" name="Credencial: reverso">
        <t t-set="color" t-value="False"/><t t-set="size" t-value="False"/>
        <div class="rssc">
            <svg class="abs bhead" viewBox="0 0 620 190" preserveAspectRatio="none">
                <path fill="#6E0B14" d="M0 0 H620 V140 C430 190 230 120 0 175z"/>
                <path fill="#F0A21E" d="M0 175 C230 120 430 190 620 140 V152 C430 202 230 132 0 187z"/>
            </svg>
            <table class="abs bhead-txt"><tr>
                <td style="width: 12mm"><img t-att-src="c['emblem']" alt=""/></td>
                <td class="brand">Red<br/><span>Seguro</span><br/>Scout</td>
                <td class="sep"/>
                <td class="ttl">Datos del Seguro</td>
            </tr></table>
            <table class="abs rows">
                <tr><td class="i"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'shield'"/><t t-set="color" t-value="False"/><t t-set="size" t-value="False"/></t></td><td><b>Póliza:</b> <t t-out="c['product']"/></td></tr>
                <tr><td class="i"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'doc'"/></t></td><td><b>No. de Póliza:</b> <t t-out="c['policy_number']"/><t t-if="c['certificate']"> · <b>Cert.</b> <t t-out="c['certificate']"/></t></td></tr>
                <tr><td class="i"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'people'"/><t t-set="color" t-value="False"/></t></td><td><b>Aseguradora:</b> <t t-out="c['insurer']"/></td></tr>
                <tr><td class="i"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'cal'"/></t></td><td><b>Vigencia:</b> <t t-out="c['start']"/> – <t t-out="c['end']"/></td></tr>
                <tr><td class="i"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'shield'"/><t t-set="color" t-value="False"/><t t-set="size" t-value="False"/></t></td><td><b>Cobertura principal:</b><br/><t t-out="c['coverage']"/></td></tr>
            </table>
            <div class="abs em-h"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'phone'"/><t t-set="color" t-value="'#fff'"/><t t-set="size" t-value="'2.6mm'"/></t> En caso de emergencia, llamar a:</div>
            <table class="abs em-b"><tr>
                <td style="width: 4.5mm"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'user'"/></t></td>
                <td class="nm"><b t-out="c['em_name']"/><span style="color: #5b4b3f">(<t t-out="c['em_role']"/>)</span></td>
                <td class="ph" t-if="c['em_phone']"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'phone'"/><t t-set="color" t-value="False"/><t t-set="size" t-value="'2.8mm'"/></t> <t t-out="c['em_phone']"/></td>
            </tr></table>
            <svg class="abs bband" viewBox="0 0 620 190" preserveAspectRatio="none">
                <path fill="#F0A21E" d="M0 40 C200 0 420 60 620 10 L620 190 L0 190z"/>
                <path fill="#6E0B14" d="M0 58 C210 16 420 78 620 28 L620 190 L0 190z"/>
            </svg>
            <table class="abs bband-txt"><tr>
                <td style="width: 6mm"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'mobile'"/></t></td>
                <td>Consulta de datos<br/>y asistencia en:<br/><b>Red Seguro Scout</b></td>
            </tr></table>
            <div class="abs qr"><img t-att-src="c['qr']" alt="QR"/></div>
        </div>
    </template>

    <!-- Frente + reverso de una persona -->
    <template id="rss_credential_pair" name="Credencial: frente y reverso">
        <div class="rssc-pair">
            <t t-call="red_seguro_scout.rss_credential_front"/><t t-call="red_seguro_scout.rss_credential_back"/>
        </div>
    </template>

    <!-- PDF: tres personas por hoja carta, listas para recortar -->
    <record id="paperformat_rss_credential" model="report.paperformat">
        <field name="name">Credenciales Red Seguro Scout (carta)</field>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">6</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">96</field>
    </record>
    <record id="action_report_rss_credential" model="ir.actions.report">
        <field name="name">Credencial del seguro</field>
        <field name="model">rss.insured</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">red_seguro_scout.report_rss_credential</field>
        <field name="report_file">red_seguro_scout.report_rss_credential</field>
        <field name="print_report_name">'Credencial - %s' % object.name if len(objects) == 1 else 'Credenciales'</field>
        <field name="paperformat_id" ref="paperformat_rss_credential"/>
        <field name="binding_model_id" ref="model_rss_insured"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_rss_credential" name="Credenciales (PDF)">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-call="red_seguro_scout.rss_credential_styles"/>
                <t t-foreach="[docs[i:i + 3] for i in range(0, len(docs), 3)]" t-as="chunk">
                    <div class="page" t-attf-style="text-align: center; padding-top: 2mm; #{'' if chunk_last else 'page-break-after: always;'}">
                        <t t-foreach="chunk" t-as="o">
                            <t t-set="c" t-value="o._credential_values()"/>
                            <div style="text-align: center"><t t-call="red_seguro_scout.rss_credential_pair"/></div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
