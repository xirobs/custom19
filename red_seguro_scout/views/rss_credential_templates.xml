<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Credencial del seguro: 62 × 84 mm, frente y reverso. Medidas en mm para imprimir a tamaño real.
         Variable c = rss.insured._credential_values() -->
    <template id="rss_credential_styles" name="Credencial: estilos">
        <style t-out="fonts or ''"/>
        <style>
            .rssc-pair { display: inline-block; white-space: nowrap; margin: 0 0 4mm 0; page-break-inside: avoid; }
            .rssc { position: relative; display: inline-block; vertical-align: top; width: 62mm; height: 84mm; overflow: hidden;
                border-radius: 4.5mm; background: #FBF4EA; color: #1E2B3A; white-space: normal; margin-right: 4mm; text-align: left;
                font-family: "RSS Poppins", "Poppins", "Segoe UI", Helvetica, Arial, sans-serif; font-weight: 400;
                box-shadow: 0 0.6mm 2mm rgba(0, 0, 0, .25); border: 0.2mm solid #e7dccd; line-height: 1.2; letter-spacing: 0; }
            .rssc:last-child { margin-right: 0; }
            .rssc * { box-sizing: border-box; }
            /* El portal pone bordes y fondos a las tablas: aquí no se usan, pero se anulan por si acaso */
            .rssc table, .rssc tr, .rssc td, .rssc th { border: 0 !important; background: transparent !important; box-shadow: none !important; }
            .rssc .abs { position: absolute; }
            .rssc div, .rssc span, .rssc b { margin: 0; float: none; }
            .rssc b { display: inline; }
            .rssc img { max-width: none; }
            .rssc .mnt { position: absolute; left: 0; top: 18mm; width: 62mm; height: 36mm; opacity: .55; }
            .rssc svg { display: inline-block; vertical-align: middle; }
            /* ---------- Frente ---------- */
            .rssc .logos { left: 3.5mm; top: 3mm; width: 55mm; height: 20mm; }
            .rssc .logo-rss { position: absolute; left: 0; top: 0; width: 22mm; height: 20mm; }
            .rssc .logo-rss img { width: 20mm; height: 20mm; border-radius: 3.5mm; }
            .rssc .vline { position: absolute; left: 25.5mm; top: 2.5mm; width: 0.3mm; height: 15mm; background: rgba(110, 11, 20, .35); }
            .rssc .logo-grp { position: absolute; left: 30mm; top: 0; width: 20mm; height: 20mm; text-align: center; }
            .rssc .logo-grp img { width: 20mm; height: 20mm; object-fit: contain; }
            .rssc .logos.solo .logo-rss { left: 16.5mm; }
            .rssc .photo { left: 3.5mm; top: 26mm; width: 21mm; height: 26.5mm; border-radius: 2.6mm; background: #f3ece2;
                border: 0.8mm solid #fff; box-shadow: 0 0.4mm 1.2mm rgba(0, 0, 0, .22); overflow: hidden; }
            .rssc .photo img { width: 100%; height: 100%; object-fit: cover; }
            .rssc .who { left: 26.8mm; top: 26mm; width: 33mm; }
            .rssc .who.nophoto { left: 4mm; width: 54mm; top: 25mm; text-align: center; }
            .rssc .rname { font-family: "RSS Poppins", "Poppins", sans-serif; font-weight: 700; font-size: 4.3mm; line-height: 1.04;
                color: #1E2B3A; letter-spacing: -0.05mm; }
            .rssc .rname span { display: block; }
            .rssc .who.nophoto .rname { font-size: 5.4mm; }
            .rssc .rbadge { display: inline-block; margin-top: 1.5mm; background: #6E0B14; color: #fff; font-weight: 500;
                font-size: 2.55mm; padding: 0.5mm 3mm 0.6mm; border-radius: 3mm; }
            .rssc .facts { margin-top: 1.8mm; }
            .rssc .who.nophoto .facts { display: inline-block; text-align: left; }
            .rssc .fact { position: relative; padding-left: 5.4mm; margin-top: 1.2mm; min-height: 4mm; }
            .rssc .fact .ic { position: absolute; left: 0; top: 0.1mm; width: 4.4mm; text-align: center; }
            .rssc .fact .t1 { font-weight: 700; font-size: 2.8mm; line-height: 1.15; color: #1E2B3A; }
            .rssc .fact .t2 { font-size: 2.45mm; line-height: 1.15; color: #4a3f36; }
            .rssc .stamp { right: 2.5mm; top: 2.5mm; z-index: 3; background: #b42318; color: #fff; font-size: 2.1mm; font-weight: 700;
                padding: 0.5mm 2mm; border-radius: 2mm; letter-spacing: .03em; }
            .rssc .band { left: 0; top: 57mm; width: 62mm; height: 27mm; }
            .rssc .foot { left: 3.5mm; top: 66.5mm; width: 55mm; height: 13mm; color: #fff; }
            .rssc .foot .shield { position: absolute; left: 0; top: 2.4mm; }
            .rssc .foot .ins { position: absolute; left: 7mm; top: 2.6mm; width: 24mm; font-size: 2.45mm; line-height: 1.25; }
            .rssc .foot .ins b { font-weight: 700; font-size: 2.75mm; display: block; }
            .rssc .foot .sep { position: absolute; left: 32mm; top: 1mm; width: 0.3mm; height: 10.5mm; background: rgba(240, 162, 30, .85); }
            .rssc .foot .val { position: absolute; left: 33.5mm; top: 1.2mm; width: 21.5mm; text-align: center; font-size: 2.45mm; line-height: 1.3; }
            .rssc .foot .val b { font-weight: 500; display: block; font-size: 2.6mm; }
            /* ---------- Reverso ---------- */
            .rssc .bhead { left: 0; top: 0; width: 62mm; height: 19mm; }
            .rssc .bh { left: 3mm; top: 2.2mm; width: 56mm; height: 12mm; color: #fff; }
            .rssc .bh img { position: absolute; left: 0; top: 0; width: 11.5mm; height: 11.5mm; border-radius: 2mm; }
            .rssc .bh .brand { position: absolute; left: 13mm; top: 0.4mm; font-weight: 700; font-size: 3mm; line-height: 1.02; }
            .rssc .bh .brand span { color: #F2B530; display: block; }
            .rssc .bh .sep { position: absolute; left: 27mm; top: 0.8mm; width: 0.3mm; height: 10mm; background: rgba(255, 255, 255, .55); }
            .rssc .bh .ttl { position: absolute; left: 29.5mm; top: 0.9mm; width: 26mm; font-weight: 700; font-size: 3.7mm; line-height: 1.08; }
            .rssc .rows { left: 4mm; top: 19.5mm; width: 54mm; }
            .rssc .ln { position: relative; padding: 0.9mm 0 0.9mm 5.6mm; border-bottom: 0.25mm solid rgba(110, 11, 20, .13);
                font-size: 2.45mm; line-height: 1.25; }
            .rssc .ln:last-child { border-bottom: 0; }
            .rssc .ln .ic { position: absolute; left: 0; top: 0.9mm; width: 4.2mm; text-align: center; }
            .rssc .ln b { font-weight: 700; }
            .rssc .em-h { left: 3mm; top: 50.3mm; width: 56mm; background: #6E0B14; color: #fff; font-weight: 700; font-size: 2.55mm;
                border-radius: 3mm; padding: 0.7mm 2.5mm; z-index: 2; white-space: nowrap; }
            .rssc .em-b { left: 4.5mm; top: 53.5mm; width: 53mm; height: 9mm; background: #EBDCC6; border-radius: 0 0 2.5mm 2.5mm; }
            .rssc .em-b .ic { position: absolute; left: 2mm; top: 2.6mm; }
            .rssc .em-b .nm { position: absolute; left: 7mm; top: 1.6mm; width: 23.5mm; font-size: 2.35mm; line-height: 1.15; }
            .rssc .em-b .nm b { font-weight: 700; display: block; max-height: 5.5mm; overflow: hidden; }
            .rssc .em-b .nm span { color: #5b4b3f; font-size: 2.15mm; }
            .rssc .em-b .ph { position: absolute; right: 1.8mm; top: 3.1mm; font-weight: 700; font-size: 2.6mm; white-space: nowrap; }
            .rssc .bband { left: 0; top: 65mm; width: 62mm; height: 19mm; }
            .rssc .bfoot { left: 3.5mm; top: 72mm; width: 36mm; height: 10mm; color: #fff; }
            .rssc .bfoot .mob { position: absolute; left: 0; top: 1.4mm; }
            .rssc .bfoot .sep { position: absolute; left: 6.6mm; top: 0.6mm; width: 0.3mm; height: 8.6mm; background: rgba(240, 162, 30, .85); }
            .rssc .bfoot .tx { position: absolute; left: 8.4mm; top: 0.6mm; width: 27mm; font-size: 2.25mm; line-height: 1.25; }
            .rssc .bfoot .tx b { font-weight: 700; font-size: 2.65mm; display: block; }
            .rssc .qr { right: 3mm; top: 63mm; width: 18mm; height: 18mm; background: #fff; border-radius: 2.2mm; padding: 1mm;
                box-shadow: 0 0.4mm 1.2mm rgba(0, 0, 0, .3); border: 0.4mm solid #6E0B14; }
            .rssc .qr img { width: 100%; height: 100%; }
        </style>
    </template>

    <template id="rss_cred_icon" name="Credencial: icono">
        <svg t-if="icon == 'tent'" width="4mm" height="3.5mm" viewBox="0 0 46 38"><path fill="#1E2B3A" d="M23 2l3 4-3 4 20 26H33L23 20 13 36H3L23 10l-3-4z"/></svg>
        <svg t-elif="icon == 'people'" width="4.2mm" height="3.3mm" viewBox="0 0 46 36"><g t-att-fill="color or '#1E2B3A'"><circle cx="23" cy="9" r="7"/><circle cx="9" cy="12" r="5.5"/><circle cx="37" cy="12" r="5.5"/><path d="M11 34c0-8 5-13 12-13s12 5 12 13z"/><path d="M0 34c0-6 3.5-10 9-10 2 0 3.6.5 5 1.4C11.6 27.8 10 31 10 34z"/><path d="M46 34c0-6-3.5-10-9-10-2 0-3.6.5-5 1.4 2.4 2.4 4 5.6 4 8.6z"/></g></svg>
        <svg t-elif="icon == 'shield'" t-att-width="size or '3.4mm'" t-att-height="size or '3.4mm'" viewBox="0 0 38 42"><path fill="none" t-att-stroke="color or '#1E2B3A'" stroke-width="3.5" d="M19 2l16 6v11c0 10-7 17-16 21C10 36 3 29 3 19V8z"/><path t-att-fill="color or '#1E2B3A'" d="M16 28l-7-7 3-3 4 4 10-10 3 3z"/></svg>
        <svg t-elif="icon == 'doc'" width="3.2mm" height="3.6mm" viewBox="0 0 34 40"><rect x="2" y="2" width="30" height="36" rx="4" fill="none" stroke="#1E2B3A" stroke-width="3.5"/><path stroke="#1E2B3A" stroke-width="3" d="M9 13h16M9 20h16M9 27h10"/></svg>
        <svg t-elif="icon == 'cal'" width="3.4mm" height="3.4mm" viewBox="0 0 40 40"><rect x="2" y="5" width="36" height="33" rx="4" fill="none" stroke="#1E2B3A" stroke-width="3.5"/><path stroke="#1E2B3A" stroke-width="3.5" d="M2 14h36M11 1v8M29 1v8"/><g fill="#1E2B3A"><rect x="9" y="19" width="5" height="5"/><rect x="18" y="19" width="5" height="5"/><rect x="27" y="19" width="5" height="5"/><rect x="9" y="28" width="5" height="5"/><rect x="18" y="28" width="5" height="5"/></g></svg>
        <svg t-elif="icon == 'phone'" t-att-width="size or '3.4mm'" t-att-height="size or '3.4mm'" viewBox="0 0 40 40"><path t-att-fill="color or '#1E2B3A'" d="M9 2l7 9-4 5c2 5 7 10 12 12l5-4 9 7-4 7C20 38 2 20 1 6z"/></svg>
        <svg t-elif="icon == 'user'" width="3.6mm" height="3.8mm" viewBox="0 0 36 40"><circle cx="18" cy="10" r="9" fill="#1E2B3A"/><path fill="#1E2B3A" d="M0 40c0-11 8-18 18-18s18 7 18 18z"/></svg>
        <svg t-elif="icon == 'mobile'" width="4.6mm" height="7mm" viewBox="0 0 26 40"><rect x="2" y="2" width="22" height="36" rx="4" fill="none" stroke="#fff" stroke-width="3"/><circle cx="13" cy="32" r="2" fill="#fff"/></svg>
    </template>

    <!-- Fondo: montañas y pinos suaves -->
    <template id="rss_cred_mountains" name="Credencial: montañas">
        <svg class="mnt" viewBox="0 0 620 340" preserveAspectRatio="none">
            <path fill="#e9dfd2" d="M0 210 L120 120 L210 190 L330 80 L450 180 L540 120 L620 170 L620 340 L0 340z"/>
            <path fill="#ddd0bf" d="M0 260 L90 200 L200 250 L310 170 L430 240 L520 190 L620 230 L620 340 L0 340z"/>
            <g fill="#cfc1ae"><path d="M520 120l18 40h-10l16 36h-12l14 34h-52l14-34h-12l16-36h-10z"/><path d="M570 150l14 32h-8l12 28h-9l11 26h-40l11-26h-9l12-28h-8z"/></g>
        </svg>
    </template>

    <template id="rss_credential_front" name="Credencial: frente">
        <t t-set="color" t-value="False"/><t t-set="size" t-value="False"/>
        <div class="rssc">
            <t t-call="red_seguro_scout.rss_cred_mountains"/>
            <div t-attf-class="abs logos #{'' if c['group_logo'] else 'solo'}">
                <div class="logo-rss"><img t-att-src="c['logo']" alt="Red Seguro Scout"/></div>
                <t t-if="c['group_logo']"><div class="vline"/><div class="logo-grp"><img t-att-src="c['group_logo']" alt="Grupo"/></div></t>
            </div>
            <div t-if="c['photo']" class="abs photo"><img t-att-src="c['photo']" alt="Foto"/></div>
            <div t-attf-class="abs who #{'' if c['photo'] else 'nophoto'}">
                <div class="rname"><span t-out="c['first']"/><span t-out="c['last']"/></div>
                <div class="rbadge" t-out="c['badge']"/>
                <div class="facts">
                    <div class="fact" t-if="c['section']">
                        <span class="ic"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'tent'"/></t></span>
                        <div class="t1" t-out="c['section']"/>
                    </div>
                    <div class="fact">
                        <span class="ic"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'people'"/></t></span>
                        <div class="t1" t-out="c['group']"/>
                        <div class="t2" t-if="c['city']" t-out="c['city']"/>
                    </div>
                </div>
            </div>
            <div t-if="not c['active']" class="abs stamp" t-out="c['state_label'].upper()"/>
            <svg class="abs band" viewBox="0 0 620 270" preserveAspectRatio="none">
                <path fill="#F0A21E" d="M0 60 C150 0 330 70 620 10 L620 270 L0 270z"/>
                <path fill="#6E0B14" d="M0 82 C160 20 340 95 620 34 L620 270 L0 270z"/>
            </svg>
            <div class="abs foot">
                <span class="shield"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'shield'"/><t t-set="color" t-value="'#fff'"/><t t-set="size" t-value="'5.6mm'"/></t></span>
                <div class="ins">Asegurado en la<b>Red Seguro Scout</b></div>
                <div class="sep"/>
                <div class="val">Vigencia<b><t t-out="c['start']"/> –</b><b t-out="c['end']"/></div>
            </div>
        </div>
    </template>

    <template id="rss_credential_back" name="Credencial: reverso">
        <t t-set="color" t-value="False"/><t t-set="size" t-value="False"/>
        <div class="rssc">
            <svg class="abs bhead" viewBox="0 0 620 190" preserveAspectRatio="none">
                <path fill="#6E0B14" d="M0 0 H620 V140 C430 190 230 120 0 175z"/>
                <path fill="#F0A21E" d="M0 175 C230 120 430 190 620 140 V152 C430 202 230 132 0 187z"/>
            </svg>
            <div class="abs bh">
                <img t-att-src="c['emblem']" alt=""/>
                <div class="brand">Red<span>Seguro</span>Scout</div>
                <div class="sep"/>
                <div class="ttl">Datos del<br/>Seguro</div>
            </div>
            <div class="abs rows">
                <div class="ln"><span class="ic"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'shield'"/></t></span><b>Póliza:</b> <t t-out="c['product']"/></div>
                <div class="ln"><span class="ic"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'doc'"/></t></span><b>No. de Póliza:</b> <t t-out="c['policy_number']"/><t t-if="c['certificate']"> · <b>Cert.</b> <t t-out="c['certificate']"/></t></div>
                <div class="ln"><span class="ic"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'people'"/></t></span><b>Aseguradora:</b> <t t-out="c['insurer']"/></div>
                <div class="ln"><span class="ic"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'cal'"/></t></span><b>Vigencia:</b> <t t-out="c['start']"/> – <t t-out="c['end']"/></div>
                <div class="ln"><span class="ic"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'shield'"/></t></span><b>Uso de la póliza:</b><br/>Debe ser con autorización del Jefe de Grupo.</div>
            </div>
            <div class="abs em-h"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'phone'"/><t t-set="color" t-value="'#fff'"/><t t-set="size" t-value="'2.6mm'"/></t> En caso de emergencia, llamar a:</div>
            <div class="abs em-b">
                <span class="ic"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'user'"/></t></span>
                <div class="nm"><b t-out="c['em_name']"/><span>(<t t-out="c['em_role']"/>)</span></div>
                <div class="ph" t-if="c['em_phone']"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'phone'"/><t t-set="size" t-value="'2.8mm'"/></t> <t t-out="c['em_phone']"/></div>
            </div>
            <svg class="abs bband" viewBox="0 0 620 190" preserveAspectRatio="none">
                <path fill="#F0A21E" d="M0 40 C200 0 420 60 620 10 L620 190 L0 190z"/>
                <path fill="#6E0B14" d="M0 58 C210 16 420 78 620 28 L620 190 L0 190z"/>
            </svg>
            <div class="abs bfoot">
                <span class="mob"><t t-call="red_seguro_scout.rss_cred_icon"><t t-set="icon" t-value="'mobile'"/></t></span>
                <div class="sep"/>
                <div class="tx">Consulta de datos<br/>y asistencia en:<b>Red Seguro Scout</b></div>
            </div>
            <div class="abs qr"><img t-att-src="c['qr']" alt="QR"/></div>
        </div>
    </template>

    <!-- Frente + reverso de una persona -->
    <template id="rss_credential_pair" name="Credencial: frente y reverso">
        <div class="rssc-pair">
            <t t-call="red_seguro_scout.rss_credential_front"/><t t-call="red_seguro_scout.rss_credential_back"/>
        </div>
    </template>

    <!-- PDF: tres personas por hoja carta, listas para recortar -->
    <record id="paperformat_rss_credential" model="report.paperformat">
        <field name="name">Credenciales Red Seguro Scout (carta)</field>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">6</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">96</field>
    </record>
    <record id="action_report_rss_credential" model="ir.actions.report">
        <field name="name">Credencial del seguro</field>
        <field name="model">rss.insured</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">red_seguro_scout.report_rss_credential</field>
        <field name="report_file">red_seguro_scout.report_rss_credential</field>
        <field name="print_report_name">'Credencial - %s' % (object.name or '')</field>
        <field name="paperformat_id" ref="paperformat_rss_credential"/>
        <field name="binding_model_id" ref="model_rss_insured"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_rss_credential" name="Credenciales (PDF)">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-set="fonts" t-value="docs._credential_fonts()"/>
                <t t-call="red_seguro_scout.rss_credential_styles"/>
                <t t-foreach="[docs[i:i + 3] for i in range(0, len(docs), 3)]" t-as="chunk">
                    <div class="page" t-attf-style="text-align: center; padding-top: 2mm; #{'' if chunk_last else 'page-break-after: always;'}">
                        <t t-foreach="chunk" t-as="o">
                            <t t-set="c" t-value="o._credential_values()"/>
                            <div style="text-align: center"><t t-call="red_seguro_scout.rss_credential_pair"/></div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
