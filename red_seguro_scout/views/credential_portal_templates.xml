<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Foto del asegurado: cámara del celular o archivo/galería. Variables: current (data URI o False),
         autosubmit (True = se guarda al elegirla) -->
    <template id="rss_photo_picker" name="Foto del asegurado: elegir o tomar">
        <div class="o_rss_photo_picker" t-att-data-autosubmit="'1' if autosubmit else '0'">
            <img class="o_rss_photo_preview" alt="Foto" t-att-src="current or ''"
                 t-att-style="'' if current else 'display: none'"/>
            <div class="o_rss_photo_buttons">
                <label class="btn o_rssp_btn o_rss_photo_btn"><i class="fa fa-camera"/> Tomar foto
                    <input type="file" name="photo" accept="image/*" capture="environment" class="o_rss_photo_input"/>
                </label>
                <label class="btn o_rssp_btn_ghost o_rss_photo_btn"><i class="fa fa-picture-o"/> Elegir de galería o archivo
                    <input type="file" name="photo" accept="image/*" class="o_rss_photo_input"/>
                </label>
            </div>
            <input type="hidden" name="photo_data" class="o_rss_photo_data"/>
            <small class="o_rssp_muted o_rss_photo_status">De frente y con fondo claro. JPG, PNG o foto del celular.</small>
        </div>
    </template>
    <!-- Credencial en los portales: vista previa, foto y PDF -->
    <template id="rss_credential_page" name="Credencial: página del portal">
        <t t-set="fonts" t-value="c['fonts']"/>
        <t t-call="red_seguro_scout.rss_credential_styles"/>
        <a t-att-href="back" class="o_rssp_back"><i class="fa fa-arrow-left"/> Asegurados</a>
        <section class="o_rssp_card">
            <div class="o_rssp_row">
                <div>
                    <h4 class="o_rssp_h mb-0"><i class="fa fa-id-card-o"/> Credencial del seguro</h4>
                    <div class="o_rssp_muted"><t t-out="insured.name"/> · <t t-out="c['state_label']"/></div>
                </div>
                <a class="btn o_rssp_btn" t-attf-href="#{base}.pdf" target="_blank"><i class="fa fa-file-pdf-o"/> Descargar PDF</a>
            </div>
            <div class="o_rss_cred_preview"><t t-call="red_seguro_scout.rss_credential_pair"/></div>
            <p class="o_rssp_muted mb-0">Tamaño real: 6.2 × 8.4 cm. El PDF trae frente y reverso juntos para imprimir, recortar y doblar o enmicar.</p>
        </section>
        <section class="o_rssp_card">
            <h5>Foto <small class="o_rssp_muted">(opcional)</small></h5>
            <p class="o_rssp_muted">Con foto, la credencial la muestra a un lado del nombre; sin foto, el nombre y los datos se centran.
                Usa una foto de frente, con fondo claro.</p>
            <form method="post" enctype="multipart/form-data" t-att-action="base" class="o_rssp_form">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <t t-call="red_seguro_scout.rss_photo_picker">
                    <t t-set="current" t-value="c['photo']"/>
                    <t t-set="autosubmit" t-value="False"/>
                </t>
                <div class="o_rssp_actions">
                    <button type="submit" class="btn o_rssp_btn"><i class="fa fa-check"/> Guardar foto</button>
                    <button t-if="insured.photo" type="submit" name="remove" value="1" class="btn o_rssp_btn_ghost">Quitar foto</button>
                </div>
            </form>
        </section>
    </template>

    <template id="group_credential" name="Grupo: credencial">
        <t t-call="red_seguro_scout.group_layout"><t t-call="red_seguro_scout.rss_credential_page"/></t>
    </template>
    <template id="advisor_credential" name="Asesor: credencial">
        <t t-call="red_seguro_scout.advisor_layout"><t t-call="red_seguro_scout.rss_credential_page"/></t>
    </template>

    <!-- Página pública del QR -->
    <template id="credential_public" name="Credencial: consulta pública">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/>
            <t t-set="fonts" t-value="c.get('fonts') if c else False"/>
            <t t-call="red_seguro_scout.rss_credential_styles"/>
            <div class="container py-4" style="max-width: 760px">
                <div class="text-center mb-3">
                    <img src="/red_seguro_scout/static/description/red_seguro_scout_logo.png" style="width: 88px; border-radius: 18px" alt="Red Seguro Scout"/>
                    <h3 class="mt-2 mb-0" style="color: #6E0B14; font-weight: 800">Consulta de credencial</h3>
                </div>
                <t t-if="insured">
                    <div t-attf-class="alert #{'alert-success' if c['active'] else 'alert-warning'} text-center" role="status">
                        <b t-out="'Credencial vigente' if c['active'] else 'Sin cobertura vigente'"/> ·
                        <t t-out="c['state_label']"/> · vigencia <t t-out="c['start']"/> – <t t-out="c['end']"/>
                    </div>
                    <div class="text-center" style="overflow-x: auto"><t t-call="red_seguro_scout.rss_credential_pair"/></div>
                    <p class="text-center text-muted small mt-2">Ante un accidente, llama primero al contacto de emergencia y después a la aseguradora con el número de póliza.</p>
                </t>
                <div t-else="" class="alert alert-danger text-center">Esta credencial no existe o ya no es válida.</div>
            </div>
        </t>
    </template>
</odoo>
