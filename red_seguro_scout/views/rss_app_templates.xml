<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- App instalable propia: solo en las páginas de Red Seguro Scout (page_name rss_*) -->
    <template id="rss_app_head" inherit_id="web.frontend_layout" name="Red Seguro Scout: app instalable" priority="5">
        <xpath expr="//head/meta[@name='viewport']" position="after">
            <t t-if="(page_name or '').startswith('rss_')">
                <link rel="manifest" href="/seguro-app/manifest.webmanifest"/>
                <meta name="theme-color" content="#6E0B14"/>
                <meta name="mobile-web-app-capable" content="yes"/>
                <meta name="apple-mobile-web-app-capable" content="yes"/>
                <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
                <meta name="apple-mobile-web-app-title" content="Seguro Scout"/>
                <link rel="apple-touch-icon" href="/red_seguro_scout/static/src/img/app/apple_180.png"/>
            </t>
        </xpath>
    </template>

    <template id="rss_app_install_bar" name="Red Seguro Scout: instalar la app">
        <div class="o_rssi d-none" role="region" aria-label="Instalar la app Red Seguro Scout">
            <div class="o_rssi_row">
                <img src="/red_seguro_scout/static/src/img/app/icon_192.png" alt=""/>
                <div class="o_rssi_text">
                    <b>Instala la app Red Seguro Scout</b>
                    <span class="o_rssi_android">Entra con un toque desde tu celular.</span>
                    <span class="o_rssi_manual">Tenla en tu pantalla de inicio, como cualquier app.</span>
                    <button type="button" class="o_rssi_how" aria-expanded="false">Ver cómo instalarla</button>
                </div>
                <button type="button" class="o_rssi_btn">Instalar</button>
                <button type="button" class="o_rssi_close" aria-label="Cerrar">×</button>
            </div>
            <div class="o_rssi_steps d-none">
                <div data-rssi-mode="inapp">
                    <p class="o_rssi_alert">Estás dentro de otra app (WhatsApp, Instagram o Facebook). Desde ahí no se puede instalar.</p>
                    <ol>
                        <li><span class="o_rssi_ios_only">Toca <b>Abrir en Safari</b> o los tres puntos <b>⋯</b> → <b>Abrir en el navegador</b>.</span>
                            <span class="o_rssi_android_only">Toca los tres puntos <b>⋮</b> y elige <b>Abrir en Chrome</b>.</span></li>
                        <li>O copia la liga y pégala en tu navegador:</li>
                    </ol>
                    <div class="o_rssi_copy">
                        <input type="text" readonly="readonly" class="o_rssi_url" aria-label="Liga de la app"/>
                        <button type="button" class="o_rssi_copy_btn">Copiar liga</button>
                    </div>
                </div>
                <div data-rssi-mode="ios">
                    <ol>
                        <li>Toca <b>Compartir</b> <i class="fa fa-share-square-o"/> en la barra de Safari (o <b>⋯</b> → <b>Compartir</b>).</li>
                        <li>Desliza y toca <b>Agregar a inicio</b> <i class="fa fa-plus-square-o"/>.</li>
                        <li>Toca <b>Agregar</b> y abre <b>Seguro Scout</b> desde tu pantalla.</li>
                    </ol>
                    <p class="o_rssi_note">En navegación privada no se guarda tu sesión: usa una pestaña normal.</p>
                </div>
                <div data-rssi-mode="ios-other">
                    <ol>
                        <li>Toca <b>Compartir</b> <i class="fa fa-share-square-o"/> junto a la barra de dirección.</li>
                        <li>Elige <b>Agregar a pantalla de inicio</b>. Si no aparece, abre esta página en <b>Safari</b>.</li>
                    </ol>
                </div>
                <div data-rssi-mode="android-manual">
                    <ol>
                        <li>Toca los tres puntos <b>⋮</b> del navegador.</li>
                        <li>Elige <b>Instalar app</b> o <b>Agregar a la pantalla principal</b>. Si no aparece, usa <b>Chrome</b>.</li>
                    </ol>
                </div>
            </div>
        </div>
    </template>

    <template id="group_layout_install" inherit_id="red_seguro_scout.group_layout" name="Grupo: instalar app">
        <xpath expr="//main[hasclass('o_rssp_main')]" position="before">
            <t t-call="red_seguro_scout.rss_app_install_bar"/>
        </xpath>
    </template>

    <template id="advisor_layout_install" inherit_id="red_seguro_scout.advisor_layout" name="Asesor: instalar app">
        <xpath expr="//main[hasclass('o_rssp_main')]" position="before">
            <t t-call="red_seguro_scout.rss_app_install_bar"/>
        </xpath>
    </template>
</odoo>
