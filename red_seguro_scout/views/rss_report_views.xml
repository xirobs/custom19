<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ Relación mensual ============ -->
    <record id="rss_report_view_search" model="ir.ui.view">
        <field name="name">rss.report.search</field>
        <field name="model">rss.report</field>
        <field name="arch" type="xml">
            <search string="Relaciones">
                <field name="name"/>
                <field name="policy_id"/>
                <filter name="pending" string="Por enviar" domain="[('state', 'in', ('draft', 'generated'))]"/>
                <filter name="sent" string="Enviadas" domain="[('state', 'in', ('sent', 'acknowledged'))]"/>
                <separator/>
                <filter name="filter_period" string="Periodo" date="period_date"/>
                <group>
                    <filter name="by_year" string="Año" context="{'group_by': 'period_date:year'}"/>
                    <filter name="by_state" string="Estatus" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="rss_report_view_list" model="ir.ui.view">
        <field name="name">rss.report.list</field>
        <field name="model">rss.report</field>
        <field name="arch" type="xml">
            <list string="Relaciones mensuales" class="o_rss"
                  decoration-danger="is_late" decoration-muted="state == 'acknowledged'">
                <field name="is_late" column_invisible="1"/>
                <field name="name"/>
                <field name="period_date" widget="date" options="{'format': 'MMMM yyyy'}"/>
                <field name="deadline"/>
                <field name="group_count"/>
                <field name="insured_count" sum="Total"/>
                <field name="new_count" optional="show"/>
                <field name="drop_count" optional="show"/>
                <field name="total_days" optional="hide"/>
                <field name="date_sent" optional="show"/>
                <field name="insurer_ack" optional="show"/>
                <field name="auto_generated" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'acknowledged'"
                       decoration-info="state == 'sent'"
                       decoration-warning="state == 'generated'"/>
            </list>
        </field>
    </record>

    <record id="rss_report_view_form" model="ir.ui.view">
        <field name="name">rss.report.form</field>
        <field name="model">rss.report</field>
        <field name="arch" type="xml">
            <form string="Relación mensual" class="o_rss">
                <header>
                    <button name="action_generate" type="object" string="Generar lista"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_generate" type="object" string="Actualizar lista"
                            invisible="state != 'generated'"
                            confirm="Se volverá a tomar la foto de los asegurados del mes. ¿Continuar?"/>
                    <button name="action_send" type="object" string="Enviar a aseguradora"
                            class="btn-primary" icon="fa-envelope" invisible="state != 'generated'"/>
                    <button name="action_export_xlsx" type="object" string="Excel" icon="fa-file-excel-o"
                            invisible="state == 'draft'"/>
                    <button name="action_print_pdf" type="object" string="PDF" icon="fa-file-pdf-o"
                            invisible="state == 'draft'"/>
                    <button name="action_mark_sent" type="object" string="Marcar como enviada"
                            invisible="state != 'generated'"/>
                    <button name="action_mark_ack" type="object" string="Registrar acuse"
                            invisible="state != 'sent'"/>
                    <button name="action_reset_draft" type="object" string="Regresar a borrador"
                            invisible="state not in ('generated', 'sent')"
                            groups="red_seguro_scout.group_rss_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated,sent,acknowledged"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Vencida" bg_color="text-bg-danger" invisible="not is_late"/>
                    <field name="is_late" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" placeholder="Relación del mes"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="policy_id" readonly="state != 'draft'"/>
                            <field name="period_date" readonly="state != 'draft'"
                                   widget="date" options="{'format': 'MMMM yyyy'}"/>
                            <label for="date_from" string="Del"/>
                            <div class="o_row">
                                <field name="date_from"/> <span>al</span> <field name="date_to"/>
                            </div>
                            <field name="deadline"/>
                        </group>
                        <group>
                            <field name="group_ids" widget="many2many_tags" readonly="state != 'draft'"
                                   placeholder="Todos los grupos de la póliza"/>
                            <field name="only_paid_groups" readonly="state != 'draft'"/>
                            <field name="date_generated"/>
                            <field name="date_sent" invisible="not date_sent"/>
                            <field name="insurer_ack" invisible="state not in ('sent', 'acknowledged')"
                                   readonly="state == 'acknowledged'"/>
                            <field name="auto_generated" invisible="not auto_generated"/>
                            <field name="xlsx_file" filename="xlsx_filename" invisible="not xlsx_file"/>
                            <field name="xlsx_filename" invisible="1"/>
                        </group>
                    </group>
                    <div class="o_rss_stats">
                        <div class="o_rss_stat_main"><span class="o_rss_stat_v"><field name="insured_count" nolabel="1"/></span><span>Asegurados</span></div>
                        <div><span class="o_rss_stat_v"><field name="group_count" nolabel="1"/></span><span>Grupos</span></div>
                        <div><span class="o_rss_stat_v"><field name="new_count" nolabel="1"/></span><span>Altas del mes</span></div>
                        <div><span class="o_rss_stat_v"><field name="drop_count" nolabel="1"/></span><span>Bajas del mes</span></div>
                        <div><span class="o_rss_stat_v"><field name="total_days" nolabel="1"/></span><span>Días-asegurado</span></div>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not unpaid_group_names">
                        <strong>Grupos sin pago del año:</strong> <field name="unpaid_group_names" nolabel="1" class="oe_inline"/>
                    </div>
                    <notebook>
                        <page string="Asegurados del mes" name="lines">
                            <field name="line_ids" readonly="1">
                                <list decoration-success="is_new" decoration-muted="is_drop">
                                    <field name="group_id"/>
                                    <field name="last_name_father"/>
                                    <field name="last_name_mother"/>
                                    <field name="first_name"/>
                                    <field name="second_name" optional="hide"/>
                                    <field name="birthdate"/>
                                    <field name="age"/>
                                    <field name="sex"/>
                                    <field name="section" optional="show"/>
                                    <field name="tutor_name" optional="show"/>
                                    <field name="tutor_phone" optional="show"/>
                                    <field name="date_start"/>
                                    <field name="date_end" optional="hide"/>
                                    <field name="days_covered" sum="Total"/>
                                    <field name="is_new" optional="show"/>
                                    <field name="is_drop" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="rss_report_action" model="ir.actions.act_window">
        <field name="name">Relaciones mensuales</field>
        <field name="res_model">rss.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="rss_report_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">La relación del mes se genera sola del día 1 al 10</p>
            <p>También puedes crearla a mano: elige la póliza y el mes, y presiona «Generar lista».
               Después descárgala en Excel o PDF, o envíala directo a la aseguradora.</p>
        </field>
    </record>

    <!-- ============ Análisis por periodo (líneas de relación) ============ -->
    <record id="rss_report_line_view_search" model="ir.ui.view">
        <field name="name">rss.report.line.search</field>
        <field name="model">rss.report.line</field>
        <field name="arch" type="xml">
            <search string="Asegurados por periodo">
                <field name="name" string="Asegurado"/>
                <field name="group_id"/>
                <field name="cluster_id"/>
                <field name="policy_id"/>
                <filter name="new" string="Altas del mes" domain="[('is_new', '=', True)]"/>
                <filter name="drop" string="Bajas del mes" domain="[('is_drop', '=', True)]"/>
                <separator/>
                <filter name="filter_period" string="Mes" date="period_date"/>
                <group>
                    <filter name="by_group" string="Grupo" context="{'group_by': 'group_id'}"/>
                    <filter name="by_cluster" string="Agrupación" context="{'group_by': 'cluster_id'}"/>
                    <filter name="by_sex" string="Sexo" context="{'group_by': 'sex'}"/>
                    <filter name="by_section" string="Rama" context="{'group_by': 'section'}"/>
                    <separator/>
                    <filter name="by_month" string="Mes" context="{'group_by': 'period_date:month'}"/>
                    <filter name="by_quarter" string="Trimestre" context="{'group_by': 'period_date:quarter'}"/>
                    <filter name="by_year" string="Año" context="{'group_by': 'period_date:year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="rss_report_line_view_pivot" model="ir.ui.view">
        <field name="name">rss.report.line.pivot</field>
        <field name="model">rss.report.line</field>
        <field name="arch" type="xml">
            <pivot string="Asegurados por periodo" sample="1">
                <field name="group_id" type="row"/>
                <field name="period_date" interval="month" type="col"/>
                <field name="days_covered" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="rss_report_line_view_graph" model="ir.ui.view">
        <field name="name">rss.report.line.graph</field>
        <field name="model">rss.report.line</field>
        <field name="arch" type="xml">
            <graph string="Asegurados por periodo" type="line" sample="1">
                <field name="period_date" interval="month" type="row"/>
                <field name="group_id" type="col"/>
            </graph>
        </field>
    </record>

    <record id="rss_report_line_view_list" model="ir.ui.view">
        <field name="name">rss.report.line.list</field>
        <field name="model">rss.report.line</field>
        <field name="arch" type="xml">
            <list string="Asegurados por periodo" class="o_rss" create="0" edit="0" delete="0">
                <field name="period_date" widget="date" options="{'format': 'MMMM yyyy'}"/>
                <field name="group_id"/>
                <field name="name"/>
                <field name="age"/>
                <field name="sex"/>
                <field name="section" optional="show"/>
                <field name="days_covered" sum="Total"/>
                <field name="is_new" optional="show"/>
                <field name="is_drop" optional="show"/>
            </list>
        </field>
    </record>

    <record id="rss_report_line_action" model="ir.actions.act_window">
        <field name="name">Asegurados por periodo</field>
        <field name="res_model">rss.report.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="rss_report_line_view_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('rss_report_line_view_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('rss_report_line_view_graph')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('rss_report_line_view_list')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aquí verás los asegurados de cada mes</p>
            <p>Cada relación mensual generada alimenta este análisis: cantidad de asegurados y
               días cubiertos por mes, trimestre y año.</p>
        </field>
    </record>
</odoo>
