<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_recibo_servicio" model="ir.actions.report">
        <field name="name">Recibo de servicio</field>
        <field name="model">rss.service.charge</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">red_seguro_scout.report_recibo_servicio</field>
        <field name="report_file">red_seguro_scout.report_recibo_servicio</field>
        <field name="print_report_name">'Recibo_%s' % (object.name or '').replace('/', '_')</field>
        <field name="paperformat_id" ref="paperformat_rss_portrait"/>
        <field name="binding_model_id" ref="model_rss_service_charge"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_recibo_servicio_document">
        <t t-set="brand" t-value="doc._rss_brand()"/>
        <t t-set="method_labels" t-value="dict(doc._fields['payment_method'].selection)"/>
        <div class="page rs-doc">
            <t t-out="doc._rss_report_css(brand)"/>
            <t t-call="red_seguro_scout.rss_brand_header">
                <t t-set="doc_title" t-value="'RECIBO DE PAGO'"/>
                <t t-set="company_name" t-value="doc.company_id.name"/>
                <div class="rs-sub" style="font-size: 14px; font-weight: bold;" t-out="doc.name"/>
                <div class="rs-sub">Fecha: <t t-out="(doc.paid_date or doc.date).strftime('%d/%m/%Y')"/></div>
            </t>
            <table class="rs-receipt-box">
                <tr><td class="k">Recibimos del grupo</td><td><strong t-out="doc.group_id.name"/></td></tr>
                <tr><td class="k">La cantidad de</td>
                    <td><span class="rs-amount" t-out="doc.amount" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id or doc.env.company.currency_id}"/>
                        <div style="font-size: 10.5px; color: #4A5568;" t-out="doc._amount_in_words()"/></td></tr>
                <tr><td class="k">Por concepto de</td><td t-out="doc.concept"/></tr>
                <tr><td class="k">Forma de pago</td>
                    <td><t t-out="method_labels.get(doc.payment_method, '')"/>
                        <t t-if="doc.payment_reference"> · Ref. <t t-out="doc.payment_reference"/></t></td></tr>
                <tr><td class="k">Referencia</td><td t-out="doc.reference"/></tr>
                <tr t-if="doc.state != 'paid'"><td class="k">Estatus</td>
                    <td><span class="rs-stamp" t-out="dict(doc._fields['state'].selection).get(doc.state, '').upper()"/></td></tr>
            </table>
            <t t-call="red_seguro_scout.rss_brand_footer">
                Este recibo ampara el pago de servicios de Red Seguro Scout. Consérvalo para cualquier aclaración.
            </t>
        </div>
    </template>

    <template id="report_recibo_servicio">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <t t-call="red_seguro_scout.report_recibo_servicio_document"/>
                </t>
            </t>
        </t>
    </template>
</odoo>
