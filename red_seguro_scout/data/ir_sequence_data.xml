<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_rss_payment" model="ir.sequence">
            <field name="name">Red Seguro Scout: recibos de pago</field>
            <field name="code">rss.payment</field>
            <field name="prefix">REC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_rss_claim" model="ir.sequence">
            <field name="name">Red Seguro Scout: siniestros</field>
            <field name="code">rss.claim</field>
            <field name="prefix">SIN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
