<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_rss_payment_request" model="mail.template">
            <field name="name">Red Seguro Scout: datos de pago para el grupo</field>
            <field name="model_id" ref="model_rss_payment"/>
            <field name="subject">Pago del seguro · {{ object.group_id.name }} · {{ object.request_reference }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="description">Se envía a los representantes del grupo con la liga de Mercado Pago y los datos para transferir</field>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px; color: #1A2233;">
    <div style="background: #6E0B14; border-bottom: 3px solid #E9A825; color: #ffffff; padding: 14px 18px; border-radius: 8px 8px 0 0;">
        <strong style="font-size: 16px;">Red Seguro Scout</strong>
        <span style="opacity: .85;"> · Rumbo Seguro</span>
        <div style="opacity: .85; font-size: 13px;">Pago del seguro de accidentes</div>
    </div>
    <div style="border: 1px solid #E9DCCB; border-top: 0; padding: 18px; border-radius: 0 0 8px 8px;">
        <p>Hola,</p>
        <p>Te compartimos los datos para pagar el seguro de
            <strong t-out="object.group_id.name or ''">Grupo 1</strong>.</p>
        <table style="border-collapse: collapse; margin: 10px 0;">
            <tr><td style="padding: 4px 12px 4px 0; color: #4A5568;">Asegurados</td>
                <td style="padding: 4px 0;"><strong t-out="object.member_count">0</strong></td></tr>
            <tr><td style="padding: 4px 12px 4px 0; color: #4A5568;">Importe</td>
                <td style="padding: 4px 0;"><strong t-out="'$ {:,.2f}'.format(object.amount_expected)">$ 0.00</strong></td></tr>
            <tr><td style="padding: 4px 12px 4px 0; color: #4A5568;">Referencia</td>
                <td style="padding: 4px 0;"><strong t-out="object.request_reference or ''">RSP-G1-1</strong></td></tr>
        </table>

        <t t-if="object._mercadopago_available()">
            <div style="background: #F1F9FE; border: 1px solid #B9E3F8; border-radius: 8px; padding: 12px 14px; margin: 12px 0;">
                <strong style="color: #00649A;">Pagar con Mercado Pago</strong>
                <div style="margin: 4px 0 10px; color: #4A5568;">Tarjeta, saldo de Mercado Pago u OXXO. Total
                    <strong t-out="'$ {:,.2f}'.format(object.amount_mp_total)">$ 0.00</strong>
                    <t t-if="object.amount_mp_total &gt; object.amount_expected">(incluye la comisión de Mercado Pago)</t>.
                    El recibo se emite solo.</div>
                <a t-att-href="object.payment_url + '/mercadopago'" style="display: inline-block; margin-top: 6px; background: #009EE3; color: #ffffff; padding: 9px 16px; border-radius: 6px; text-decoration: none; font-weight: bold;">Pagar con Mercado Pago</a>
            </div>
        </t>

        <t t-if="object.policy_id and (object.policy_id.bank_clabe or object.policy_id.bank_account or object.policy_id.bank_card)">
            <div style="background: #FBF7F1; border: 1px solid #E9DCCB; border-radius: 8px; padding: 12px 14px; margin: 12px 0;">
                <strong style="color: #6E0B14;">Transferencia bancaria</strong>
                <div style="margin: 4px 0 6px; color: #4A5568;">Transfiere
                    <strong t-out="'$ {:,.2f}'.format(object.amount_expected)">$ 0.00</strong>
                    y escribe la referencia en el concepto.</div>
                <table style="border-collapse: collapse;">
                    <tr t-if="object.policy_id.bank_beneficiary"><td style="padding: 2px 12px 2px 0; color: #4A5568;">Beneficiario</td><td><strong t-out="object.policy_id.bank_beneficiary">-</strong></td></tr>
                    <tr t-if="object.policy_id.bank_name"><td style="padding: 2px 12px 2px 0; color: #4A5568;">Banco</td><td><strong t-out="object.policy_id.bank_name">-</strong></td></tr>
                    <tr t-if="object.policy_id.bank_clabe"><td style="padding: 2px 12px 2px 0; color: #4A5568;">CLABE</td><td><strong t-out="object.policy_id.bank_clabe">-</strong></td></tr>
                    <tr t-if="object.policy_id.bank_account"><td style="padding: 2px 12px 2px 0; color: #4A5568;">Cuenta</td><td><strong t-out="object.policy_id.bank_account">-</strong></td></tr>
                    <tr t-if="object.policy_id.bank_card"><td style="padding: 2px 12px 2px 0; color: #4A5568;">Tarjeta</td><td><strong t-out="object.policy_id.bank_card">-</strong></td></tr>
                    <tr><td style="padding: 2px 12px 2px 0; color: #4A5568;">Concepto</td><td><strong t-out="object.request_reference or ''">RSP</strong></td></tr>
                </table>
                <div t-if="object.policy_id.bank_notes" style="margin-top: 6px; color: #4A5568;" t-out="object.policy_id.bank_notes"/>
                <div style="margin-top: 10px;">Después de transferir, sube tu comprobante aquí:</div>
                <div style="margin-top: 8px;"><a t-att-href="object.payment_url" style="display: inline-block; background: #6E0B14; color: #ffffff; padding: 9px 16px; border-radius: 6px; text-decoration: none; font-weight: bold;">Subir comprobante</a></div>
            </div>
        </t>
        <p style="color: #4A5568; font-size: 13px;">Toda la información del pago también está en esta liga:
            <a t-att-href="object.payment_url" t-out="object.payment_url or ''">liga</a></p>
        <p>Saludos,<br/><t t-out="object.company_id.name or 'Red Seguro Scout'">Red Seguro Scout</t></p>
    </div>
</div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>
