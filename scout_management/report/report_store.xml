<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_store_receipt" model="ir.actions.report">
        <field name="name">Recibo</field>
        <field name="model">scout.store.sale</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">scout_management.report_store_receipt</field>
        <field name="report_file">scout_management.report_store_receipt</field>
        <field name="print_report_name">object._get_report_base_filename()</field>
        <field name="paperformat_id" ref="paperformat_scout_portrait"/>
        <field name="binding_model_id" ref="model_scout_store_sale"/>
        <field name="binding_type">report</field>
    </record>
    <record id="action_report_daily_sales" model="ir.actions.report">
        <field name="name">Parte de ventas</field>
        <field name="model">scout.daily.sales.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">scout_management.report_daily_sales</field>
        <field name="report_file">scout_management.report_daily_sales</field>
        <field name="print_report_name">'Parte de ventas %s' % object.date_from</field>
        <field name="paperformat_id" ref="paperformat_scout_portrait"/>
    </record>

    <template id="report_store_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <t t-call="scout_management.scout_report_styles"/>
                    <t t-set="company" t-value="doc.company_id"/>
                    <t t-set="money" t-value="lambda v: '$ {:,.2f}'.format(v or 0.0)"/>
                    <div class="page sc-doc">
                        <t t-call="scout_management.scout_doc_header">
                            <t t-set="title">RECIBO</t>
                            <t t-set="subtitle" t-value="'FOLIO: %s · FECHA: %s' % (doc.name, doc.date.strftime('%d / %m / %Y'))"/>
                        </t>
                        <div class="sc-box">
                            <div class="sc-title"><span class="sc-num">1</span>DATOS DE LA VENTA</div>
                            <table class="sc-row">
                                <tr>
                                    <td class="sc-label">Recibimos de:</td><td class="sc-val" t-out="doc.partner_id.name"/>
                                    <td class="sc-label">Tipo:</td><td class="sc-val" t-out="dict(doc._fields['sale_type'].selection).get(doc.sale_type)"/>
                                </tr>
                                <tr>
                                    <td class="sc-label">Miembro:</td>
                                    <td class="sc-val"><t t-out="doc.member_id.name or ''"/><t t-if="doc.member_id.scout_section_id"> (<t t-out="doc.member_id.scout_section_id.display_name"/>)</t></td>
                                    <td class="sc-label">Evento:</td><td class="sc-val" t-out="doc.event_id.name or ''"/>
                                </tr>
                            </table>
                        </div>
                        <div class="sc-box">
                            <div class="sc-title"><span class="sc-num">2</span>DETALLE</div>
                            <table class="sc-table">
                                <tr><th>Producto / servicio</th><th style="width: 12%; text-align: right;">Cantidad</th>
                                    <th style="width: 18%; text-align: right;">Precio</th><th style="width: 18%; text-align: right;">Importe</th></tr>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td t-out="line.product_id.display_name"/>
                                    <td style="text-align: right;" t-out="'%g' % line.quantity"/>
                                    <td style="text-align: right;" t-out="money(line.price_unit)"/>
                                    <td style="text-align: right;" t-out="money(line.subtotal)"/>
                                </tr>
                                <tr><td colspan="3" style="text-align: right;"><b>TOTAL</b></td>
                                    <td style="text-align: right; font-size: 14px;"><b t-out="money(doc.amount_total)"/></td></tr>
                            </table>
                        </div>
                        <div class="sc-box">
                            <div class="sc-title"><span class="sc-num">3</span>PAGO</div>
                            <t t-if="doc.payment_mode == 'paid'">
                                <div>
                                    <span class="sc-opt"><span class="sc-chk">X</span>PAGADO</span>
                                    Forma de pago: <b t-out="dict(doc._fields['payment_method'].selection).get(doc.payment_method, '')"/>
                                    <t t-if="doc.payment_reference"> · Referencia: <b t-out="doc.payment_reference"/></t>
                                    <t t-if="doc.journal_id"> · <t t-out="doc.journal_id.name"/></t>
                                </div>
                            </t>
                            <t t-else="">
                                <div>
                                    <span class="sc-opt"><span class="sc-chk">X</span><t t-out="'PAGO EN LÍNEA' if doc.payment_mode == 'online' else 'PENDIENTE DE PAGO'"/></span>
                                    Cargo <b t-out="doc.invoice_id.name"/> · Saldo:
                                    <b t-out="money(doc.invoice_id.amount_residual)"/>
                                </div>
                            </t>
                            <t t-set="pay" t-value="doc._scout_receipt_pay_qr()"/>
                            <table t-if="pay" class="sc-row" style="margin-top: 6px;">
                                <tr>
                                    <td style="width: 120px;"><img t-att-src="pay['qr']" style="width: 110px; height: 110px;"/></td>
                                    <td style="vertical-align: middle;">
                                        <div style="font-weight: 800; color: #f36f45; font-size: 13px;">PAGA EN LÍNEA</div>
                                        <div>Escanea el código con la cámara de tu celular y paga con tarjeta, OXXO o Mercado Pago.</div>
                                        <div style="font-size: 8px; word-break: break-all;" t-out="pay['link']"/>
                                    </td>
                                </tr>
                            </table>
                            <div t-if="doc.state == 'cancel'" style="color: #c00000; font-weight: 800;">VENTA CANCELADA</div>
                        </div>
                        <table class="sc-row" style="margin-top: 30px;">
                            <tr>
                                <td class="sc-sign" style="width: 45%;">
                                    <div style="height: 25px;"/>
                                    <div t-out="(doc.received_by_id or doc.create_uid).name"/>
                                    <div class="line">RECIBIÓ</div>
                                </td>
                                <td style="width: 10%;"/>
                                <td class="sc-sign" style="width: 45%;">
                                    <div style="height: 25px;"/>
                                    <div t-out="doc.partner_id.name"/>
                                    <div class="line">ENTREGÓ / COMPRADOR</div>
                                </td>
                            </tr>
                        </table>
                        <t t-call="scout_management.scout_greca"><t t-set="greca_class" t-value="'sc-greca-foot'"/></t><div class="sc-motto">⚜ GRACIAS POR APOYAR AL GRUPO · SIEMPRE LISTOS PARA SERVIR ⚜</div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_daily_sales">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-call="scout_management.scout_report_styles"/>
                <div class="page sc-doc">
                    <t t-call="scout_management.scout_doc_header">
                        <t t-set="title">PARTE DE VENTAS</t>
                        <t t-set="subtitle" t-value="'Del %s al %s%s' % (fdate(docs.date_from), fdate(docs.date_to), (' · ' + type_labels.get(docs.sale_type)) if docs.sale_type else '')"/>
                    </t>
                    <t t-foreach="days" t-as="day_item">
                        <t t-set="day" t-value="day_item[1]"/>
                        <div class="sc-box">
                            <div class="sc-title"><t t-out="fdate(day_item[0])"/></div>
                            <table class="sc-table">
                                <tr><th style="width: 13%;">Folio</th><th>Producto</th><th style="width: 7%; text-align: right;">Cant.</th>
                                    <th style="width: 12%; text-align: right;">Importe</th><th style="width: 24%;">Quién compró</th><th style="width: 10%;">¿Pagó?</th></tr>
                                <tr t-foreach="day['lines']" t-as="l">
                                    <td t-out="l.sale_id.name"/>
                                    <td t-out="l.product_id.display_name"/>
                                    <td style="text-align: right;" t-out="'%g' % l.quantity"/>
                                    <td style="text-align: right;" t-out="money(l.subtotal)"/>
                                    <td t-out="l.partner_id.name"/>
                                    <td t-out="dict(l.sale_id._fields['paid_state'].selection).get(l.paid_state)"/>
                                </tr>
                                <tr>
                                    <td colspan="3" style="text-align: right;"><b>Total del día</b></td>
                                    <td style="text-align: right;"><b t-out="money(day['total'])"/></td>
                                    <td colspan="2">Cobrado <t t-out="money(day['paid'])"/> · Por cobrar <t t-out="money(day['credit'])"/></td>
                                </tr>
                            </table>
                        </div>
                    </t>
                    <div class="sc-box">
                        <div class="sc-title">RESUMEN POR PRODUCTO</div>
                        <table class="sc-table">
                            <tr><th>Producto</th><th style="width: 15%; text-align: right;">Piezas</th><th style="width: 18%; text-align: right;">Importe</th><th style="width: 15%; text-align: right;">Existencia</th></tr>
                            <tr t-foreach="products" t-as="p">
                                <td t-out="p[0].display_name"/>
                                <td style="text-align: right;" t-out="'%g' % p[1]['qty']"/>
                                <td style="text-align: right;" t-out="money(p[1]['amount'])"/>
                                <td style="text-align: right;" t-out="('%g' % p[0].scout_qty_available) if p[0].scout_track_qty else '—'"/>
                            </tr>
                            <tr><td colspan="2" style="text-align: right;"><b>TOTAL VENDIDO</b></td><td style="text-align: right;"><b t-out="money(total)"/></td><td/></tr>
                            <tr><td colspan="2" style="text-align: right;">Cobrado</td><td style="text-align: right;" t-out="money(total_paid)"/><td/></tr>
                            <tr><td colspan="2" style="text-align: right;">Por cobrar</td><td style="text-align: right;" t-out="money(total_credit)"/><td/></tr>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
