<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_scout_landscape" model="report.paperformat">
        <field name="name">Carta horizontal (scouts)</field>
        <field name="format">Letter</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>
    <record id="paperformat_scout_portrait" model="report.paperformat">
        <field name="name">Carta vertical (scouts)</field>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_registration" model="ir.actions.report">
        <field name="name">Ficha de registro</field>
        <field name="model">scout.registration</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">scout_management.report_registration_document</field>
        <field name="report_file">scout_management.report_registration_document</field>
        <field name="print_report_name">object._get_report_base_filename()</field>
        <field name="paperformat_id" ref="paperformat_scout_portrait"/>
        <field name="binding_model_id" ref="model_scout_registration"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_attendance" model="ir.actions.report">
        <field name="name">Lista de asistencia del periodo</field>
        <field name="model">scout.attendance.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">scout_management.report_attendance_matrix</field>
        <field name="report_file">scout_management.report_attendance_matrix</field>
        <field name="print_report_name">'Asistencia %s a %s' % (object.date_from, object.date_to)</field>
        <field name="paperformat_id" ref="paperformat_scout_landscape"/>
    </record>

    <record id="action_report_treasury" model="ir.actions.report">
        <field name="name">Reporte de ingresos y egresos</field>
        <field name="model">scout.treasury.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">scout_management.report_treasury_document</field>
        <field name="report_file">scout_management.report_treasury_document</field>
        <field name="print_report_name">'Ingresos y egresos %s a %s' % (object.date_from, object.date_to)</field>
        <field name="paperformat_id" ref="paperformat_scout_portrait"/>
    </record>
    <record id="action_report_program" model="ir.actions.report">
        <field name="name">Programa trimestral</field>
        <field name="model">scout.program.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">scout_management.report_program_document</field>
        <field name="report_file">scout_management.report_program_document</field>
        <field name="print_report_name">'Programa %s %s' % (object.section_id.display_name, object.date_from)</field>
        <field name="paperformat_id" ref="paperformat_scout_landscape"/>
    </record>

    <record id="action_report_member" model="ir.actions.report">
        <field name="name">Expediente scout</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">scout_management.report_member_document</field>
        <field name="report_file">scout_management.report_member_document</field>
        <field name="print_report_name">'Expediente %s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_scout_portrait"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
        <field name="group_ids" eval="[Command.link(ref('group_scout_leader'))]"/>
    </record>

    <record id="action_report_meeting" model="ir.actions.report">
        <field name="name">Acta</field>
        <field name="model">scout.meeting</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">scout_management.report_meeting_document</field>
        <field name="report_file">scout_management.report_meeting_document</field>
        <field name="print_report_name">'Acta %s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_scout_portrait"/>
        <field name="binding_model_id" ref="model_scout_meeting"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_section_report" model="ir.actions.report">
        <field name="name">Informe trimestral</field>
        <field name="model">scout.section.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">scout_management.report_section_report_document</field>
        <field name="report_file">scout_management.report_section_report_document</field>
        <field name="print_report_name">object.name</field>
        <field name="paperformat_id" ref="paperformat_scout_portrait"/>
        <field name="binding_model_id" ref="model_scout_section_report"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_group_calendar" model="ir.actions.report">
        <field name="name">Calendario trimestral del grupo</field>
        <field name="model">scout.calendar.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">scout_management.report_group_calendar</field>
        <field name="report_file">scout_management.report_group_calendar</field>
        <field name="print_report_name">'Calendario %s a %s' % (object.date_from, object.date_to)</field>
        <field name="paperformat_id" ref="paperformat_scout_portrait"/>
    </record>
</odoo>
