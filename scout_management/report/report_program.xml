<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Programa trimestral de sección (desde el calendario) -->
    <template id="report_program_document">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-call="scout_management.scout_report_styles"/>
                <t t-set="accent" t-value="section.report_color or '#0f3049'"/>
                <div class="page sc-doc">
                    <div t-attf-style="background: #{accent}; color: #fff; padding: 8px 10px; border-radius: 6px; text-align: center;">
                        <div style="font-size: 17px; font-weight: 900;">
                            <t t-out="'PROGRAMA ANUAL' if (docs.date_to - docs.date_from).days &gt; 120 else 'PROGRAMA TRIMESTRAL'"/> <t t-out="(section.display_name or '').upper()"/>
                        </div>
                        <div style="font-size: 13px;" t-out="(period_label or '').upper()"/>
                        <div t-if="docs.theme" style="font-size: 11px;">Mística: <t t-out="docs.theme"/></div>
                    </div>
                    <t t-call="scout_management.scout_greca"><t t-set="greca_class" t-value="'sc-greca-tight'"/></t>
                    <table class="sc-table" style="font-size: 10px;">
                        <thead>
                            <tr>
                                <th style="width: 9%;">FECHA</th>
                                <th style="width: 7%;">HORARIO</th>
                                <th style="width: 12%;">MÍSTICA / TEMÁTICA</th>
                                <th style="width: 16%;">NOMBRE DE ACTIVIDAD</th>
                                <th style="width: 11%;">LUGAR</th>
                                <th style="width: 11%;">RESPONSABLE</th>
                                <th>OBJETIVO</th>
                                <th style="width: 11%;">RECONOCIMIENTOS</th>
                                <th style="width: 4%;">✓</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="events" t-as="ev"
                                t-attf-style="#{'background: #eee; color: #777;' if ev.scout_activity_type == 'none' else ''}">
                                <td><b t-out="ev.scout_date.strftime('%d/%m/%y')"/></td>
                                <td t-out="hours(ev)"/>
                                <td t-out="ev.scout_theme or ''"/>
                                <td>
                                    <t t-out="ev.name"/>
                                    <div t-if="ev.scout_activity_type not in ('regular', 'none')" class="text-muted"
                                         t-out="activity_labels.get(ev.scout_activity_type, '')"/>
                                </td>
                                <td t-out="ev.location or ''"/>
                                <td t-out="', '.join(ev.scout_responsible_ids.mapped(lambda p: p.scout_name or p.name)) or ev.user_id.name or ''"/>
                                <td style="white-space: pre-line;" t-out="ev.scout_objective or ''"/>
                                <td t-out="ev.scout_recognitions or ''"/>
                                <td style="text-align: center;" t-out="'✓' if ev.scout_done else ''"/>
                            </tr>
                            <tr t-if="not events"><td colspan="9" class="text-muted">Sin actividades en el calendario para este periodo.</td></tr>
                        </tbody>
                    </table>
                    <t t-if="group_events">
                        <div style="margin-top: 8px; font-weight: 800;">EVENTOS DEL GRUPO EN EL TRIMESTRE</div>
                        <table class="sc-table" style="font-size: 10px;">
                            <tr t-foreach="group_events" t-as="ev">
                                <td style="width: 12%;" t-out="ev.scout_date.strftime('%d/%m/%y')"/>
                                <td style="width: 8%;" t-out="hours(ev)"/>
                                <td t-out="ev.name"/>
                                <td style="width: 25%;" t-out="ev.location or ''"/>
                            </tr>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <!-- Calendario trimestral del grupo (viernes, sábado, domingo) -->
    <template id="report_group_calendar">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-call="scout_management.scout_report_styles"/>
                <style>
                    .cal { width: 100%; border-collapse: collapse; table-layout: fixed; }
                    .cal th { background: #0f3049; color: #fff; padding: 3px; font-size: 10px; }
                    .cal td { border: 1px solid #9aa4bf; height: 52px; vertical-align: top; padding: 2px 4px; font-size: 9px; }
                    .cal .d { font-weight: 800; font-size: 11px; }
                    .cal .ev { background: #ffe9b3; border-radius: 3px; padding: 1px 3px; margin-top: 1px; }
                    .cal .ev-council { background: #cfe0ff; }
                    .cal .ev-camp { background: #d3f0cf; }
                    .cal .ev-none { background: #e0e0e0; }
                    .mon { font-weight: 900; font-size: 13px; margin: 6px 0 2px 0; }
                </style>
                <div class="page sc-doc">
                    <table class="sc-row">
                        <tr>
                            <td style="width: 70px;"><img t-if="company.logo" class="sc-logo" t-att-src="image_data_uri(company.logo)"/></td>
                            <td>
                                <div style="font-size: 18px; font-weight: 900;">CALENDARIO DE ACTIVIDADES</div>
                                <div style="font-size: 14px; font-weight: 800;" t-out="period_label"/>
                                <div><t t-out="company.name"/> | Viernes · sábado · domingo</div>
                            </td>
                        </tr>
                    </table>
                    <t t-call="scout_management.scout_greca"/>
                    <t t-foreach="months" t-as="month">
                        <div class="mon" t-out="month['label']"/>
                        <table class="cal">
                            <thead>
                                <tr>
                                    <th>VIERNES</th><th>SÁBADO</th><th>DOMINGO</th>
                                    <th t-if="docs.show_proposal_space" style="width: 30%;">PROPUESTAS POR SECCIÓN</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="month['weeks']" t-as="week">
                                    <td t-foreach="week" t-as="cell">
                                        <div class="d" t-out="cell['day']"/>
                                        <div t-foreach="cell['events']" t-as="ev" t-attf-class="ev ev-#{ev.scout_activity_type}">
                                            <t t-if="ev.scout_scope == 'section' and ev.scout_section_ids">
                                                <b t-out="', '.join(ev.scout_section_ids.mapped(lambda s: s.code or s.name))"/>:
                                            </t>
                                            <t t-out="ev.name"/>
                                        </div>
                                    </td>
                                    <td t-if="docs.show_proposal_space"/>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                    <div style="margin-top: 6px; font-size: 9px;">
                        <t t-foreach="activities.filtered(lambda a: a.scout_scope == 'group' and a.scout_objective)" t-as="ev">
                            <div><b t-out="ev.name"/>: <t t-out="ev.scout_objective"/></div>
                        </t>
                    </div>
                    <div t-if="docs.notes" style="margin-top: 4px; font-size: 9px; white-space: pre-line;" t-out="docs.notes"/>
                </div>
            </t>
        </t>
    </template>
</odoo>
