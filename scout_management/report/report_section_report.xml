<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="section_report_card">
        <!-- Variables: num, title, items (recordset scout.section.report.item), accent -->
        <div class="rp-card">
            <div class="rp-card-title" t-attf-style="background: #{accent};">
                <span t-if="num" class="rp-num" t-attf-style="color: #{accent};" t-out="num"/>
                <t t-out="title"/>
            </div>
            <div class="rp-card-body">
                <t t-out="0"/>
                <ul t-if="items" class="rp-list">
                    <li t-foreach="items" t-as="it" t-out="it.name"/>
                </ul>
                <div t-if="not items and not has_body" class="text-muted">—</div>
            </div>
        </div>
    </template>

    <template id="report_section_report_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <t t-call="scout_management.scout_report_styles"/>
                    <t t-set="accent" t-value="doc.section_id.report_color or '#0f3049'"/>
                    <t t-set="labels" t-value="doc._role_labels()"/>
                    <t t-set="patrol_word" t-value="doc.section_id.patrol_label or 'Equipo'"/>
                    <style>
                        .rp-grid { width: 100%; border-collapse: separate; border-spacing: 6px; table-layout: fixed; }
                        .rp-grid > tbody > tr > td { vertical-align: top; padding: 0; }
                        .rp-card { border: 1.5px solid #c9cfdf; border-radius: 8px; overflow: hidden; background: #fff; page-break-inside: avoid; }
                        .rp-card-title { color: #fff; font-weight: 800; font-size: 12px; padding: 4px 8px; }
                        .rp-num { display: inline-block; background: #fff; border-radius: 9px; width: 18px; height: 18px; line-height: 18px; text-align: center; margin-right: 6px; font-weight: 900; }
                        .rp-card-body { padding: 5px 8px; font-size: 10px; }
                        .rp-list { margin: 0; padding-left: 14px; }
                        .rp-list li { margin-bottom: 2px; }
                        .rp-tiles { width: 100%; border-collapse: separate; border-spacing: 3px; }
                        .rp-tiles td { text-align: center; border-radius: 6px; padding: 3px 2px; font-size: 8.5px; }
                        .rp-tiles .v { font-size: 18px; font-weight: 900; display: block; }
                        .rp-mini { width: 100%; border-collapse: collapse; font-size: 9.5px; }
                        .rp-mini td, .rp-mini th { border-bottom: 1px solid #e3e6ee; padding: 2px 3px; text-align: left; }
                        .rp-mini th { color: #555; }
                        .rp-patrol { border: 1px solid #d6dbe8; border-radius: 6px; padding: 3px 5px; margin-bottom: 4px; }
                        .rp-patrol-name { font-weight: 800; }
                        .rp-role { color: #666; font-size: 8.5px; }
                        .rp-banner { text-align: center; color: #fff; border-radius: 8px; padding: 8px; }
                        .rp-foot { text-align: center; font-weight: 900; font-size: 12px; margin-top: 4px; }
                    </style>
                    <div class="page sc-doc">
                        <!-- Encabezado -->
                        <table class="sc-row">
                            <tr>
                                <td style="width: 70px;"><img t-if="doc.company_id.logo" class="sc-logo" t-att-src="image_data_uri(doc.company_id.logo)"/></td>
                                <td>
                                    <div class="rp-banner" t-attf-style="background: #{accent};">
                                        <div style="font-size: 20px; font-weight: 900;" t-out="(doc.section_id.display_name or '').upper()"/>
                                        <div style="font-size: 14px; font-weight: 800;" t-out="'REPORTE ANUAL' if doc.period_type == 'annual' else 'REPORTE TRIMESTRAL'"/>
                                        <div style="font-size: 11px;">
                                            <t t-out="(doc.presented_to or '').upper()"/> · <t t-out="(doc.period_label or '').upper()"/>
                                            · <t t-out="(doc.company_id.name or '').upper()"/>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <t t-call="scout_management.scout_greca"/>
                        <table class="rp-grid">
                            <tr>
                                <!-- 1. Estado actual -->
                                <td>
                                    <t t-call="scout_management.section_report_card">
                                        <t t-set="num" t-value="1"/>
                                        <t t-set="title">ESTADO ACTUAL</t>
                                        <t t-set="items" t-value="doc._items('status')"/>
                                        <t t-set="has_body" t-value="True"/>
                                        <table class="rp-tiles">
                                            <tr>
                                                <td style="background: #e7e2f6;"><span class="v" t-out="doc.registered_count"/>Registrados</td>
                                                <td style="background: #dff3e4;"><span class="v" t-out="doc.paid_count"/>Registro pagado</td>
                                                <td style="background: #dcebfb;"><span class="v" t-out="doc.constant_count"/>Constantes</td>
                                            </tr>
                                            <tr>
                                                <td style="background: #fdf1cf;"><span class="v" t-out="doc.intermittent_count"/>Intermitentes</td>
                                                <td style="background: #fbe0e4;"><span class="v" t-out="doc.risk_count"/>Prob. no regresan</td>
                                                <td style="background: #f4ead9;"><span class="v" t-out="doc.promise_count"/>Con Promesa</td>
                                            </tr>
                                        </table>
                                        <div t-if="doc.situation" style="margin: 3px 0; white-space: pre-line;" t-out="doc.situation"/>
                                        <div t-if="doc.avg_attendance" class="text-muted">
                                            Asistencia promedio: <b t-out="round(doc.avg_attendance)"/> %
                                        </div>
                                    </t>
                                </td>
                                <!-- 2. Ruta de enlace -->
                                <td>
                                    <t t-call="scout_management.section_report_card">
                                        <t t-set="num" t-value="2"/>
                                        <t t-set="title">RUTA DE ENLACE</t>
                                        <t t-set="items" t-value="doc._items('transition')"/>
                                        <t t-set="has_body" t-value="False"/>
                                    </t>
                                </td>
                                <!-- 3. Avances del trimestre anterior -->
                                <td>
                                    <t t-call="scout_management.section_report_card">
                                        <t t-set="num" t-value="3"/>
                                        <t t-set="title" t-value="'SITUACIÓN AL INICIAR EL CICLO' if doc.period_type == 'annual' else 'AVANCES DEL TRIMESTRE ANTERIOR'"/>
                                        <t t-set="items" t-value="doc._items('previous')"/>
                                        <t t-set="has_body" t-value="False"/>
                                    </t>
                                </td>
                            </tr>
                        </table>

                        <!-- Equipos (seisenas / patrullas / madrigueras) -->
                        <t t-set="blocks" t-value="doc._patrol_blocks()"/>
                        <table class="rp-grid">
                            <tr>
                                <td style="width: 52%;">
                                    <t t-call="scout_management.section_report_card">
                                        <t t-set="num" t-value="False"/>
                                        <t t-set="title"><t t-out="(patrol_word + 's').upper()"/> CON MIEMBROS Y <t t-out="labels[0].upper()"/> / <t t-out="labels[1].upper()"/></t>
                                        <t t-set="items" t-value="False"/>
                                        <t t-set="has_body" t-value="True"/>
                                        <table class="sc-row">
                                            <tr>
                                                <t t-foreach="blocks[0]" t-as="blk">
                                                    <td style="vertical-align: top; padding: 0 2px;">
                                                        <div class="rp-patrol">
                                                            <div class="rp-patrol-name" t-out="blk['patrol'].name"/>
                                                            <div t-foreach="blk['lines']" t-as="ml">
                                                                <t t-out="ml.member_id.scout_name or (ml.member_id.scout_first_name or ml.member_id.name or '').split(' ')[0]"/>
                                                                <span class="rp-role" t-if="ml.patrol_role == 'leader'">(<t t-out="labels[0]"/>)</span>
                                                                <span class="rp-role" t-if="ml.patrol_role == 'sub'">(<t t-out="labels[1]"/>)</span>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </t>
                                            </tr>
                                        </table>
                                        <div t-if="blocks[1]" class="text-muted" style="font-size: 9px;">
                                            Sin <t t-out="patrol_word.lower()"/> asignada:
                                            <t t-out="', '.join(blocks[1].mapped(lambda l: l.member_id.scout_name or (l.member_id.scout_first_name or l.member_id.name or '').split(' ')[0]))"/>
                                        </div>
                                    </t>
                                </td>
                                <td>
                                    <t t-call="scout_management.section_report_card">
                                        <t t-set="num" t-value="False"/>
                                        <t t-set="title">SEGUIMIENTO DE AVANCES POR DIRIGENTES</t>
                                        <t t-set="items" t-value="False"/>
                                        <t t-set="has_body" t-value="True"/>
                                        <table class="rp-mini">
                                            <tr t-foreach="blocks[0]" t-as="blk">
                                                <td t-out="blk['leader'].scout_name or blk['leader'].name or '—'"/>
                                                <td class="text-muted" t-out="blk['patrol'].name"/>
                                            </tr>
                                        </table>
                                    </t>
                                    <div style="height: 6px;"/>
                                    <t t-call="scout_management.section_report_card">
                                        <t t-set="num" t-value="False"/>
                                        <t t-set="title">RESCATE Y SEGUIMIENTO</t>
                                        <t t-set="items" t-value="doc._items('rescue')"/>
                                        <t t-set="has_body" t-value="False"/>
                                    </t>
                                </td>
                            </tr>
                        </table>

                        <!-- Avances en el recorrido -->
                        <table class="rp-grid">
                            <tr>
                                <td>
                                    <t t-call="scout_management.section_report_card">
                                        <t t-set="num" t-value="False"/>
                                        <t t-set="title">AVANCES EN EL RECORRIDO</t>
                                        <t t-set="items" t-value="False"/>
                                        <t t-set="has_body" t-value="True"/>
                                        <table class="rp-mini">
                                            <thead>
                                                <tr><th style="width: 22%;">Miembro</th><th style="width: 15%;"><t t-out="patrol_word"/></th><th style="width: 9%;">Asist.</th><th>Avances</th></tr>
                                            </thead>
                                            <tr t-foreach="doc.member_line_ids" t-as="ml">
                                                <td>
                                                    <t t-out="(ml.member_id.scout_first_name or ml.member_id.name or '').split(' ')[0]"/>
                                                    <span class="rp-role" t-if="ml.member_id.scout_name">(<t t-out="ml.member_id.scout_name"/>)</span>
                                                </td>
                                                <td t-out="ml.patrol_id.name or ''"/>
                                                <td t-attf-style="color: #{'#1b7f1b' if ml.attendance_class == 'constant' else ('#b8860b' if ml.attendance_class == 'intermittent' else '#c00000')};">
                                                    <t t-if="ml.attendance_class != 'no_data'"><t t-out="round(ml.attendance_pct)"/> %</t>
                                                </td>
                                                <td>
                                                    <t t-out="ml.progress_summary"/>
                                                    <t t-if="ml.note"> · <i t-out="ml.note"/></t>
                                                </td>
                                            </tr>
                                        </table>
                                    </t>
                                </td>
                            </tr>
                        </table>

                        <table class="rp-grid">
                            <tr>
                                <td>
                                    <t t-call="scout_management.section_report_card">
                                        <t t-set="num" t-value="4"/>
                                        <t t-set="title">OBJETIVOS <t t-out="(doc.period_label or '').upper()"/></t>
                                        <t t-set="items" t-value="doc._items('objective')"/>
                                        <t t-set="has_body" t-value="False"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-call="scout_management.section_report_card">
                                        <t t-set="num" t-value="5"/>
                                        <t t-set="title" t-value="'ACTIVIDADES DEL CICLO' if doc.period_type == 'annual' else 'ACTIVIDADES DEL TRIMESTRE'"/>
                                        <t t-set="items" t-value="doc._items('activity')"/>
                                        <t t-set="has_body" t-value="False"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-call="scout_management.section_report_card">
                                        <t t-set="num" t-value="6"/>
                                        <t t-set="title">NECESIDADES Y GESTIÓN</t>
                                        <t t-set="items" t-value="doc._items('need')"/>
                                        <t t-set="has_body" t-value="False"/>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <t t-call="scout_management.section_report_card">
                                        <t t-set="num" t-value="7"/>
                                        <t t-set="title">OBJETIVOS CLAVE</t>
                                        <t t-set="items" t-value="doc._items('key')"/>
                                        <t t-set="has_body" t-value="False"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-call="scout_management.section_report_card">
                                        <t t-set="num" t-value="8"/>
                                        <t t-set="title" t-value="'AVANCES DEL CICLO' if doc.period_type == 'annual' else 'AVANCES DEL TRIMESTRE'"/>
                                        <t t-set="items" t-value="doc._items('progress')"/>
                                        <t t-set="has_body" t-value="False"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-call="scout_management.section_report_card">
                                        <t t-set="num" t-value="9"/>
                                        <t t-set="title">PRÓXIMOS PASOS</t>
                                        <t t-set="items" t-value="doc._items('next')"/>
                                        <t t-set="has_body" t-value="False"/>
                                    </t>
                                </td>
                            </tr>
                        </table>
                        <div t-if="doc.closing_phrase" class="rp-foot" t-attf-style="color: #{accent};">
                            ⚜ <t t-out="doc.closing_phrase.upper()"/> ⚜
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
