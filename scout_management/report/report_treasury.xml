<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_treasury_document">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-call="scout_management.scout_report_styles"/>
                <style>
                    .tr-sec { background: #0f3049; color: #fff; font-weight: 800; padding: 3px 6px; margin-top: 8px; }
                    .tr-tot td { font-weight: 800; border-top: 2px solid #0f3049; }
                    .num { text-align: right; white-space: nowrap; }
                    .neg { color: #c00000; }
                    .ti { color: #1b2f5e; font-size: 10.5px; }
                    .ti table { border-collapse: collapse; }
                    .ti-head { width: 100%; margin-bottom: 10px; }
                    .ti-head td { vertical-align: middle; }
                    .ti-vline { width: 2px; background: #c9d1dc; }
                    .ti-title { font-size: 30px; font-weight: 900; line-height: 32px; color: #1b2f5e; }
                    .ti-sub { font-size: 17px; font-weight: 700; color: #33465f; margin-top: 2px; }
                    .ti-rule { border-top: 1px solid #c9d1dc; margin: 6px 0 4px 0; height: 6px; position: relative; }
                    .ti-rule div { width: 45%; height: 6px; background: #d62828; margin-left: 55%; margin-top: -3px; }
                    .ti-cut { font-size: 12px; color: #5b6b80; }
                    .ti-cards { width: 100%; table-layout: fixed; border-collapse: separate !important; border-spacing: 6px 0; margin: 0 -6px 8px -6px; }
                    .ti-cards td { vertical-align: top; }
                    .ti-card { height: 46px; border: 1px solid #c9d1dc; border-left: 6px solid #1b2f5e; border-radius: 6px; padding: 7px 9px; background: #f7f9fb; }
                    .ti-card .lbl { font-size: 10px; font-weight: 700; color: #33465f; text-transform: uppercase; letter-spacing: .3px; }
                    .ti-card .big { font-size: 19px; font-weight: 900; color: #1b2f5e; margin-top: 2px; white-space: nowrap; }
                    .ti-card .hint { font-size: 8px; color: #7a889a; }
                    .ti-grid { width: 100%; table-layout: fixed; border-collapse: separate !important; border-spacing: 6px 0; margin: 0 -6px 8px -6px; }
                    .ti-grid > tbody > tr > td, .ti-grid > tr > td { vertical-align: top; }
                    .ti-box { border: 1px solid #c9d1dc; border-radius: 7px; overflow: hidden; page-break-inside: avoid; }
                    .ti-bh { background: #1b2f5e; color: #fff; font-size: 13px; font-weight: 800; padding: 5px 9px; }
                    .ti-bb { padding: 7px 9px; }
                    .ti-t { width: 100%; }
                    .ti-t th { background: #e9edf2; color: #1b2f5e; font-weight: 800; padding: 3px 6px; text-align: left; border-bottom: 1px solid #c9d1dc; }
                    .ti-t td { padding: 3px 6px; border-bottom: 1px solid #e3e8ee; }
                    .ti-t .num, .ti-t th.num { text-align: right; white-space: nowrap; }
                    .ti-t .b { font-weight: 800; }
                    .ti-t .who { color: #7a889a; font-size: 9px; }
                    .ti-tot td { background: #1b2f5e; color: #fff; font-weight: 900; font-size: 12px; padding: 4px 6px; border: none; }
                    .ti-tot.red td { background: #8b1a2b; }
                    .ti-tot.green td { background: #1f6b35; }
                    .muted { color: #7a889a; font-style: italic; }
                    .ti-hbar { width: 100%; }
                    .ti-hbar td { padding: 2px 0; vertical-align: middle; }
                    .ti-hbar .l { width: 34%; text-align: right; padding-right: 6px; font-weight: 700; color: #8b1a2b; font-size: 10px; }
                    .ti-hbar .b { border-left: 1px solid #9aa6b5; padding-left: 0; white-space: nowrap; }
                    .ti-hbar .bar { display: inline-block; height: 13px; background: #a3192c; vertical-align: middle; }
                    .ti-hbar .v { font-size: 9.5px; padding-left: 4px; vertical-align: middle; }
                    .ti-vbar { width: 100%; table-layout: fixed; }
                    .ti-vbar td { text-align: center; padding: 0 3px; }
                    .ti-vbar .vals td { font-size: 8.5px; font-weight: 800; vertical-align: bottom; padding-bottom: 2px; }
                    .ti-vbar .cols td { vertical-align: bottom; height: 124px; border-bottom: 1px solid #1b2f5e; }
                    .ti-vbar .col { width: 70%; margin: 0 auto; }
                    .ti-vbar .labs td { font-size: 9px; font-weight: 700; padding-top: 3px; }
                    .ti-find { margin: 0; padding-left: 15px; }
                    .ti-find li { margin-bottom: 3px; }
                    .ti-notes { margin-top: 5px; white-space: pre-line; border-top: 1px dashed #c9d1dc; padding-top: 4px; }
                    .hint2 { font-size: 8.5px; color: #7a889a; padding-top: 3px; padding-bottom: 4px; }
                    .ti-proj { border: 2px solid #1f8a3b; border-radius: 6px; padding: 6px 10px; font-size: 12px; background: #f7f9fb; }
                    .ti-mbar { width: 100%; table-layout: fixed; }
                    .ti-mbar td { text-align: center; padding: 0 2px; }
                    .ti-mbar .cols td { vertical-align: bottom; height: 114px; border-bottom: 1px solid #1b2f5e; }
                    .ti-mbar .pair { white-space: nowrap; font-size: 0; }
                    .ti-mbar .col { display: inline-block; width: 38%; vertical-align: bottom; margin: 0 1px; }
                    .ti-mbar .col.in { background: #1f8a3b; }
                    .ti-mbar .col.out { background: #d62828; }
                    .ti-mbar .labs td { font-size: 8.5px; font-weight: 700; padding-top: 3px; }
                    .ti-legend { font-size: 9px; margin-top: 4px; }
                    .ti-legend .sw { display: inline-block; width: 9px; height: 9px; vertical-align: middle; }
                    .ti-foot { text-align: center; color: #7a889a; font-size: 9px; margin-top: 8px; }
                </style>
                <div class="page sc-doc ti">
                    <!-- ============ HOJA 1: INFOGRAFÍA ============ -->
                    <table class="ti-head">
                        <tr>
                            <td style="width: 118px;">
                                <img t-if="logo" t-att-src="image_data_uri(logo)" style="width: 105px; height: 105px;"/>
                            </td>
                            <td class="ti-vline"/>
                            <td style="padding-left: 14px;">
                                <div class="ti-title">Informe de Tesorería</div>
                                <div class="ti-sub" t-out="company.name"/>
                                <div class="ti-rule"><div/></div>
                                <div class="ti-cut">Periodo: <t t-out="date_from"/> al <t t-out="date_to"/>
                                    <span t-if="audience"> · Para: <t t-out="audience"/></span></div>
                            </td>
                        </tr>
                    </table>

                    <table class="ti-cards">
                        <tr>
                            <td><div class="ti-card" style="border-left-color: #1b2f5e;">
                                <div class="lbl">Disponible hoy</div>
                                <div class="big" t-out="money(closing_total)"/>
                                <div class="hint">Caja + bancos + Mercado Pago</div></div></td>
                            <td><div class="ti-card" style="border-left-color: #1f8a3b;">
                                <div class="lbl">Ingresos del periodo</div>
                                <div class="big" style="color: #1f8a3b;" t-out="money(total_income)"/></div></td>
                            <td t-if="include_pending"><div class="ti-card" style="border-left-color: #8b1a2b;">
                                <div class="lbl">Deudas por pagar</div>
                                <div class="big" style="color: #8b1a2b;" t-out="money(total_payable)"/></div></td>
                            <td t-if="include_pending"><div class="ti-card" style="border-left-color: #e0a800;">
                                <div class="lbl">Cobros pendientes</div>
                                <div class="big" style="color: #b38600;" t-out="money(total_receivable)"/></div></td>
                        </tr>
                    </table>

                    <table class="ti-grid">
                        <tr>
                            <td style="width: 42%;">
                                <div class="ti-box">
                                    <div class="ti-bh">Disponible por cuenta</div>
                                    <table class="ti-t">
                                        <thead><tr><th>Cuenta</th><th class="num">Saldo hoy</th></tr></thead>
                                        <tbody>
                                            <tr t-foreach="accounts" t-as="row">
                                                <td class="b" t-out="row['journal'].name"/>
                                                <td t-attf-class="num b #{'neg' if row['closing'] &lt; 0 else ''}" t-out="money(row['closing'])"/>
                                            </tr>
                                        </tbody>
                                        <tr class="ti-tot"><td>Total disponible</td><td class="num" t-out="money(closing_total)"/></tr>
                                    </table>
                                </div>
                            </td>
                            <td style="width: 58%;">
                                <div class="ti-box">
                                    <div class="ti-bh">Ingresos del periodo</div>
                                    <table class="ti-t">
                                        <thead><tr><th>Concepto</th><th class="num">Movs.</th><th class="num">Monto</th><th class="num">%</th></tr></thead>
                                        <tbody>
                                            <tr t-if="not income_rows"><td colspan="4" class="muted">Sin ingresos en el periodo.</td></tr>
                                            <tr t-foreach="income_rows" t-as="r">
                                                <td t-out="r['label']"/>
                                                <td class="num" t-out="r['count']"/>
                                                <td class="num b" t-out="money(r['amount'])"/>
                                                <td class="num"><t t-out="'%.1f' % r['pct']"/> %</td>
                                            </tr>
                                        </tbody>
                                        <tr class="ti-tot green"><td colspan="2">Total ingresos</td><td class="num" t-out="money(total_income)"/><td class="num">100 %</td></tr>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <table class="ti-grid">
                        <tr>
                            <td>
                                <div class="ti-box">
                                    <div class="ti-bh">Pagos realizados en el periodo</div>
                                    <table class="ti-t">
                                        <thead><tr><th>Concepto</th><th class="num">Monto</th></tr></thead>
                                        <tbody>
                                            <tr t-if="not expense_rows"><td colspan="2" class="muted">Sin pagos en el periodo.</td></tr>
                                            <tr t-foreach="expense_rows" t-as="r">
                                                <td t-out="r['label']"/>
                                                <td class="num b" t-out="money(r['amount'])"/>
                                            </tr>
                                        </tbody>
                                        <tr class="ti-tot red"><td>Total pagado</td><td class="num" t-out="money(total_expense)"/></tr>
                                    </table>
                                    <div class="ti-bb hint2">Informativo: estos pagos ya están reflejados en el disponible de hoy.</div>
                                </div>
                            </td>
                            <td>
                                <div class="ti-box">
                                    <div class="ti-bh">Panorama financiero</div>
                                    <div class="ti-bb">
                                        <table class="ti-vbar">
                                            <tr class="vals">
                                                <td t-foreach="overview" t-as="o"><t t-out="money(o['amount'])"/></td>
                                            </tr>
                                            <tr class="cols">
                                                <td t-foreach="overview" t-as="o">
                                                    <div class="col" t-attf-style="height: #{o['height']}px; background: #{o['color']};"/>
                                                </td>
                                            </tr>
                                            <tr class="labs">
                                                <td t-foreach="overview" t-as="o" t-out="o['label']"/>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <table t-if="include_pending" class="ti-grid">
                        <tr>
                            <td>
                                <div class="ti-box">
                                    <div class="ti-bh">Deudas pendientes de pago</div>
                                    <table class="ti-t">
                                        <thead><tr><th>Concepto</th><th class="num">Pendiente</th></tr></thead>
                                        <tbody>
                                            <tr t-if="not payable_rows"><td colspan="2" class="muted">El grupo no tiene deudas pendientes.</td></tr>
                                            <tr t-foreach="payable_rows" t-as="r">
                                                <td><t t-out="r['label']"/><span t-if="r['who']" class="who"> · <t t-out="r['who']"/></span></td>
                                                <td class="num b" t-out="money(r['amount'])"/>
                                            </tr>
                                        </tbody>
                                        <tr class="ti-tot red"><td>Total por pagar</td><td class="num" t-out="money(total_payable)"/></tr>
                                    </table>
                                </div>
                            </td>
                            <td>
                                <div class="ti-box">
                                    <div class="ti-bh">Cobros pendientes a miembros</div>
                                    <table class="ti-t">
                                        <thead><tr><th>Concepto</th><th class="num">Por cobrar</th></tr></thead>
                                        <tbody>
                                            <tr t-if="not receivable_rows"><td colspan="2" class="muted">No hay cobros pendientes.</td></tr>
                                            <tr t-foreach="receivable_rows" t-as="r">
                                                <td><t t-out="r['label']"/><span t-if="r['who']" class="who"> · <t t-out="r['who']"/></span></td>
                                                <td class="num b" t-out="money(r['amount'])"/>
                                            </tr>
                                        </tbody>
                                        <tr class="ti-tot green"><td>Total por cobrar</td><td class="num" t-out="money(total_receivable)"/></tr>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <div t-if="include_pending" class="ti-proj" t-attf-style="border-color: #{'#1f8a3b' if projected &gt;= 0 else '#d62828'};">
                        <b>Saldo proyectado:</b> disponible <t t-out="money(closing_total)"/> + por cobrar <t t-out="money(total_receivable)"/>
                        − por pagar <t t-out="money(total_payable)"/> =
                        <b t-attf-style="color: #{'#1f8a3b' if projected &gt;= 0 else '#d62828'};" t-out="money(projected)"/>
                    </div>

                    <div class="ti-box" style="margin-top: 8px;">
                        <div class="ti-bh">Principales hallazgos</div>
                        <div class="ti-bb">
                            <ul class="ti-find">
                                <li t-foreach="findings" t-as="f" t-out="f"/>
                            </ul>
                            <div t-if="notes" class="ti-notes"><b>Notas:</b> <t t-out="notes"/></div>
                        </div>
                    </div>

                    <table class="sc-row" style="margin-top: 26px;">
                        <tr>
                            <td class="sc-sign"><div class="line">TESORERÍA<br/><span style="font-weight: 400;">Nombre y firma</span></div></td>
                            <td style="width: 10%;"/>
                            <td class="sc-sign"><div class="line">JEFATURA DE GRUPO<br/><span style="font-weight: 400;">Nombre y firma</span></div></td>
                        </tr>
                    </table>
                    <div class="ti-foot">Corte al <t t-out="cut_date"/> · Documento generado desde la plataforma del grupo</div>

                    <!-- ============ COMPARATIVO POR MES ============ -->
                    <t t-if="trend">
                    <div style="page-break-before: always;"/>
                    <table class="ti-head">
                        <tr>
                            <td style="width: 80px;">
                                <img t-if="logo" t-att-src="image_data_uri(logo)" style="width: 70px; height: 70px;"/>
                            </td>
                            <td class="ti-vline"/>
                            <td style="padding-left: 14px;">
                                <div class="ti-title" style="font-size: 24px; line-height: 26px;">Ingresos y egresos por mes</div>
                                <div class="ti-sub">Últimos <t t-out="trend['months']"/> meses · <t t-out="trend['from_label']"/> a <t t-out="trend['to_label']"/></div>
                                <div class="ti-rule"><div/></div>
                            </td>
                        </tr>
                    </table>

                    <table class="ti-cards">
                        <tr>
                            <td><div class="ti-card" style="border-left-color: #1f8a3b;">
                                <div class="lbl">Ingresos del periodo</div>
                                <div class="big" style="color: #1f8a3b;" t-out="money(trend['total_income'])"/></div></td>
                            <td><div class="ti-card" style="border-left-color: #d62828;">
                                <div class="lbl">Egresos del periodo</div>
                                <div class="big" style="color: #d62828;" t-out="money(trend['total_expense'])"/></div></td>
                            <td><div class="ti-card" t-attf-style="border-left-color: #{'#1b2f5e' if trend['net'] &gt;= 0 else '#d62828'};">
                                <div class="lbl">Resultado (ingresos − egresos)</div>
                                <div class="big" t-attf-style="color: #{'#1b2f5e' if trend['net'] &gt;= 0 else '#d62828'};" t-out="money(trend['net'])"/></div></td>
                        </tr>
                    </table>

                    <div class="ti-box" style="margin-bottom: 8px;">
                        <div class="ti-bh">Ingresos y egresos mes por mes</div>
                        <div class="ti-bb">
                            <table class="ti-mbar">
                                <tr class="cols">
                                    <td t-foreach="trend['rows']" t-as="r">
                                        <div class="pair">
                                            <div class="col in" t-attf-style="height: #{r['h_in']}px;"/>
                                            <div class="col out" t-attf-style="height: #{r['h_out']}px;"/>
                                        </div>
                                    </td>
                                </tr>
                                <tr class="labs">
                                    <td t-foreach="trend['rows']" t-as="r"><t t-out="r['label']"/><t t-if="r['historic']">*</t></td>
                                </tr>
                            </table>
                            <div class="ti-legend"><span class="sw" style="background: #1f8a3b;"/> Ingresos <span class="sw" style="background: #d62828; margin-left: 12px;"/> Egresos</div>
                        </div>
                        <table class="ti-t">
                            <thead><tr><th>Mes</th><th class="num">Ingresos</th><th class="num">Egresos</th><th class="num">Resultado</th></tr></thead>
                            <tbody>
                                <tr t-foreach="trend['rows']" t-as="r">
                                    <td class="b"><t t-out="r['label']"/><t t-if="r['historic']">*</t></td>
                                    <td class="num" t-out="money(r['income']) if not r['empty'] else '—'"/>
                                    <td class="num" t-out="money(r['expense']) if not r['empty'] else '—'"/>
                                    <td t-attf-class="num b #{'neg' if r['net'] &lt; 0 else ''}" t-out="money(r['net']) if not r['empty'] else '—'"/>
                                </tr>
                            </tbody>
                            <tr class="ti-tot"><td>Total</td><td class="num" t-out="money(trend['total_income'])"/><td class="num" t-out="money(trend['total_expense'])"/><td class="num" t-out="money(trend['net'])"/></tr>
                        </table>
                    </div>

                    <table class="ti-grid">
                        <tr>
                            <td>
                                <div class="ti-box">
                                    <div class="ti-bh">Ingresos por rubro</div>
                                    <div class="ti-bb">
                                        <div t-if="not trend['income_by_group']" class="muted">Sin ingresos.</div>
                                        <table class="ti-hbar">
                                            <tr t-foreach="trend['income_by_group']" t-as="r">
                                                <td class="l" style="color: #1f6b35;" t-out="r['label']"/>
                                                <td class="b">
                                                    <div class="bar" t-attf-style="background: #1f8a3b; width: #{'%.0f' % (r['width'] * 0.55)}%;"/>
                                                    <span class="v"><b t-out="money(r['amount'])"/> (<t t-out="'%.0f' % r['pct']"/> %)</span>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="ti-box">
                                    <div class="ti-bh">Egresos por categoría</div>
                                    <div class="ti-bb">
                                        <div t-if="not trend['expense_by_category']" class="muted">Sin egresos.</div>
                                        <table class="ti-hbar">
                                            <tr t-foreach="trend['expense_by_category']" t-as="r">
                                                <td class="l" t-out="r['label']"/>
                                                <td class="b">
                                                    <div class="bar" t-attf-style="width: #{'%.0f' % (r['width'] * 0.55)}%;"/>
                                                    <span class="v"><b t-out="money(r['amount'])"/> (<t t-out="'%.0f' % r['pct']"/> %)</span>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>
                    <ul t-if="trend['notes']" class="ti-find" style="margin-top: 6px;">
                        <li t-foreach="trend['notes']" t-as="n" t-out="n"/>
                    </ul>
                    </t>

                    <!-- ============ HOJAS SIGUIENTES: DETALLE ============ -->
                    <t t-if="include_detail">
                    <div style="page-break-before: always;"/>
                    <table class="sc-row">
                        <tr>
                            <td style="width: 70px;">
                                <img t-if="logo" class="sc-logo" t-att-src="image_data_uri(logo)"/>
                            </td>
                            <td>
                                <div style="font-size: 17px; font-weight: 900;" t-out="company.name"/>
                                <div style="font-size: 14px; font-weight: 800;">DETALLE DE INGRESOS Y EGRESOS</div>
                                <div>Del <b t-out="date_from"/> al <b t-out="date_to"/></div>
                            </td>
                        </tr>
                    </table>

                    <t t-call="scout_management.scout_greca"/>
                    <div class="tr-sec">SALDOS INICIALES</div>
                    <table class="sc-table">
                        <thead><tr><th>Caja / banco</th><th class="num">Saldo inicial</th><th class="num">Ingresos</th><th class="num">Egresos</th><th class="num">Traspasos (+/-)</th><th class="num">Saldo final</th></tr></thead>
                        <tbody>
                            <tr t-foreach="accounts" t-as="row">
                                <td><t t-out="row['journal'].name"/></td>
                                <td class="num" t-out="money(row['opening'])"/>
                                <td class="num" t-out="money(row['income'])"/>
                                <td class="num" t-out="money(row['expense'])"/>
                                <td class="num" t-out="money(row['transfer'])"/>
                                <td t-attf-class="num #{'neg' if row['closing'] &lt; 0 else ''}" t-out="money(row['closing'])"/>
                            </tr>
                            <tr class="tr-tot">
                                <td>TOTAL</td>
                                <td class="num" t-out="money(opening_total)"/>
                                <td class="num" t-out="money(total_income)"/>
                                <td class="num" t-out="money(total_expense)"/>
                                <td/>
                                <td class="num" t-out="money(closing_total)"/>
                            </tr>
                        </tbody>
                    </table>

                    <div class="tr-sec">INGRESOS</div>
                    <t t-if="not income_groups"><p class="text-muted">Sin ingresos en el periodo.</p></t>
                    <t t-foreach="income_groups" t-as="grp">
                        <div style="font-weight: 800; margin-top: 4px;" t-out="grp['label'].upper()"/>
                        <table class="sc-table">
                            <tr t-foreach="grp['moves']" t-as="mv">
                                <td style="width: 12%;" t-out="mv['date'].strftime('%d/%m/%Y')"/>
                                <td t-out="mv['label']"/>
                                <td style="width: 18%;" t-out="mv['who']"/>
                                <td style="width: 14%;" t-out="mv['journal']"/>
                                <td style="width: 12%;" t-out="mv['ref']"/>
                                <td class="num" style="width: 13%;" t-out="money(mv['amount'])"/>
                            </tr>
                            <tr class="tr-tot"><td colspan="5">TOTAL <t t-out="grp['label'].upper()"/></td><td class="num" t-out="money(grp['total'])"/></tr>
                        </table>
                    </t>
                    <table class="sc-table" style="margin-top: 4px;">
                        <tr class="tr-tot" style="color: #1b7f1b;"><td>TOTAL INGRESOS</td><td class="num" style="width: 18%;" t-out="money(total_income)"/></tr>
                    </table>

                    <div class="tr-sec">GASTOS</div>
                    <t t-if="not expenses"><p class="text-muted">Sin gastos en el periodo.</p></t>
                    <table t-else="" class="sc-table">
                        <tr t-foreach="expenses" t-as="mv">
                            <td style="width: 12%;" t-out="mv['date'].strftime('%d/%m/%Y')"/>
                            <td t-out="mv['label']"/>
                            <td style="width: 18%;" t-out="mv['category']"/>
                            <td style="width: 14%;" t-out="mv['journal']"/>
                            <td style="width: 12%;" t-out="mv['who']"/>
                            <td class="num" style="width: 13%;" t-out="money(mv['amount'])"/>
                        </tr>
                        <tr class="tr-tot"><td colspan="5">TOTAL GASTOS</td><td class="num" t-out="money(total_expense)"/></tr>
                    </table>

                    <table class="sc-table" style="margin-top: 8px;">
                        <tr class="tr-tot">
                            <td>DISPONIBLE DEL PERIODO (ingresos − gastos)</td>
                            <td t-attf-class="num #{'neg' if available &lt; 0 else ''}" style="width: 18%;" t-out="money(available)"/>
                        </tr>
                        <tr class="tr-tot">
                            <td>SALDO TOTAL AL CIERRE (caja + bancos)</td>
                            <td class="num" t-out="money(closing_total)"/>
                        </tr>
                    </table>

                    <t t-if="transfers">
                        <div class="tr-sec">TRASPASOS ENTRE CUENTAS</div>
                        <table class="sc-table">
                            <tr t-foreach="transfers" t-as="mv">
                                <td style="width: 12%;" t-out="mv['date'].strftime('%d/%m/%Y')"/>
                                <td><t t-out="mv['journal']"/> → <t t-out="mv.get('dest', '')"/></td>
                                <td t-out="mv['label']"/>
                                <td class="num" style="width: 13%;" t-out="money(mv['amount'])"/>
                            </tr>
                        </table>
                    </t>

                    <t t-if="receivables or payables">
                        <div class="tr-sec">ADEUDOS PENDIENTES</div>
                        <table class="sc-row">
                            <tr>
                                <td style="width: 50%; vertical-align: top;">
                                    <b>Cuentas por cobrar</b>
                                    <table class="sc-table">
                                        <tr t-foreach="receivables" t-as="ob">
                                            <td t-out="ob['who']"/>
                                            <td t-out="ob['desc']"/>
                                            <td class="num" t-out="money(ob['amount'])"/>
                                        </tr>
                                        <tr class="tr-tot"><td colspan="2">Total por cobrar</td><td class="num" t-out="money(total_receivable)"/></tr>
                                    </table>
                                </td>
                                <td style="width: 50%; vertical-align: top;">
                                    <b>Cuentas por pagar</b>
                                    <table class="sc-table">
                                        <tr t-foreach="payables" t-as="ob">
                                            <td t-out="ob['who']"/>
                                            <td t-out="ob['desc']"/>
                                            <td class="num" t-out="money(ob['amount'])"/>
                                        </tr>
                                        <tr class="tr-tot"><td colspan="2">Total por pagar</td><td class="num" t-out="money(total_payable)"/></tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </t>

                    <t t-if="to_approve">
                        <div class="tr-sec">GASTOS PENDIENTES DE APROBACIÓN DEL JEFE DE GRUPO</div>
                        <table class="sc-table">
                            <tr t-foreach="to_approve" t-as="ob">
                                <td t-out="ob['who']"/>
                                <td t-out="ob['desc']"/>
                                <td class="num" style="width: 15%;" t-out="money(ob['amount'])"/>
                            </tr>
                        </table>
                    </t>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
