<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="scout_report_styles">
        <style>
            .sc-doc { font-family: Helvetica, Arial, sans-serif; color: #0f3049; font-size: 11px; }
            .sc-head { text-align: center; padding-bottom: 4px; margin-bottom: 0; }
            .sc-greca { margin: 2px 0 10px 0; line-height: 0; }
            .sc-greca img { width: 100%; display: block; }
            .sc-greca-foot { margin: 12px 0 0 0; }
            .sc-greca-tight { margin: 4px 0 4px 0; }
            .sc-head h1 { font-size: 24px; font-weight: 900; margin: 0; letter-spacing: 1px; }
            .sc-head h2 { font-size: 14px; font-weight: 800; margin: 4px 0 0 0; color: #f36f45; }
            .sc-head .sub { font-size: 10px; letter-spacing: 3px; }
            .sc-logo { max-height: 70px; }
            .sc-box { border: 1.5px solid #0f3049; border-radius: 8px; padding: 6px 10px 8px 10px; margin-bottom: 8px; page-break-inside: avoid; }
            .sc-title { font-weight: 800; font-size: 12px; margin-bottom: 4px; color: #0f3049; border-bottom: 1.5px solid #f36f45; padding-bottom: 2px; }
            .sc-num { display: inline-block; width: 18px; height: 18px; line-height: 18px; border-radius: 9px; background: #f36f45; color: #fff; text-align: center; margin-right: 6px; font-size: 11px; }
            .sc-row { width: 100%; border-collapse: collapse; }
            .sc-row td { padding: 3px 4px; vertical-align: bottom; }
            .sc-label { font-weight: 700; white-space: nowrap; }
            .sc-val { border-bottom: 1px solid #0f3049; min-width: 60px; }
            .sc-chk { display: inline-block; width: 11px; height: 11px; border: 1px solid #0f3049; text-align: center; line-height: 10px; font-size: 10px; font-weight: 800; margin-right: 3px; }
            .sc-opt { margin-right: 14px; white-space: nowrap; }
            .sc-consent li { margin-bottom: 3px; }
            .sc-sign { text-align: center; padding-top: 4px; }
            .sc-sign img { max-height: 55px; }
            .sc-sign .line { border-top: 1px solid #0f3049; margin-top: 2px; padding-top: 2px; font-weight: 700; }
            .sc-motto { text-align: center; font-weight: 800; margin-top: 6px; color: #f36f45; }
            .sc-table { width: 100%; border-collapse: collapse; }
            .sc-table th, .sc-table td { border: 1px solid #a9b6c2; padding: 2px 3px; }
            .sc-table th { background: #0f3049; color: #fff; }
        </style>
    </template>

    <template id="scout_greca">
        <!-- Greca de la pañoleta del grupo: naranja | blanca con greca negra | azul marino -->
        <div t-attf-class="sc-greca #{greca_class or ''}"><img src="data:image/svg+xml;base64,"/></div>
    </template>

    <template id="report_registration_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <t t-call="scout_management.scout_report_styles"/>
                    <t t-set="chk" t-value="lambda flag: 'X' if flag else ' '"/>
                    <div class="page sc-doc">
                        <table class="sc-row sc-head">
                            <tr>
                                <td style="width: 18%; text-align: left;">
                                    <img t-if="doc.company_id.logo" class="sc-logo" t-att-src="image_data_uri(doc.company_id.logo)"/>
                                </td>
                                <td>
                                    <h1 t-out="doc.company_id.name"/>
                                    <div class="sub" t-if="doc.company_id.report_header" t-out="doc.company_id.report_header"/>
                                    <h2>FICHA ÚNICA DE REGISTRO, CONSENTIMIENTO Y RESPONSIVA</h2>
                                    <div>CICLO SCOUT: <b t-out="doc.cycle_id.name"/> &#160;&#160;&#160; FOLIO: <b t-out="doc.name"/></div>
                                </td>
                                <td style="width: 18%; text-align: right;">
                                    <img t-if="doc.company_id.scout_emblem" class="sc-logo" t-att-src="image_data_uri(doc.company_id.scout_emblem)"/>
                                    <span t-else="" style="font-size: 52px;">⚜</span>
                                </td>
                            </tr>
                        </table>
                        <t t-call="scout_management.scout_greca"/>

                        <div class="sc-box">
                            <div class="sc-title"><span class="sc-num">1</span>DATOS DE REGISTRO</div>
                            <table class="sc-row">
                                <tr>
                                    <td class="sc-label">Nombres:</td><td class="sc-val" t-out="doc.first_name"/>
                                    <td class="sc-label">Apellido paterno:</td><td class="sc-val" t-out="doc.last_name"/>
                                    <td class="sc-label">Apellido materno:</td><td class="sc-val" t-out="doc.last_name2"/>
                                </tr>
                            </table>
                            <table class="sc-row">
                                <tr>
                                    <td class="sc-label">Fecha de nacimiento:</td>
                                    <td class="sc-val" t-out="doc.birthdate and doc.birthdate.strftime('%d / %m / %Y') or ''"/>
                                    <td class="sc-label">Edad:</td><td class="sc-val" t-out="doc.age or ''"/>
                                    <td class="sc-label">Sección / Jefatura (a cargo):</td><td class="sc-val" t-out="(doc.leadership_position_id.name or '') + ((' - ' + ', '.join(doc.leading_section_ids.mapped('name'))) if doc.leading_section_ids else '')"/>
                                </tr>
                            </table>
                            <div style="margin: 4px 0;">
                                <span class="sc-label">Sección: </span>
                                <t t-foreach="sections" t-as="section">
                                    <span class="sc-opt"><span class="sc-chk" t-out="chk(doc.section_id == section)"/><t t-out="section.name.upper()"/></span>
                                </t>
                            </div>
                            <table class="sc-row"><tr><td class="sc-label">Domicilio:</td><td class="sc-val" style="width: 100%;" t-out="doc.street"/></tr></table>
                        </div>

                        <div class="sc-box">
                            <div class="sc-title"><span class="sc-num">2</span>DATOS DEL PADRE, MADRE, TUTOR O PERSONA PARA AVISAR EN CASO DE ACCIDENTE</div>
                            <table class="sc-row">
                                <tr>
                                    <td class="sc-label">Nombre completo:</td><td class="sc-val" style="width: 60%;" t-out="doc.guardian_name"/>
                                    <td class="sc-label">Parentesco:</td><td class="sc-val" t-out="doc.guardian_relationship"/>
                                </tr>
                                <tr>
                                    <td class="sc-label">Teléfono principal (celular):</td><td class="sc-val" t-out="doc.guardian_phone"/>
                                    <td class="sc-label">Teléfono alterno:</td><td class="sc-val" t-out="doc.guardian_phone_alt"/>
                                </tr>
                                <tr>
                                    <td class="sc-label">Correo electrónico:</td><td class="sc-val" colspan="3" t-out="doc.guardian_email"/>
                                </tr>
                                <tr>
                                    <td class="sc-label">Domicilio (si es distinto):</td><td class="sc-val" colspan="3" t-out="doc.guardian_street"/>
                                </tr>
                            </table>
                        </div>

                        <div class="sc-box">
                            <div class="sc-title"><span class="sc-num">3</span>INFORMACIÓN MÉDICA</div>
                            <t t-if="can_see_medical">
                                <t t-set="med" t-value="doc.sudo()"/>
                                <table class="sc-row">
                                    <tr>
                                        <td style="width: 50%; vertical-align: top;">
                                            <div class="sc-label" style="text-align: center;">SERVICIO MÉDICO</div>
                                            <span class="sc-opt"><span class="sc-chk" t-out="chk(med.medical_service == 'imss')"/>IMSS</span>
                                            <span class="sc-opt"><span class="sc-chk" t-out="chk(med.medical_service == 'issste')"/>ISSSTE</span>
                                            <span class="sc-opt"><span class="sc-chk" t-out="chk(med.medical_service == 'private')"/>Seguro particular</span>
                                            <span class="sc-opt"><span class="sc-chk" t-out="chk(med.medical_service == 'none')"/>No tengo</span>
                                            <table class="sc-row">
                                                <tr><td class="sc-label">No. de afiliación o póliza:</td><td class="sc-val" t-out="med.medical_policy"/></tr>
                                                <tr><td class="sc-label">Tipo de sangre:</td><td class="sc-val"><span t-field="med.blood_type"/></td></tr>
                                            </table>
                                        </td>
                                        <td style="width: 50%; vertical-align: top;">
                                            <div class="sc-label" style="text-align: center;">CONDICIONES MÉDICAS RELEVANTES</div>
                                            <div style="font-size: 9px; text-align: center;">(alergias, asma, medicamentos permanentes, hospitalización, cirugía, diabetes, hipertensión, patología, restricciones físicas u otras)</div>
                                            <div class="sc-val" style="min-height: 40px; white-space: pre-line;" t-out="med.medical_conditions"/>
                                        </td>
                                    </tr>
                                </table>
                            </t>
                            <div t-else="" class="text-muted">Información confidencial: visible solo para jefatura y dirigentes.</div>
                        </div>

                        <div class="sc-box">
                            <div class="sc-title"><span class="sc-num">4</span>PAGOS DE REGISTRO</div>
                            <div>¿Pagó su registro?
                                <span class="sc-opt"><span class="sc-chk" t-out="chk(doc.declared_paid)"/>SI</span>
                                <span class="sc-opt"><span class="sc-chk" t-out="chk(not doc.declared_paid)"/>NO</span>
                            </div>
                            <table class="sc-row">
                                <tr>
                                    <td class="sc-label">Nro. de transferencia:</td><td class="sc-val" t-out="doc.payment_reference"/>
                                    <td class="sc-label">Fecha:</td><td class="sc-val" t-out="doc.payment_date and doc.payment_date.strftime('%d / %m / %Y') or ''"/>
                                    <td class="sc-label">Monto:</td>
                                    <td class="sc-val"><span t-if="doc.payment_amount" t-field="doc.payment_amount"/></td>
                                </tr>
                            </table>
                        </div>

                        <div class="sc-box">
                            <div class="sc-title"><span class="sc-num">5</span>CONSENTIMIENTO, AUTORIZACIONES Y RESPONSIVA</div>
                            <ul class="sc-consent" style="list-style: none; padding-left: 0; margin-bottom: 4px;">
                                <li><span class="sc-chk" t-out="chk(doc.consent_participation)"/>Autorizo la participación de mi hijo(a) en reuniones, campamentos, excursiones, actividades de servicio y demás actividades propias del programa educativo de <t t-out="doc.company_id.name"/>.</li>
                                <li><span class="sc-chk" t-out="chk(doc.consent_first_aid)"/>Autorizo la aplicación de primeros auxilios y, en caso necesario, su traslado a un centro médico cuando la situación lo requiera y no sea posible localizarme oportunamente.</li>
                                <li><span class="sc-chk" t-out="chk(doc.consent_image)"/>Autorizo de manera expresa el uso de fotografías, videos, grabaciones de voz y demás material audiovisual en los que aparezca mi hijo(a) para fines educativos, institucionales, históricos y de difusión del escultismo, sin fines de lucro y de acuerdo con los principios y valores del Movimiento Scout.</li>
                                <li><span class="sc-chk" t-out="chk(doc.consent_data)"/>Autorizo el tratamiento de los datos personales proporcionados exclusivamente para fines administrativos, operativos, de seguridad y comunicación interna del Grupo, conforme al aviso de privacidad correspondiente.</li>
                                <li><span class="sc-chk" t-out="chk(doc.consent_risk)"/>Reconozco que las actividades scouts se desarrollan principalmente al aire libre y pueden implicar riesgos inherentes propios de su naturaleza. El Grupo, sus dirigentes y voluntarios se comprometen a actuar con medidas razonables de seguridad; por lo que libero de responsabilidad al grupo y a sus colaboradores respecto de accidentes o lesiones derivados de riesgos propios de la actividad.</li>
                                <li><span class="sc-chk" t-out="chk(doc.consent_update)"/>Me comprometo a mantener actualizada la información proporcionada y a informar cualquier cambio en datos personales, médicos o de contacto.</li>
                            </ul>
                            <div style="text-align: center; font-weight: 700; font-size: 10px;">
                                CON MI FIRMA DECLARO HABER LEÍDO, COMPRENDIDO Y ACEPTADO ÍNTEGRAMENTE LA PRESENTE FICHA DE REGISTRO,
                                SUS AUTORIZACIONES, CONDICIONES DE PARTICIPACIÓN Y REGLAMENTOS APLICABLES DE <t t-out="(doc.company_id.name or '').upper()"/>.
                            </div>
                            <table class="sc-row" style="margin-top: 6px;">
                                <tr>
                                    <td class="sc-sign" style="width: 33%;">
                                        <img t-if="doc.guardian_signature" t-att-src="image_data_uri(doc.guardian_signature)"/>
                                        <div t-else="" style="height: 55px;"/>
                                        <div t-out="doc.guardian_signed_by"/>
                                        <div class="line">PADRE, MADRE O TUTOR<br/><span style="font-weight: 400;">Nombre y firma</span></div>
                                    </td>
                                    <td class="sc-sign" style="width: 33%;">
                                        <img t-if="doc.member_signature" t-att-src="image_data_uri(doc.member_signature)"/>
                                        <div t-else="" style="height: 55px;"/>
                                        <div t-out="doc.member_signed_by"/>
                                        <div class="line">ASPIRANTE<br/><span style="font-weight: 400;">Nombre y firma (cuando aplique)</span></div>
                                    </td>
                                    <td class="sc-sign" style="width: 33%;">
                                        <img t-if="doc.leader_signature" t-att-src="image_data_uri(doc.leader_signature)"/>
                                        <div t-else="" style="height: 55px;"/>
                                        <div t-out="doc.leader_user_id.name"/>
                                        <div class="line">DIRIGENTE QUE RECIBE<br/><span style="font-weight: 400;">Nombre y firma</span></div>
                                    </td>
                                </tr>
                            </table>
                            <div style="text-align: center; margin-top: 4px;">Fecha:
                                <b t-out="doc.signed_date and doc.signed_date.strftime('%d / %m / %Y') or '_____ / _____ / _______'"/>
                            </div>
                        </div>
                        <t t-call="scout_management.scout_greca"><t t-set="greca_class" t-value="'sc-greca-foot'"/></t><div class="sc-motto">⚜ SIEMPRE LISTOS PARA SERVIR ⚜</div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
