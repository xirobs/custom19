    <record id="action_scout_mercado_pago" model="ir.actions.act_window">
        <field name="name">Pago en línea (Mercado Pago)</field>
        <field name="res_model">payment.provider</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="payment.payment_provider_mercado_pago"/>
    </record>
</odoo>
