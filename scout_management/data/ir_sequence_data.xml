<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_scout_registration" model="ir.sequence">
        <field name="name">Ficha de registro scout</field>
        <field name="code">scout.registration</field>
        <field name="prefix">FR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_scout_treasury_move" model="ir.sequence">
        <field name="name">Movimiento de tesorería scout</field>
        <field name="code">scout.treasury.move</field>
        <field name="prefix">MOV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_scout_meeting" model="ir.sequence">
        <field name="name">Acta scout</field>
        <field name="code">scout.meeting</field>
        <field name="prefix">ACTA/%(year)s/</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_scout_store_sale" model="ir.sequence">
        <field name="name">Venta scout</field>
        <field name="code">scout.store.sale</field>
        <field name="prefix">TS/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
