<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Categorías de especialidades (desplegables del portal de dirigentes) -->
    <record id="stage_cat_deportes" model="scout.progression.category"><field name="name">Deportes</field><field name="sequence">10</field><field name="color">#f2c200</field></record>
    <record id="stage_cat_expresion" model="scout.progression.category"><field name="name">Expresión y comunicación</field><field name="sequence">20</field><field name="color">#e5007e</field></record>
    <record id="stage_cat_seguridad" model="scout.progression.category"><field name="name">Seguridad y rescate</field><field name="sequence">30</field><field name="color">#d7262f</field></record>
    <record id="stage_cat_tecnologia" model="scout.progression.category"><field name="name">Tecnología y ciencia</field><field name="sequence">40</field><field name="color">#1f6fb5</field></record>
    <record id="stage_cat_ecologia" model="scout.progression.category"><field name="name">Ecología</field><field name="sequence">50</field><field name="color">#2e9e44</field></record>
    <record id="stage_cat_humanidades" model="scout.progression.category"><field name="name">Humanidades</field><field name="sequence">60</field><field name="color">#7b3f98</field></record>
    <record id="stage_cat_correas" model="scout.progression.category"><field name="name">Correas</field><field name="sequence">70</field><field name="color">#8a5a2b</field></record>
    <record id="stage_cat_tecnicas" model="scout.progression.category"><field name="name">Técnicas de Tropa</field><field name="sequence">80</field><field name="color">#0f3049</field></record>
    <record id="stage_cat_rover" model="scout.progression.category"><field name="name">Especialidades Rover</field><field name="sequence">90</field><field name="color">#b8202f</field></record>
    <record id="stage_cat_otras" model="scout.progression.category"><field name="name">Otras</field><field name="sequence">99</field></record>

    <!-- Tropa: correas e insignia terminal -->
    <record id="stage_tropa_correa_manigua" model="scout.progression.stage">
        <field name="name">Correa Manigua</field>
        <field name="stage_type">specialty</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="stage_cat_correas"/>
        <field name="section_ids" eval="[Command.link(ref('section_tropa_atlas')), Command.link(ref('section_tropa_hydra'))]"/>
        <field name="description">Correa de Tropa. Escribe aquí los requisitos que usa la jefatura de Tropa.</field>
    </record>
    <record id="stage_tropa_correa_aventura" model="scout.progression.stage">
        <field name="name">Correa de la Aventura</field>
        <field name="stage_type">specialty</field>
        <field name="sequence">61</field>
        <field name="category_id" ref="stage_cat_correas"/>
        <field name="section_ids" eval="[Command.link(ref('section_tropa_atlas')), Command.link(ref('section_tropa_hydra'))]"/>
        <field name="description">Correa de Tropa. Escribe aquí los requisitos que usa la jefatura de Tropa.</field>
    </record>
    <record id="stage_tropa_aves_fenix" model="scout.progression.stage">
        <field name="name">Insignia terminal Aves Fénix</field>
        <field name="stage_type">terminal</field>
        <field name="sequence">90</field>
        <field name="section_ids" eval="[Command.link(ref('section_tropa_atlas')), Command.link(ref('section_tropa_hydra'))]"/>
        <field name="description">Insignia terminal de Tropa (después de Primera clase).</field>
    </record>

    <!-- Ruta de enlace (paso a la siguiente sección) -->
    <record id="stage_link_castores" model="scout.progression.stage">
        <field name="name">Ruta de enlace a la Manada</field>
        <field name="stage_type">link</field>
        <field name="sequence">80</field>
        <field name="section_ids" eval="[Command.link(ref('section_castores'))]"/>
        <field name="description">Últimos meses en la Colonia: visitas a la Manada y despedida. Al terminar, el jefe de grupo aprueba el cambio de sección.</field>
    </record>
    <record id="stage_link_manadas" model="scout.progression.stage">
        <field name="name">Ruta de enlace a la Tropa</field>
        <field name="stage_type">link</field>
        <field name="sequence">80</field>
        <field name="section_ids" eval="[Command.link(ref('section_lobatos')), Command.link(ref('section_gacelas'))]"/>
        <field name="description">Últimos meses en la Manada: visitas a la Tropa, conoce su patrulla y despedida de la Manada. Al terminar, el jefe de grupo aprueba el cambio de sección.</field>
    </record>
    <record id="stage_link_tropas" model="scout.progression.stage">
        <field name="name">Ruta de enlace al Clan</field>
        <field name="stage_type">link</field>
        <field name="sequence">80</field>
        <field name="section_ids" eval="[Command.link(ref('section_tropa_atlas')), Command.link(ref('section_tropa_hydra'))]"/>
        <field name="description">Requiere Primera clase. Visitas al Clan y despedida de la Tropa. Al terminar, el jefe de grupo aprueba el cambio de sección.</field>
    </record>
</odoo>
