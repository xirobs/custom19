<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Revisa los turnos de palabra en curso (avisos en el chat, aviso emergente y orden de silenciar).
         Los participantes también avisan al segundo; esta acción es el respaldo si nadie tiene la pantalla abierta. -->
    <record id="ir_cron_scout_call_turns" model="ir.cron">
        <field name="name">Scouts: turnos de palabra en videollamadas</field>
        <field name="model_id" ref="mail.model_discuss_channel"/>
        <field name="state">code</field>
        <field name="code">model._cron_scout_turns()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
