<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_scouts" model="ir.module.category">
        <field name="name">Grupo Scout</field>
        <field name="sequence">60</field>
    </record>

    <record id="privilege_scout" model="res.groups.privilege">
        <field name="name">Grupo Scout</field>
        <field name="category_id" ref="module_category_scouts"/>
        <field name="sequence">10</field>
    </record>
    <record id="privilege_scout_treasury" model="res.groups.privilege">
        <field name="name">Tesorería scout</field>
        <field name="category_id" ref="module_category_scouts"/>
        <field name="sequence">20</field>
    </record>

    <!-- Jefe de sección: solo sus secciones -->
    <record id="group_scout_leader" model="res.groups">
        <field name="name">Jefe de sección</field>
        <field name="sequence">10</field>
        <field name="comment">Ve y trabaja solo su sección: miembros (con ficha médica), calendario, asistencia, adelantos, informe trimestral y chat con las familias.</field>
        <field name="privilege_id" ref="privilege_scout"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('base.group_partner_manager'))]"/>
    </record>

    <!-- Secretaría (mesa directiva): acceso total con aprobaciones del jefe -->
    <record id="group_scout_officer" model="res.groups">
        <field name="name">Secretaría (acceso total con aprobación)</field>
        <field name="sequence">20</field>
        <field name="comment">Ve y edita todas las secciones, fichas, actas y calendario. Fichas, actas, bajas y cambios de sección requieren aprobación del jefe de grupo. Consulta la contabilidad.</field>
        <field name="privilege_id" ref="privilege_scout"/>
        <field name="implied_ids" eval="[Command.link(ref('group_scout_leader')), Command.link(ref('account.group_account_readonly'))]"/>
    </record>

    <!-- Tesorería: acceso total + contabilidad, gastos con aprobación del jefe -->
    <record id="group_scout_treasurer" model="res.groups">
        <field name="name">Tesorero (acceso total con aprobación)</field>
        <field name="sequence">10</field>
        <field name="comment">Todo lo de secretaría más ingresos, egresos, cargos, facturas de proveedor y pagos. Gastos y pagos requieren aprobación del jefe de grupo.</field>
        <field name="privilege_id" ref="privilege_scout_treasury"/>
        <field name="implied_ids" eval="[Command.link(ref('group_scout_officer')), Command.link(ref('account.group_account_invoice'))]"/>
    </record>

    <!-- Jefe de grupo: acceso total y aprobaciones -->
    <record id="group_scout_manager" model="res.groups">
        <field name="name">Jefe de grupo</field>
        <field name="sequence">30</field>
        <field name="comment">Acceso total. Aprueba gastos y pagos, actas, fichas de registro, bajas y cambios de sección.</field>
        <field name="privilege_id" ref="privilege_scout"/>
        <field name="implied_ids" eval="[Command.link(ref('group_scout_officer')), Command.link(ref('group_scout_treasurer'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <!-- ===================== Jefe de sección: solo su sección ===================== -->
    <record id="rule_partner_scout_leader" model="ir.rule">
        <field name="name">Contactos: jefe de sección ve solo miembros de su sección</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">['|', '|', '|', ('is_scout', '=', False), ('scout_type', '=', 'leader'), ('id', '=', user.partner_id.id), ('scout_section_id.leader_ids', 'in', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_scout_leader'))]"/>
    </record>
    <record id="rule_partner_scout_officer" model="ir.rule">
        <field name="name">Contactos: mesa directiva ve todos</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_scout_officer'))]"/>
    </record>

    <record id="rule_registration_leader" model="ir.rule">
        <field name="name">Fichas: jefe de sección</field>
        <field name="model_id" ref="model_scout_registration"/>
        <field name="domain_force">['|', '|', ('section_id.leader_ids', 'in', user.id), ('section_id', '=', False), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_scout_leader'))]"/>
    </record>
    <record id="rule_registration_officer" model="ir.rule">
        <field name="name">Fichas: mesa directiva</field>
        <field name="model_id" ref="model_scout_registration"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_scout_officer'))]"/>
    </record>

    <record id="rule_attendance_leader" model="ir.rule">
        <field name="name">Asistencia: jefe de sección</field>
        <field name="model_id" ref="model_scout_attendance_line"/>
        <field name="domain_force">['|', ('section_id.leader_ids', 'in', user.id), ('member_id.scout_section_id.leader_ids', 'in', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_scout_leader'))]"/>
    </record>
    <record id="rule_attendance_officer" model="ir.rule">
        <field name="name">Asistencia: mesa directiva</field>
        <field name="model_id" ref="model_scout_attendance_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_scout_officer'))]"/>
    </record>

    <record id="rule_progress_leader" model="ir.rule">
        <field name="name">Adelantos: jefe de sección</field>
        <field name="model_id" ref="model_scout_member_progress"/>
        <field name="domain_force">[('member_id.scout_section_id.leader_ids', 'in', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_scout_leader'))]"/>
    </record>
    <record id="rule_progress_officer" model="ir.rule">
        <field name="name">Adelantos: mesa directiva</field>
        <field name="model_id" ref="model_scout_member_progress"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_scout_officer'))]"/>
    </record>

    <record id="rule_section_report_leader" model="ir.rule">
        <field name="name">Informe trimestral: jefe de sección</field>
        <field name="model_id" ref="model_scout_section_report"/>
        <field name="domain_force">[('section_id.leader_ids', 'in', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_scout_leader'))]"/>
    </record>
    <record id="rule_section_report_officer" model="ir.rule">
        <field name="name">Informe trimestral: mesa directiva</field>
        <field name="model_id" ref="model_scout_section_report"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_scout_officer'))]"/>
    </record>

    <record id="rule_member_change_leader" model="ir.rule">
        <field name="name">Solicitudes de cambio: jefe de sección</field>
        <field name="model_id" ref="model_scout_member_change"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('member_id.scout_section_id.leader_ids', 'in', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_scout_leader'))]"/>
    </record>
    <record id="rule_member_change_officer" model="ir.rule">
        <field name="name">Solicitudes de cambio: mesa directiva</field>
        <field name="model_id" ref="model_scout_member_change"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_scout_officer'))]"/>
    </record>

    <record id="rule_family_conversation_leader" model="ir.rule">
        <field name="name">Chat con familias: jefe de sección</field>
        <field name="model_id" ref="model_scout_family_conversation"/>
        <field name="domain_force">[('member_id.scout_section_id.leader_ids', 'in', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_scout_leader'))]"/>
    </record>
    <record id="rule_family_conversation_officer" model="ir.rule">
        <field name="name">Chat con familias: mesa directiva</field>
        <field name="model_id" ref="model_scout_family_conversation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_scout_officer'))]"/>
    </record>

    <!-- Cargos (CxC) por miembro: el jefe de sección consulta los de su sección -->
    <record id="rule_account_move_scout_leader" model="ir.rule">
        <field name="name">Cargos scout: jefe de sección (solo lectura de su sección)</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[('scout_member_id.scout_section_id.leader_ids', 'in', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_scout_leader'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_account_move_scout_officer" model="ir.rule">
        <field name="name">Cargos scout: mesa directiva ve todo</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_scout_officer'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
