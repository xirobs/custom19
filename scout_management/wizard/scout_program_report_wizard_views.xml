<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_scout_program_report_wizard_form" model="ir.ui.view">
        <field name="name">scout.program.report.wizard.form</field>
        <field name="model">scout.program.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">Imprime el programa trimestral de la sección con lo registrado en el calendario: fecha, horario, temática, actividad, lugar, responsable, objetivo y reconocimientos.</p>
                <group>
                    <field name="section_id"/>
                    <label for="date_from" string="Periodo"/>
                    <div class="o_row"><field name="date_from"/> al <field name="date_to"/></div>
                    <field name="theme"/>
                    <field name="include_group_events"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Imprimir PDF" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_scout_program_report_wizard" model="ir.actions.act_window">
        <field name="name">Imprimir programa trimestral</field>
        <field name="res_model">scout.program.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
