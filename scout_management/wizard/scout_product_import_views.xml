<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_scout_product_import_form" model="ir.ui.view">
        <field name="name">scout.product.import.form</field>
        <field name="model">scout.product.import</field>
        <field name="arch" type="xml">
            <form>
                <field name="state" invisible="1"/>
                <div class="alert alert-info" role="alert" invisible="state == 'done'">
                    <b>1.</b> Plantilla: <field name="template_file" filename="template_name" readonly="1" nolabel="1" class="oe_inline"/>
                    <field name="template_name" invisible="1"/>
                    — columnas <b>Producto</b>, <b>Existencia</b> y <b>Precio de venta</b>.
                    <br/><b>2.</b> Sube el archivo, presiona <b>Revisar</b> (no guarda nada) y luego <b>Importar</b>.
                    <br/>Si el producto ya existe se actualiza su precio y su existencia queda igual a la del archivo; no se duplica.
                </div>
                <group invisible="state == 'done'">
                    <field name="file" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                    <field name="inventory_date"/>
                </group>
                <group invisible="state == 'draft'">
                    <field name="created_count" string="Nuevos"/>
                    <field name="updated_count" string="Actualizados"/>
                    <field name="error_count" string="Con error"/>
                </group>
                <field name="result" invisible="not result" nolabel="1" class="font-monospace"/>
                <footer>
                    <button name="action_check" type="object" string="Revisar" class="btn-secondary" invisible="state == 'done'"/>
                    <button name="action_import" type="object" string="Importar" class="btn-primary" invisible="state == 'done'"
                            confirm="Se crearán o actualizarán los productos y sus existencias. ¿Continuar?"/>
                    <button name="action_view_products" type="object" string="Ver productos" class="btn-primary" invisible="state != 'done'"/>
                    <button special="cancel" string="Cerrar"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_scout_product_import" model="ir.actions.act_window">
        <field name="name">Carga de productos desde Excel</field>
        <field name="res_model">scout.product.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
