<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_scout_treasury_report_wizard_form" model="ir.ui.view">
        <field name="name">scout.treasury.report.wizard.form</field>
        <field name="model">scout.treasury.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">Informe de tesorería en formato infografía (para padres, tutores y jefes), tomado de Contabilidad: ingresos por rubro, egresos, saldos de caja y bancos, deudas, cobros pendientes y saldo proyectado. Opcionalmente agrega el detalle de cada movimiento.</p>
                <group>
                    <label for="date_from" string="Periodo"/>
                    <div class="o_row">
                        <field name="date_from"/> al <field name="date_to"/>
                    </div>
                    <field name="audience"/>
                    <field name="include_pending"/>
                    <field name="include_detail"/>
                    <field name="trend_months"/>
                    <field name="notes" placeholder="Ej. Se entregan playeras de grupo por registro."/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Imprimir PDF" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_scout_treasury_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte de ingresos y egresos</field>
        <field name="res_model">scout.treasury.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
