<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_scout_attendance_report_wizard_form" model="ir.ui.view">
        <field name="name">scout.attendance.report.wizard.form</field>
        <field name="model">scout.attendance.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">Genera la lista de asistencia del periodo por sección, con cantidad y porcentaje por miembro, igual que el formato del grupo.</p>
                <group>
                    <field name="section_ids" widget="many2many_tags"/>
                    <label for="date_from" string="Periodo"/>
                    <div class="o_row">
                        <field name="date_from"/> al <field name="date_to"/>
                    </div>
                    <field name="include_inactive"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Imprimir PDF" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_scout_attendance_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte de asistencia</field>
        <field name="res_model">scout.attendance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
