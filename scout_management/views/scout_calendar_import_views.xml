<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_scout_calendar_import_wizard" model="ir.ui.view">
        <field name="name">scout.calendar.import.wizard.form</field>
        <field name="model">scout.calendar.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="state" invisible="1"/>
                <div invisible="state != 'upload'">
                    <p class="text-muted">Sube el calendario trimestral del grupo: PDF en cuadrícula, Excel con columnas
                        Fecha, Fin, Actividad, Tipo y Notas, o una foto (la foto la lee la IA configurada en Datos del grupo).
                        Primero verás lo que se encontró.</p>
                    <group><field name="file" filename="filename"/><field name="filename" invisible="1"/></group>
                </div>
                <div invisible="state != 'review'">
                    <field name="line_ids">
                        <list editable="bottom" create="false" decoration-muted="existing" decoration-warning="tentative">
                            <field name="selected" widget="boolean_toggle"/>
                            <field name="date"/>
                            <field name="date_end"/>
                            <field name="name"/>
                            <field name="activity_type"/>
                            <field name="tentative"/>
                            <field name="notes" optional="show"/>
                            <field name="existing"/>
                        </list>
                    </field>
                    <field name="notes" invisible="not notes" class="text-muted"/>
                </div>
                <footer>
                    <button name="action_read" type="object" string="Leer el calendario" class="btn-primary" invisible="state != 'upload'"/>
                    <button name="action_import" type="object" string="Agregar al calendario" class="btn-primary" invisible="state != 'review'"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_scout_calendar_import_wizard" model="ir.actions.act_window">
        <field name="name">Subir calendario del grupo</field>
        <field name="res_model">scout.calendar.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_scout_calendar_import" name="Subir calendario del grupo (PDF / Excel)" parent="menu_scout_program_root"
              action="action_scout_calendar_import_wizard" sequence="9" groups="group_scout_officer"/>
</odoo>
