<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ Formulario de contacto: pestaña Scout ============ -->
    <record id="view_partner_form_scout" model="ir.ui.view">
        <field name="name">res.partner.form.scout</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_scout_view_attendance" type="object" class="oe_stat_button" icon="fa-check-square-o"
                        invisible="not is_scout" groups="scout_management.group_scout_leader">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="scout_attendance_pct" widget="float" digits="[3,0]" nolabel="1"/> %</span>
                        <span class="o_stat_text">Asistencia</span>
                    </div>
                </button>
                <button name="action_scout_view_invoices" type="object" class="oe_stat_button" icon="fa-money"
                        invisible="not is_scout" groups="scout_management.group_scout_leader">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="scout_amount_due" widget="monetary" options="{'currency_field': 'scout_currency_id'}" nolabel="1"/></span>
                        <span class="o_stat_text">Adeudo</span>
                    </div>
                </button>
                <button name="action_scout_open_conversation" type="object" class="oe_stat_button" icon="fa-comments"
                        string="Chat familia" invisible="not is_scout or scout_type != 'youth'"
                        groups="scout_management.group_scout_leader"/>
            </div>
            <xpath expr="//field[@name='company_type']" position="after">
                <div groups="scout_management.group_scout_leader" class="d-flex gap-2 align-items-center">
                    <field name="is_scout" widget="boolean_toggle" nolabel="1"/>
                    <label for="is_scout" string="Miembro del grupo scout"/>
                    <field name="scout_state" widget="badge" invisible="not is_scout" nolabel="1"
                           decoration-success="scout_state == 'active'" decoration-info="scout_state == 'trial'"
                           decoration-muted="scout_state == 'inactive'"/>
                    <span invisible="not scout_next_section_due" class="badge text-bg-warning">Próximo a pasar</span>
                    <field name="scout_next_section_due" invisible="1"/>
                    <span invisible="not scout_needs_registration" class="badge text-bg-danger">Debe registrarse</span>
                    <field name="scout_needs_registration" invisible="1"/>
                </div>
                <div groups="scout_management.group_scout_leader" invisible="not is_scout">
                    <div class="alert alert-warning py-1 mb-1" role="alert" invisible="not scout_age_alert">
                        <i class="fa fa-birthday-cake"/> <field name="scout_age_alert_text" class="oe_inline"/>
                        <field name="scout_age_alert" invisible="1"/>
                    </div>
                    <div class="alert alert-danger py-1 mb-1" role="alert" invisible="not scout_needs_registration">
                        <i class="fa fa-id-card-o"/> Nuevo ingreso con <field name="scout_trial_attendance" class="oe_inline"/> asistencias sin registro pagado: ya debe registrarse.
                    </div>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Scout" name="scout" invisible="not is_scout" groups="scout_management.group_scout_leader">
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <button name="action_scout_activate" type="object" string="Activar" class="btn-primary"
                                invisible="scout_state != 'trial'" groups="scout_management.group_scout_manager"/>
                        <button name="action_scout_new_registration" type="object" string="Nueva ficha de registro" class="btn-secondary"/>
                        <button name="action_scout_request_section_change" type="object" string="Solicitar cambio de sección" class="btn-secondary"
                                invisible="scout_state == 'inactive'"/>
                        <button name="action_scout_request_leave" type="object" string="Solicitar baja" class="btn-secondary"
                                invisible="scout_state == 'inactive'"/>
                        <button name="%(scout_management.action_report_member)d" type="action" string="Imprimir expediente" class="btn-secondary"/>
                        <button name="action_scout_print_card" type="object" string="Credencial" icon="fa-id-badge" class="btn-secondary"/>
                    </div>
                    <div class="alert alert-light border py-2 mb-2" role="status" invisible="not scout_route_id">
                        <b>Tiempo restante en la sección:</b> <field name="scout_time_left" class="oe_inline"/> ·
                        <b>Estado:</b> <field name="scout_route_state" class="oe_inline"/> ·
                        <b>Próximo destino:</b> <field name="scout_route_destination_id" class="oe_inline"/>
                        <field name="scout_route_id" invisible="1"/><field name="scout_route_alert" invisible="1"/>
                    </div>
                    <group>
                        <group string="Datos personales">
                            <field name="scout_first_name"/>
                            <field name="scout_last_name"/>
                            <field name="scout_last_name2"/>
                            <field name="scout_name"/>
                            <field name="scout_birthdate"/>
                            <field name="scout_age"/>
                            <field name="scout_gender"/>
                            <field name="scout_shirt_size"/>
                        </group>
                        <group string="En el grupo">
                            <field name="scout_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="scout_section_id"/>
                            <field name="scout_patrol_id" invisible="not scout_section_id"
                                   context="{'default_section_id': scout_section_id}"/>
                            <field name="scout_position_id" options="{'no_create': True}"/>
                            <field name="scout_leading_section_ids" widget="many2many_tags"
                                   invisible="scout_type != 'leader'"/>
                            <button name="action_scout_grant_leader_portal" type="object" colspan="2"
                                    string="Acceso al portal de dirigentes (celular)" icon="fa-mobile"
                                    class="btn-link ps-0" invisible="scout_type != 'leader'"
                                    groups="scout_management.group_scout_officer"
                                    help="Crea su usuario de portal (sin costo) y te da la liga, el QR y la opción de asignarle contraseña. Verá solo sus secciones."/>
                            <field name="scout_join_date"/>
                            <field name="scout_leave_date" invisible="scout_state != 'inactive'"/>
                        </group>
                    </group>
                    <separator string="Padres, tutor y contactos de emergencia"/>
                    <group>
                        <group string="Padre, madre o tutor (principal)">
                            <field name="scout_guardian_id" context="{'default_street': street, 'default_street2': street2, 'default_city': city, 'default_zip': zip}"/>
                            <field name="scout_guardian_relationship"/>
                            <field name="scout_guardian_phone" widget="phone" readonly="not scout_guardian_id"/>
                            <field name="scout_guardian_email" widget="email" readonly="not scout_guardian_id"/>
                            <field name="scout_guardian_phone_alt" widget="phone"/>
                            <field name="scout_guardian_same_address"/>
                            <field name="scout_guardian_street" invisible="scout_guardian_same_address or not scout_guardian_id"/>
                            <field name="scout_guardian_street2" invisible="scout_guardian_same_address or not scout_guardian_id"/>
                            <field name="scout_guardian_city" invisible="scout_guardian_same_address or not scout_guardian_id"/>
                            <field name="scout_guardian_zip" invisible="scout_guardian_same_address or not scout_guardian_id"/>
                        </group>
                        <group string="Segundo padre / madre">
                            <field name="scout_guardian2_id"/>
                            <field name="scout_guardian2_relationship"/>
                        </group>
                    </group>
                    <field name="scout_emergency_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="relationship"/>
                            <field name="phone" widget="phone"/>
                            <field name="phone_alt" widget="phone"/>
                            <field name="note"/>
                        </list>
                    </field>
                    <separator string="Observaciones"/>
                    <field name="scout_notes" placeholder="Ej. A partir de octubre está en Gacelas; en julio comenzó ruta de enlace."/>
                </page>
                <page string="Ficha médica" name="scout_medical" invisible="not is_scout" groups="scout_management.group_scout_leader">
                    <group>
                        <group>
                            <field name="scout_medical_service" widget="radio"/>
                            <field name="scout_medical_policy"/>
                            <field name="scout_blood_type"/>
                            <field name="scout_doctor"/>
                        </group>
                        <group>
                            <field name="scout_allergies" placeholder="Ej. miel, abejas, penicilina…"/>
                            <field name="scout_medications"/>
                            <field name="scout_medical_conditions"/>
                        </group>
                    </group>
                </page>
                <page string="Adelantos y recorridos" name="scout_progress" invisible="not is_scout" groups="scout_management.group_scout_leader">
                    <group>
                        <group string="Promesa y último adelanto">
                            <field name="scout_promise_date"/>
                            <field name="scout_last_progress_stage_id" options="{'no_create': True}"
                                   domain="[('stage_type', '!=', 'promise'), '|', ('section_ids', '=', False), ('section_ids', 'in', [scout_section_id])]"/>
                            <field name="scout_last_progress_date"/>
                        </group>
                        <group string="Recorrido">
                            <field name="scout_transition_date"/>
                            <field name="scout_next_section_due" string="Próximo a pasar"/>
                        </group>
                    </group>
                    <separator string="Historial de adelantos, insignias y especialidades"/>
                    <field name="scout_progress_ids" context="{'default_member_id': id}">
                        <list editable="bottom" decoration-success="state == 'achieved'">
                            <field name="stage_id" domain="['|', ('section_ids', '=', False), ('section_ids', 'in', [parent.scout_section_id])]"/>
                            <field name="stage_type" optional="show"/>
                            <field name="state"/>
                            <field name="date_start" optional="hide"/>
                            <field name="date_achieved"/>
                            <field name="leader_id"/>
                            <field name="note"/>
                        </list>
                    </field>
                </page>
                <page string="Rutas de enlace" name="scout_routes" invisible="not is_scout or scout_type != 'youth'" groups="scout_management.group_scout_leader">
                    <field name="scout_route_ids" readonly="1">
                        <list decoration-danger="alert == 'red'" decoration-warning="alert == 'yellow'" decoration-muted="not is_open">
                            <field name="section_id"/>
                            <field name="destination_id"/>
                            <field name="date_route_official"/>
                            <field name="date_route_real"/>
                            <field name="date_pass_official"/>
                            <field name="date_pass_real"/>
                            <field name="time_left"/>
                            <field name="state" widget="badge"/>
                            <field name="alert" column_invisible="True"/>
                            <field name="is_open" column_invisible="True"/>
                        </list>
                    </field>
                </page>
                <page string="Fichas de registro" name="scout_registration" invisible="not is_scout" groups="scout_management.group_scout_leader">
                    <field name="scout_current_registration_id" invisible="1"/>
                    <field name="scout_currency_id" invisible="1"/>
                    <div class="text-muted small mb-1">
                        Las fichas se crean al capturar la ficha (botón "Nueva ficha de registro" o menú Fichas de registro),
                        cuando el padre la envía desde el portal o con la carga masiva. Aquí puedes agregar fichas
                        anteriores al sistema indicando su pago histórico.
                    </div>
                    <field name="scout_registration_ids"
                           context="{'default_member_id': id, 'default_first_name': scout_first_name or name,
                                     'default_last_name': scout_last_name, 'default_last_name2': scout_last_name2,
                                     'default_birthdate': scout_birthdate, 'default_section_id': scout_section_id}">
                        <list editable="bottom" decoration-muted="state == 'cancel'">
                            <field name="name" string="Folio" readonly="1"/>
                            <field name="cycle_id"/>
                            <field name="signed_date" string="Fecha"/>
                            <field name="state" readonly="1" widget="badge" decoration-success="state == 'validated'"
                                   decoration-info="state in ('submitted', 'reviewed')"/>
                            <field name="manual_payment_state" optional="show"/>
                            <field name="payment_state" widget="badge" decoration-success="payment_state in ('paid', 'exempt')"
                                   decoration-warning="payment_state == 'partial'" decoration-danger="payment_state == 'not_paid'"/>
                            <field name="first_name" column_invisible="True"/>
                            <field name="invoice_id" column_invisible="True"/>
                        </list>
                    </field>
                </page>
                <page string="Cargos y adeudos" name="scout_charges" invisible="not is_scout" groups="scout_management.group_scout_leader">
                    <div class="d-flex justify-content-end mb-1">
                        <span>Adeudo pendiente: <b><field name="scout_amount_due" widget="monetary" options="{'currency_field': 'scout_currency_id'}" class="oe_inline"/></b></span>
                    </div>
                    <div class="text-muted small mb-1">
                        Todo lo que tesorería le carga al miembro: registro, cuotas, artículos de la tienda scout,
                        alimentos, campamentos, eventos y colaboraciones.
                    </div>
                    <field name="scout_charge_line_ids" readonly="1">
                        <list decoration-danger="scout_move_payment_state == 'not_paid'"
                              decoration-success="scout_move_payment_state in ('paid', 'in_payment')">
                            <field name="date" string="Fecha"/>
                            <field name="move_name" string="Cargo"/>
                            <field name="product_id" string="Producto / servicio"/>
                            <field name="name" string="Detalle"/>
                            <field name="quantity" string="Cant."/>
                            <field name="price_total" string="Importe" sum="Total"/>
                            <field name="scout_move_residual" string="Saldo del cargo"/>
                            <field name="scout_move_payment_state" string="Estado" widget="badge"/>
                            <button name="action_scout_payment_link" type="object" string="Cobrar en línea" icon="fa-qrcode"
                                    invisible="scout_move_payment_state not in ('not_paid', 'partial')"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <separator string="Solicitudes de baja o cambio de sección"/>
                    <field name="scout_change_ids" readonly="1">
                        <list>
                            <field name="create_date" string="Fecha"/>
                            <field name="change_type"/>
                            <field name="new_section_id"/>
                            <field name="reason"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ============ Vistas propias de miembros ============ -->
    <record id="view_scout_member_list" model="ir.ui.view">
        <field name="name">res.partner.scout.list</field>
        <field name="model">res.partner</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list decoration-muted="scout_state == 'inactive'" decoration-warning="scout_next_section_due"
                  decoration-info="scout_state == 'trial'">
                <field name="name"/>
                <field name="scout_name" optional="show"/>
                <field name="scout_section_id"/>
                <field name="scout_patrol_id" optional="show"/>
                <field name="scout_type" optional="hide"/>
                <field name="scout_age"/>
                <field name="scout_birthdate" optional="hide"/>
                <field name="scout_shirt_size" optional="hide"/>
                <field name="scout_guardian_id" optional="show"/>
                <field name="scout_guardian_phone" optional="show"/>
                <field name="scout_position_id" optional="show"/>
                <field name="scout_registration_status" widget="badge" optional="show"
                       decoration-success="scout_registration_status in ('paid', 'exempt')"
                       decoration-warning="scout_registration_status in ('partial', 'pending')"
                       decoration-danger="scout_registration_status in ('not_paid', 'none')"/>
                <field name="scout_amount_due" optional="hide"/>
                <field name="scout_attendance_pct" widget="progressbar" optional="show"/>
                <field name="scout_time_left" optional="show"/>
                <field name="scout_route_state" optional="show" widget="badge" decoration-danger="scout_route_state == 'overdue'"
                       decoration-warning="scout_route_state in ('must_start', 'in_route', 'extension', 'departure_soon')"/>
                <field name="scout_route_destination_id" optional="show"/>
                <field name="scout_age_alert" optional="hide" widget="badge" decoration-danger="scout_age_alert == 'over'"
                       decoration-warning="scout_age_alert == 'soon'" decoration-info="scout_age_alert == 'under'"/>
                <field name="scout_needs_registration" optional="show" string="Debe registrarse" widget="boolean"/>
                <field name="scout_next_section_due" column_invisible="True"/>
                <field name="scout_currency_id" column_invisible="True"/>
                <field name="scout_state" widget="badge" decoration-success="scout_state == 'active'"
                       decoration-info="scout_state == 'trial'" decoration-muted="scout_state == 'inactive'"/>
            </list>
        </field>
    </record>

    <record id="view_scout_member_kanban" model="ir.ui.view">
        <field name="name">res.partner.scout.kanban</field>
        <field name="model">res.partner</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <kanban default_group_by="scout_section_id">
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="me-2">
                            <field name="avatar_128" widget="image" options="{'size': [64, 64]}"/>
                        </aside>
                        <main>
                            <field name="name" class="fw-bold"/>
                            <field name="scout_name" class="text-muted small"/>
                            <div class="small">
                                <field name="scout_patrol_id"/>
                                <span t-if="record.scout_age.raw_value"> · <field name="scout_age"/> años</span>
                            </div>
                            <footer class="pt-1">
                                <field name="scout_attendance_pct" widget="progressbar"/>
                                <field name="scout_state" widget="label_selection"
                                       options="{'classes': {'trial': 'info', 'active': 'success', 'inactive': 'default'}}"/>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_scout_member_search" model="ir.ui.view">
        <field name="name">res.partner.scout.search</field>
        <field name="model">res.partner</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('scout_name', 'ilike', self), ('scout_guardian_id', 'ilike', self)]"/>
                <field name="scout_section_id"/>
                <field name="scout_patrol_id"/>
                <field name="scout_guardian_id"/>
                <filter name="current" string="Activos y en prueba" domain="[('scout_state', 'in', ('trial', 'active'))]"/>
                <filter name="trial" string="En prueba" domain="[('scout_state', '=', 'trial')]"/>
                <filter name="inactive" string="Bajas" domain="[('scout_state', '=', 'inactive')]"/>
                <separator/>
                <filter name="youth" string="Beneficiarios" domain="[('scout_type', '=', 'youth')]"/>
                <filter name="leaders" string="Dirigentes" domain="[('scout_type', '=', 'leader')]"/>
                <separator/>
                <filter name="next_due" string="Próximos a pasar" domain="[('scout_next_section_due', '=', True)]"/>
                <filter name="transition" string="En ruta de enlace" domain="[('scout_transition_date', '!=', False)]"/>
                <separator/>
                <filter name="archived" string="Archivados" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_section" string="Sección" context="{'group_by': 'scout_section_id'}"/>
                    <filter name="group_patrol" string="Equipo" context="{'group_by': 'scout_patrol_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'scout_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_scout_member" model="ir.actions.act_window">
        <field name="name">Miembros</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_scout', '=', True)]</field>
        <field name="context">{'default_is_scout': True, 'default_company_type': 'person', 'search_default_current': 1, 'search_default_group_section': 1}</field>
        <field name="search_view_id" ref="view_scout_member_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra al primer miembro del grupo</p>
            <p>Cada miembro es un contacto con su expediente scout. También se crean al validar una ficha de registro.</p>
        </field>
    </record>
    <record id="action_scout_member_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_scout_member_list"/>
        <field name="act_window_id" ref="action_scout_member"/>
    </record>
    <record id="action_scout_member_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_scout_member_kanban"/>
        <field name="act_window_id" ref="action_scout_member"/>
    </record>
    <record id="action_scout_member_view_form" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="base.view_partner_form"/>
        <field name="act_window_id" ref="action_scout_member"/>
    </record>

    <!-- Solicitudes de cambio -->
    <record id="view_scout_member_change_form" model="ir.ui.view">
        <field name="name">scout.member.change.form</field>
        <field name="model">scout.member.change</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Aprobar" class="btn-primary"
                            invisible="state != 'to_approve'" groups="scout_management.group_scout_manager"/>
                    <button name="action_reject" type="object" string="Rechazar"
                            invisible="state != 'to_approve'" groups="scout_management.group_scout_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="to_approve,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="member_id" readonly="state != 'draft' and id"/>
                            <field name="change_type" readonly="id"/>
                            <field name="current_section_id"/>
                            <field name="new_section_id" invisible="change_type == 'leave'"
                                   required="change_type == 'section'" readonly="state != 'draft' and id"/>
                        </group>
                        <group>
                            <field name="effective_date"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                        </group>
                    </group>
                    <field name="reason" placeholder="Motivo de la baja o del cambio"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_scout_member_change_list" model="ir.ui.view">
        <field name="name">scout.member.change.list</field>
        <field name="model">scout.member.change</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'to_approve'" decoration-muted="state in ('approved', 'rejected')">
                <field name="create_date" string="Fecha"/>
                <field name="member_id"/>
                <field name="change_type"/>
                <field name="current_section_id"/>
                <field name="new_section_id"/>
                <field name="reason"/>
                <field name="create_uid" string="Solicitó"/>
                <field name="state" widget="badge" decoration-info="state == 'to_approve'" decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>
    <record id="action_scout_member_change" model="ir.actions.act_window">
        <field name="name">Bajas y cambios de sección</field>
        <field name="res_model">scout.member.change</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
    <record id="view_scout_member_change_search" model="ir.ui.view">
        <field name="name">scout.member.change.search</field>
        <field name="model">scout.member.change</field>
