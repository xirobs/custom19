<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= Productos de la tienda ================= -->
    <record id="view_product_template_form_scout" model="ir.ui.view">
        <field name="name">product.template.form.scout</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Tienda scout" name="scout_store" groups="scout_management.group_scout_officer">
                    <group>
                        <group>
                            <field name="scout_store_ok"/>
                            <field name="scout_sale_type" invisible="not scout_store_ok"/>
                            <field name="scout_track_qty" invisible="not scout_store_ok"/>
                        </group>
                        <group invisible="not scout_store_ok or not scout_track_qty">
                            <field name="scout_qty_available"/>
                            <field name="scout_initial_qty"/>
                            <field name="scout_min_qty"/>
                            <button name="action_scout_stock_in" type="object" string="Registrar entrada de mercancía"
                                    class="btn-secondary" colspan="2"/>
                        </group>
                    </group>
                    <field name="scout_stock_move_ids" readonly="1" invisible="not scout_track_qty">
                        <list>
                            <field name="date"/>
                            <field name="move_kind"/>
                            <field name="quantity" sum="Existencia"/>
                            <field name="unit_cost"/>
                            <field name="total_cost" sum="Costo"/>
                            <field name="note"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_scout_store_product_list" model="ir.ui.view">
        <field name="name">product.template.scout.store.list</field>
        <field name="model">product.template</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list decoration-danger="scout_low_stock" editable="bottom">
                <field name="name"/>
                <field name="scout_sale_type"/>
                <field name="standard_price" string="Costo"/>
                <field name="list_price" string="Precio de venta"/>
                <field name="scout_track_qty" optional="hide"/>
                <field name="scout_qty_available" string="Existencia"/>
                <field name="scout_min_qty" optional="show"/>
                <field name="scout_low_stock" column_invisible="True"/>
                <field name="scout_store_ok" column_invisible="True"/>
                <button name="action_scout_stock_in" type="object" icon="fa-plus-square" title="Entrada de mercancía"
                        invisible="not scout_track_qty"/>
            </list>
        </field>
    </record>
    <record id="action_scout_store_products" model="ir.actions.act_window">
        <field name="name">Productos de la tienda</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('scout_store_ok', '=', True)]</field>
        <field name="context">{'default_scout_store_ok': True, 'default_type': 'consu', 'default_sale_ok': True,
                               'default_taxes_id': [], 'default_supplier_taxes_id': []}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Da de alta los artículos de la tienda scout</p>
            <p>Pañoletas, playeras, insignias, alimentos o cuotas de campamento. Registra entradas de mercancía y la existencia se descuenta en cada venta.</p>
        </field>
    </record>
    <record id="action_scout_store_products_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_scout_store_product_list"/>
        <field name="act_window_id" ref="action_scout_store_products"/>
    </record>

    <!-- Entradas de mercancía -->
    <record id="view_scout_store_stock_move_form" model="ir.ui.view">
        <field name="name">scout.store.stock.move.form</field>
        <field name="model">scout.store.stock.move</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="product_tmpl_id"/>
                        <field name="move_kind"/>
                        <field name="date"/>
                    </group>
                    <group>
                        <field name="quantity"/>
                        <field name="unit_cost"/>
                        <field name="total_cost"/>
                        <field name="note"/>
                    </group>
                </group>
                <p class="text-muted">Si pagaste la mercancía, registra también el egreso "Compra de mercancía para tienda scout" para que el jefe de grupo lo autorice.</p>
                <footer>
                    <button string="Guardar" special="save" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_scout_store_stock_move_list" model="ir.ui.view">
        <field name="name">scout.store.stock.move.list</field>
        <field name="model">scout.store.stock.move</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="date"/>
                <field name="product_tmpl_id"/>
                <field name="move_kind"/>
                <field name="quantity" sum="Total"/>
                <field name="unit_cost"/>
                <field name="total_cost" sum="Costo"/>
                <field name="note"/>
            </list>
        </field>
    </record>
    <record id="action_scout_store_stock_move" model="ir.actions.act_window">
        <field name="name">Entradas y movimientos de mercancía</field>
        <field name="res_model">scout.store.stock.move</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_move_kind': 'in'}</field>
    </record>

    <!-- ================= Ventas ================= -->
    <record id="view_scout_store_sale_list" model="ir.ui.view">
        <field name="name">scout.store.sale.list</field>
        <field name="model">scout.store.sale</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-warning="paid_state != 'paid' and state == 'done'">
                <field name="date"/>
                <field name="name"/>
                <field name="sale_type"/>
                <field name="partner_id"/>
                <field name="member_id" optional="show"/>
                <field name="amount_total" sum="Total"/>
                <field name="payment_mode" optional="hide"/>
                <field name="paid_state" widget="badge" decoration-success="paid_state == 'paid'"
                       decoration-warning="paid_state == 'partial'" decoration-danger="paid_state == 'not_paid'"/>
                <field name="receipt_sent" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>
    <record id="view_scout_store_sale_form" model="ir.ui.view">
        <field name="name">scout.store.sale.form</field>
        <field name="model">scout.store.sale</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirmar venta" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_send_email" type="object" string="Enviar recibo por correo" class="btn-primary" invisible="state != 'done'"/>
                    <button name="action_send_whatsapp" type="object" string="Enviar por WhatsApp" invisible="state != 'done'"/>
                    <button name="action_scout_payment_link" type="object" string="Cobrar en línea (QR)" icon="fa-qrcode"
                            class="btn-primary" invisible="state != 'done' or paid_state == 'paid' or payment_mode == 'paid'"/>
                    <button name="%(scout_management.action_report_store_receipt)d" type="action" string="Imprimir recibo" invisible="state != 'done'"/>
                    <button name="action_cancel" type="object" string="Cancelar venta" invisible="state != 'done'"
                            confirm="Se regresan las piezas al inventario y se cancela el ingreso o cargo. ¿Continuar?"/>
                    <button name="action_draft" type="object" string="Regresar a borrador" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Pagada" bg_color="text-bg-success" invisible="paid_state != 'paid' or state != 'done'"/>
                    <widget name="web_ribbon" title="Por cobrar" bg_color="text-bg-warning" invisible="paid_state == 'paid' or state != 'done'"/>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="sale_type" widget="radio" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="member_id" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="event_id" invisible="sale_type != 'event'" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="payment_mode" widget="radio" readonly="state != 'draft'"/>
                            <field name="payment_method" invisible="payment_mode != 'paid'" readonly="state != 'draft'"/>
                            <field name="journal_id" invisible="payment_mode != 'paid'" readonly="state != 'draft'"/>
                            <field name="payment_reference" invisible="payment_mode != 'paid'"/>
                            <field name="paid_state"/>
                            <field name="treasury_move_id" invisible="not treasury_move_id"/>
                            <field name="invoice_id" invisible="not invoice_id"/>
                            <field name="receipt_sent"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="product_id" domain="[('scout_store_ok', '=', True), ('scout_sale_type', '=', parent.sale_type)]"/>
                            <field name="available_qty" optional="show"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                            <field name="subtotal" sum="Total"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="amount_total"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <field name="note" placeholder="Notas de la venta"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_scout_store_sale_search" model="ir.ui.view">
        <field name="name">scout.store.sale.search</field>
        <field name="model">scout.store.sale</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="member_id"/>
                <filter name="today" string="Hoy" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="unpaid" string="Por cobrar" domain="[('state', '=', 'done'), ('paid_state', '!=', 'paid')]"/>
                <separator/>
                <filter name="store" string="Tienda" domain="[('sale_type', '=', 'store')]"/>
                <filter name="food" string="Alimentos" domain="[('sale_type', '=', 'food')]"/>
                <filter name="event" string="Campamento / evento" domain="[('sale_type', '=', 'event')]"/>
                <filter name="filter_date" string="Fecha" date="date"/>
                <group>
                    <filter name="group_date" string="Día" context="{'group_by': 'date:day'}"/>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'sale_type'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_scout_store_sale" model="ir.actions.act_window">
        <field name="name">Ventas</field>
        <field name="res_model">scout.store.sale</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra una venta de la tienda, de alimentos o de un campamento/evento</p>
            <p>Si pagó, entra a caja o banco; si queda a deber, se carga a su estado de cuenta. Se genera recibo en PDF para enviar por correo o WhatsApp.</p>
        </field>
    </record>

    <!-- Parte de ventas (detalle por día, producto, cantidad, importe, quién compró y si pagó) -->
    <record id="view_scout_store_sale_line_list" model="ir.ui.view">
        <field name="name">scout.store.sale.line.list</field>
        <field name="model">scout.store.sale.line</field>
        <field name="arch" type="xml">
            <list create="0" decoration-warning="paid_state != 'paid'">
                <field name="date"/>
                <field name="sale_id"/>
                <field name="sale_type" optional="show"/>
                <field name="product_id"/>
                <field name="quantity" sum="Piezas"/>
                <field name="price_unit"/>
                <field name="subtotal" sum="Importe"/>
                <field name="partner_id"/>
                <field name="member_id" optional="hide"/>
                <field name="paid_state" widget="badge" decoration-success="paid_state == 'paid'" decoration-danger="paid_state == 'not_paid'"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="view_scout_store_sale_line_pivot" model="ir.ui.view">
        <field name="name">scout.store.sale.line.pivot</field>
        <field name="model">scout.store.sale.line</field>
        <field name="arch" type="xml">
            <pivot string="Parte de ventas">
                <field name="product_id" type="row"/>
                <field name="date" interval="day" type="col"/>
                <field name="quantity" type="measure"/>
                <field name="subtotal" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_scout_store_sale_line_search" model="ir.ui.view">
        <field name="name">scout.store.sale.line.search</field>
        <field name="model">scout.store.sale.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="partner_id"/>
                <filter name="done" string="Vendidas" domain="[('sale_state', '=', 'done')]"/>
                <filter name="unpaid" string="No pagadas" domain="[('paid_state', '!=', 'paid')]"/>
                <filter name="filter_date" string="Fecha" date="date"/>
                <group>
                    <filter name="group_day" string="Día" context="{'group_by': 'date:day'}"/>
                    <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_scout_store_sale_line" model="ir.actions.act_window">
        <field name="name">Parte de ventas</field>
        <field name="res_model">scout.store.sale.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_done': 1, 'search_default_group_day': 1}</field>
    </record>

    <record id="view_scout_daily_sales_wizard_form" model="ir.ui.view">
        <field name="name">scout.daily.sales.wizard.form</field>
        <field name="model">scout.daily.sales.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <label for="date_from" string="Periodo"/>
                    <div class="o_row"><field name="date_from"/> al <field name="date_to"/></div>
                    <field name="sale_type"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Imprimir PDF" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_scout_daily_sales_wizard" model="ir.actions.act_window">
        <field name="name">Parte de ventas (PDF)</field>
        <field name="res_model">scout.daily.sales.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Correo con el recibo -->
    <record id="mail_template_store_receipt" model="mail.template">
        <field name="name">Scout: recibo de venta</field>
        <field name="model_id" ref="model_scout_store_sale"/>
        <field name="subject">Recibo {{ object.name }} - {{ object.company_id.name }}</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="report_template_ids" eval="[Command.link(ref('scout_management.action_report_store_receipt'))]"/>
        <field name="body_html" type="html">
<div>
    <p>Hola <t t-out="object.partner_id.name"/>,</p>
    <p>Te enviamos tu recibo <b t-out="object.name"/> por <b t-out="format_amount(object.amount_total, object.currency_id)"/>
        del <t t-out="object.company_id.name"/>.</p>
    <p t-if="object.paid_state != 'paid'">Queda pendiente de pago; puedes consultarlo en tu portal.</p>
    <p>¡Gracias por apoyar al grupo! Siempre listos para servir.</p>
</div>
        </field>
        <field name="auto_delete" eval="False"/>
    </record>
</odoo>
