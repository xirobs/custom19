<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= Actas ================= -->
    <record id="view_scout_meeting_list" model="ir.ui.view">
        <field name="name">scout.meeting.list</field>
        <field name="model">scout.meeting</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'to_approve'" decoration-muted="state == 'cancel'">
                <field name="date"/>
                <field name="name"/>
                <field name="meeting_type"/>
                <field name="title"/>
                <field name="attendee_count"/>
                <field name="secretary_id" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'to_approve'"/>
            </list>
        </field>
    </record>
    <record id="view_scout_meeting_form" model="ir.ui.view">
        <field name="name">scout.meeting.form</field>
        <field name="model">scout.meeting</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Enviar a aprobación" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Aprobar acta" class="btn-primary"
                            invisible="state != 'to_approve'" groups="scout_management.group_scout_manager"/>
                    <button name="action_reject" type="object" string="Regresar para correcciones"
                            invisible="state != 'to_approve'" groups="scout_management.group_scout_manager"/>
                    <button name="%(scout_management.action_report_meeting)d" type="action" string="Imprimir acta"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state in ('approved', 'cancel')"/>
                    <button name="action_draft" type="object" string="Regresar a borrador" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_approve,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="text-muted"><field name="name" readonly="1"/></span>
                        <h1><field name="title" readonly="state == 'approved'"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="meeting_type"/>
                            <field name="event_id"/>
                            <field name="date" readonly="state == 'approved'"/>
                            <field name="mode"/>
                            <field name="location"/>
                            <field name="section_id" invisible="meeting_type != 'section'"/>
                        </group>
                        <group>
                            <field name="chair_id"/>
                            <field name="secretary_id"/>
                            <field name="quorum"/>
                            <field name="next_meeting"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="approved_date" invisible="not approved_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Asistencia" name="attendance">
                            <group>
                                <field name="attendee_ids" widget="many2many_tags_avatar" readonly="state == 'approved'"/>
                                <field name="absent_ids" widget="many2many_tags_avatar"/>
                            </group>
                        </page>
                        <page string="Orden del día" name="agenda">
                            <field name="agenda" readonly="state == 'approved'" placeholder="1. Lista de asistencia y quórum&#10;2. Lectura del acta anterior&#10;3. Informes de sección&#10;4. Informe de tesorería&#10;5. Asuntos generales"/>
                        </page>
                        <page string="Desarrollo" name="minutes">
                            <field name="minutes" readonly="state == 'approved'"/>
                        </page>
                        <page string="Acuerdos" name="agreements">
                            <field name="agreement_ids">
                                <list editable="bottom" decoration-success="state == 'done'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="responsible_id"/>
                                    <field name="due_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_scout_meeting_search" model="ir.ui.view">
        <field name="name">scout.meeting.search</field>
        <field name="model">scout.meeting</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/>
                <field name="name"/>
                <filter name="to_approve" string="Por aprobar" domain="[('state', '=', 'to_approve')]"/>
                <filter name="approved" string="Aprobadas" domain="[('state', '=', 'approved')]"/>
                <group>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'meeting_type'}"/>
                    <filter name="group_year" string="Año" context="{'group_by': 'date:year'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_scout_meeting" model="ir.actions.act_window">
        <field name="name">Actas de consejo y juntas</field>
        <field name="res_model">scout.meeting</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Redacta el acta del próximo consejo de grupo</p>
            <p>La secretaría la captura y la envía a aprobación; al aprobarla el jefe de grupo, se notifica a los asistentes y se imprime en el formato oficial.</p>
        </field>
    </record>

    <!-- Acuerdos pendientes (seguimiento) -->
    <record id="view_scout_agreement_list" model="ir.ui.view">
        <field name="name">scout.meeting.agreement.list</field>
        <field name="model">scout.meeting.agreement</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" decoration-success="state == 'done'">
                <field name="meeting_id" readonly="1"/>
                <field name="name" readonly="1"/>
                <field name="responsible_id"/>
                <field name="due_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="action_scout_agreement" model="ir.actions.act_window">
        <field name="name">Seguimiento de acuerdos</field>
        <field name="res_model">scout.meeting.agreement</field>
        <field name="view_mode">list</field>
        <field name="domain">[('meeting_id.state', '=', 'approved')]</field>
        <field name="context">{}</field>
    </record>

    <!-- ================= Chat con familias ================= -->
    <record id="view_scout_family_conversation_list" model="ir.ui.view">
        <field name="name">scout.family.conversation.list</field>
        <field name="model">scout.family.conversation</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="member_id"/>
                <field name="section_id"/>
                <field name="guardian_id"/>
                <field name="message_needaction_counter" string="Sin leer"/>
                <field name="write_date" string="Actualizado"/>
            </list>
        </field>
    </record>
    <record id="view_scout_family_conversation_form" model="ir.ui.view">
        <field name="name">scout.family.conversation.form</field>
        <field name="model">scout.family.conversation</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="member_id" readonly="1"/>
                            <field name="section_id"/>
                        </group>
                        <group>
                            <field name="guardian_id"/>
                        </group>
                    </group>
                    <p class="text-muted">Escribe en "Enviar mensaje" para responder a la familia: le llega por correo y en su portal. Las notas internas no las ve la familia.</p>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_scout_family_conversation" model="ir.actions.act_window">
        <field name="name">Chat con familias</field>
        <field name="res_model">scout.family.conversation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
