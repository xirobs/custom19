<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Conceptos -->
    <record id="view_scout_treasury_category_list" model="ir.ui.view">
        <field name="name">scout.treasury.category.list</field>
        <field name="model">scout.treasury.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_type"/>
                <field name="account_id"/>
                <field name="report_group" invisible="category_type != 'income'"/>
            </list>
        </field>
    </record>
    <record id="action_scout_treasury_category" model="ir.actions.act_window">
        <field name="name">Conceptos de ingreso y egreso</field>
        <field name="res_model">scout.treasury.category</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Movimientos de caja y bancos -->
    <record id="view_scout_treasury_move_list" model="ir.ui.view">
        <field name="name">scout.treasury.move.list</field>
        <field name="model">scout.treasury.move</field>
        <field name="arch" type="xml">
            <list decoration-success="move_type == 'income'" decoration-danger="move_type == 'expense'"
                  decoration-muted="state == 'cancel'" decoration-warning="state == 'to_approve'">
                <field name="date"/>
                <field name="name" optional="show"/>
                <field name="move_type"/>
                <field name="category_id"/>
                <field name="description"/>
                <field name="journal_id"/>
                <field name="approved_by_id" optional="hide" string="Autorizado por"/>
                <field name="dest_journal_id" optional="hide"/>
                <field name="member_id" optional="hide"/>
                <field name="partner_id" optional="show"/>
                <field name="reference" optional="hide"/>
                <field name="signed_amount" sum="Neto"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-warning="state == 'to_approve'"/>
            </list>
        </field>
    </record>
    <record id="view_scout_treasury_move_form" model="ir.ui.view">
        <field name="name">scout.treasury.move.form</field>
        <field name="model">scout.treasury.move</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object" string="Registrar" class="btn-primary"
                            invisible="state != 'draft' or move_type != 'income'"/>
                    <button name="action_post" type="object" string="Enviar a aprobación" class="btn-primary"
                            invisible="state != 'draft' or move_type == 'income'"/>
                    <button name="action_approve" type="object" string="Aprobar y registrar" class="btn-primary"
                            invisible="state != 'to_approve'" groups="scout_management.group_scout_manager"/>
                    <button name="action_reject" type="object" string="Rechazar"
                            invisible="state != 'to_approve'" groups="scout_management.group_scout_manager"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state == 'cancel'"
                            confirm="¿Cancelar este movimiento? Se revierte su asiento contable."/>
                    <button name="action_draft" type="object" string="Regresar a borrador" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_approve,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_account_move" type="object" class="oe_stat_button" icon="fa-book"
                                string="Asiento contable" invisible="not account_move_id"/>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="move_type" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"
                                   invisible="context.get('scout_fixed_type')"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="journal_id" readonly="state != 'draft'"/>
                            <field name="dest_journal_id" invisible="move_type != 'transfer'"
                                   required="move_type == 'transfer'" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="account_move_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="category_id" invisible="move_type == 'transfer'" required="move_type != 'transfer'"
                                   readonly="state != 'draft'" string="Tipo de concepto"/>
                            <field name="payment_method"/>
                            <field name="reference"/>
                            <field name="requested_by_id"/>
                            <field name="approved_by_id" invisible="move_type == 'income'"
                                   placeholder="Se llena al autorizar el jefe de grupo"/>
                            <field name="store_sale_id" invisible="not store_sale_id"/>
                        </group>
                    </group>
                    <label for="description" string="Concepto (de qué se trató)"/>
                    <field name="description" placeholder="Ej. Pago de sombreros para Gacelas: 6 piezas a $90, proveedor X, entregados el sábado…"/>
                    <group>
                        <group string="Relacionado con" invisible="move_type == 'transfer'">
                            <field name="member_id"/>
                            <field name="section_id"/>
                            <field name="event_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Comprobante">
                            <field name="attachment" filename="attachment_name"/>
                            <field name="attachment_name" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_scout_treasury_move_search" model="ir.ui.view">
        <field name="name">scout.treasury.move.search</field>
        <field name="model">scout.treasury.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="description"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="journal_id"/>
                <field name="member_id"/>
                <field name="partner_id"/>
                <filter name="income" string="Ingresos" domain="[('move_type', '=', 'income')]"/>
                <filter name="expense" string="Egresos" domain="[('move_type', '=', 'expense')]"/>
                <filter name="transfer" string="Traspasos" domain="[('move_type', '=', 'transfer')]"/>
                <separator/>
                <filter name="to_approve" string="Por aprobar" domain="[('state', '=', 'to_approve')]"/>
                <filter name="posted" string="Registrados" domain="[('state', '=', 'posted')]"/>
                <filter name="filter_date" string="Fecha" date="date"/>
                <group>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'move_type'}"/>
                    <filter name="group_category" string="Concepto" context="{'group_by': 'category_id'}"/>
                    <filter name="group_month" string="Mes" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_scout_treasury_move_pivot" model="ir.ui.view">
        <field name="name">scout.treasury.move.pivot</field>
        <field name="model">scout.treasury.move</field>
        <field name="arch" type="xml">
            <pivot string="Ingresos y egresos">
                <field name="move_type" type="row"/>
                <field name="category_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="signed_amount" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_scout_treasury_income" model="ir.actions.act_window">
        <field name="name">Ingresos</field>
        <field name="res_model">scout.treasury.move</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="domain">[('move_type', '=', 'income')]</field>
        <field name="context">{'default_move_type': 'income', 'scout_fixed_type': True}</field>
    </record>
    <record id="action_scout_treasury_expense" model="ir.actions.act_window">
        <field name="name">Egresos</field>
        <field name="res_model">scout.treasury.move</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="domain">[('move_type', '=', 'expense')]</field>
        <field name="context">{'default_move_type': 'expense', 'scout_fixed_type': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra un egreso</p>
            <p>Describe el concepto con detalle y adjunta el comprobante. El jefe de grupo lo autoriza y queda registrado quién lo autorizó.</p>
        </field>
    </record>
    <record id="action_scout_treasury_transfer" model="ir.actions.act_window">
        <field name="name">Traspasos entre caja y bancos</field>
        <field name="res_model">scout.treasury.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'transfer')]</field>
        <field name="context">{'default_move_type': 'transfer', 'scout_fixed_type': True}</field>
    </record>
    <record id="action_scout_treasury_move" model="ir.actions.act_window">
        <field name="name">Caja y bancos (todos los movimientos)</field>
        <field name="res_model">scout.treasury.move</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra un ingreso, gasto o traspaso</p>
            <p>Cada movimiento genera su asiento en Contabilidad. Los gastos y traspasos esperan la aprobación del jefe de grupo.</p>
        </field>
    </record>

    <!-- Contabilidad: miembro y aprobación en facturas -->
    <record id="view_move_form_scout" model="ir.ui.view">
        <field name="name">account.move.form.scout</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="scout_needs_approval" invisible="1"/>
                <button name="action_scout_request_approval" type="object" string="Solicitar aprobación" class="btn-primary"
                        invisible="not scout_needs_approval or state != 'draft' or scout_approval_state == 'to_approve'"/>
                <button name="action_scout_approve" type="object" string="Aprobar y confirmar" class="btn-primary"
                        invisible="scout_approval_state != 'to_approve'" groups="scout_management.group_scout_manager"/>
                <button name="action_scout_reject" type="object" string="Rechazar"
                        invisible="scout_approval_state != 'to_approve'" groups="scout_management.group_scout_manager"/>
                <field name="scout_can_pay_online" invisible="1"/>
                <button name="action_scout_payment_link" type="object" string="Cobrar en línea (QR)" icon="fa-qrcode"
                        invisible="not scout_can_pay_online"/>
            </xpath>
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="scout_member_id" invisible="move_type not in ('out_invoice', 'out_refund', 'entry')"
                       options="{'no_create': True}"/>
                <field name="scout_approval_state" invisible="move_type not in ('in_invoice', 'in_refund')"
                       widget="badge" decoration-warning="scout_approval_state == 'to_approve'"
                       decoration-success="scout_approval_state == 'approved'" decoration-danger="scout_approval_state == 'rejected'"/>
            </xpath>
        </field>
    </record>
    <record id="view_scout_leader_access_wizard" model="ir.ui.view">
        <field name="name">scout.leader.access.wizard.form</field>
        <field name="model">scout.leader.access.wizard</field>
        <field name="arch" type="xml">
            <form string="Acceso al portal de dirigentes">
                <div class="alert alert-info" role="status">
                    El dirigente entra desde el celular a su <b>Portal de dirigentes</b>. Mándale la liga por WhatsApp para que
                    cree su contraseña, que escanee el QR, o asígnale una contraseña aquí y díselo en persona.
                </div>
                <div class="row">
                    <div class="col-md-5 text-center">
                        <field name="qr_code" widget="image" readonly="1" options="{'size': [220, 220]}"/>
                        <div class="text-muted small">Escanéalo con la cámara del celular para crear la contraseña.</div>
                    </div>
                    <div class="col-md-7">
                        <group>
                            <field name="partner_id"/>
                            <field name="login"/>
                            <field name="portal_url" widget="CopyClipboardChar"/>
                            <field name="link" widget="CopyClipboardChar"/>
                            <field name="phone" widget="phone"/>
                        </group>
                        <group string="O asigna la contraseña ahora">
                            <field name="password" password="True" nolabel="1" colspan="2" placeholder="Mínimo 6 caracteres"/>
                            <button name="action_set_password" type="object" string="Guardar contraseña" icon="fa-key"
                                    class="btn-secondary" colspan="2"/>
                        </group>
                    </div>
                </div>
                <footer>
                    <button name="action_whatsapp" type="object" string="Enviar por WhatsApp" class="btn-primary" icon="fa-whatsapp"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_scout_payment_link_wizard" model="ir.ui.view">
        <field name="name">scout.payment.link.wizard.form</field>
        <field name="model">scout.payment.link.wizard</field>
        <field name="arch" type="xml">
            <form string="Cobrar en línea">
                <field name="provider_ready" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="provider_ready">
                    Aún no hay una pasarela de pago activa. Activa Mercado Pago en
                    <b>Grupo Scout ▸ Configuración ▸ Pago en línea (Mercado Pago)</b> para que la liga acepte pagos.
                </div>
                <div class="row">
                    <div class="col-md-5 text-center">
                        <field name="qr_code" widget="image" readonly="1" options="{'size': [240, 240]}"/>
                        <div class="text-muted small">Que el papá o la mamá escanee con la cámara del celular.</div>
                    </div>
                    <div class="col-md-7">
                        <group>
                            <field name="move_id"/>
                            <field name="member_id" invisible="not member_id"/>
                            <field name="partner_id"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="link" widget="CopyClipboardChar"/>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                    </div>
                </div>
                <footer>
                    <button name="action_whatsapp" type="object" string="Enviar por WhatsApp" class="btn-primary" icon="fa-whatsapp"/>
                    <button name="action_email" type="object" string="Enviar por correo" icon="fa-envelope"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_account_payment_form_scout" model="ir.ui.view">
        <field name="name">account.payment.form.scout</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_scout_request_approval" type="object" string="Solicitar aprobación" class="btn-primary"
                        invisible="state != 'draft' or payment_type != 'outbound' or scout_approval_state in ('to_approve', 'approved')"/>
                <button name="action_scout_approve" type="object" string="Aprobar y confirmar" class="btn-primary"
                        invisible="scout_approval_state != 'to_approve'" groups="scout_management.group_scout_manager"/>
            </xpath>
            <xpath expr="//field[@name='memo']" position="after">
                <field name="scout_member_id" options="{'no_create': True}"/>
                <field name="scout_approval_state" invisible="payment_type != 'outbound'" widget="badge"/>
            </xpath>
        </field>
    </record>

    <!-- Cargos a miembros (CxC) y facturas de proveedor (CxP) -->
    <record id="action_scout_receivable" model="ir.actions.act_window">
        <field name="name">Cargos a miembros (por cobrar)</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund'))]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'search_default_unpaid': 1}</field>
    </record>
    <record id="action_scout_payable" model="ir.actions.act_window">
        <field name="name">Facturas de proveedor (por pagar)</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund'))]</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
    </record>
    <record id="action_scout_bills_to_approve" model="ir.actions.act_window">
        <field name="name">Gastos por aprobar</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="domain">[('scout_approval_state', '=', 'to_approve')]</field>
    </record>
    <record id="action_scout_treasury_to_approve" model="ir.actions.act_window">
        <field name="name">Egresos y traspasos por aprobar</field>
        <field name="res_model">scout.treasury.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'to_approve')]</field>
    </record>
    <record id="action_scout_payments_to_approve" model="ir.actions.act_window">
        <field name="name">Pagos por aprobar</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('scout_approval_state', '=', 'to_approve')]</field>
    </record>
</odoo>
