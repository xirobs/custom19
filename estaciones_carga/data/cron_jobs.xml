<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Expirar transacciones pendientes vencidas -->
        <record id="cron_expirar_transacciones" model="ir.cron">
            <field name="name">Cargas: Expirar transacciones pendientes</field>
            <field name="model_id" ref="model_cargas_transaccion"/>
            <field name="state">code</field>
            <field name="code">model.cron_expirar_transacciones()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Detectar apagones por patrón de heartbeats en batería -->
        <record id="cron_detectar_apagones" model="ir.cron">
            <field name="name">Cargas: Detectar apagones</field>
            <field name="model_id" ref="model_cargas_heartbeat"/>
            <field name="state">code</field>
            <field name="code">model.detectar_apagones()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Limpiar heartbeats antiguos -->
        <record id="cron_limpiar_heartbeats" model="ir.cron">
            <field name="name">Cargas: Limpiar heartbeats antiguos</field>
            <field name="model_id" ref="model_cargas_heartbeat"/>
            <field name="state">code</field>
            <field name="code">model.cron_limpiar_antiguos()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
