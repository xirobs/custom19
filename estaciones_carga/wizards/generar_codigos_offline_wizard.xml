<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_generar_codigos_offline_wizard_form" model="ir.ui.view">
        <field name="name">cargas.generar_codigos_offline.wizard.form</field>
        <field name="model">cargas.generar_codigos_offline.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Códigos Offline">
                <group>
                    <field name="estacion_id"/>
                    <field name="nombre_lote"/>
                    <field name="tipo_carga"/>
                    <field name="cantidad"/>
                </group>
                <div class="alert alert-info" role="alert">
                    Estos códigos se imprimen o se entregan al operador para
                    activar puertos manualmente cuando no hay internet.
                </div>
                <footer>
                    <button name="action_generar" type="object"
                            string="Generar" class="btn-primary"/>
                    <button special="cancel" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_generar_codigos_offline_wizard" model="ir.actions.act_window">
        <field name="name">Generar Lote de Códigos</field>
        <field name="res_model">cargas.generar_codigos_offline.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_generar_codigos"
              name="Generar nuevo lote"
              parent="menu_offline_root"
              action="action_generar_codigos_offline_wizard"
              sequence="5"/>

</odoo>
