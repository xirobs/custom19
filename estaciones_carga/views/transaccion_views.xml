<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_transaccion_list" model="ir.ui.view">
        <field name="name">cargas.transaccion.list</field>
        <field name="model">cargas.transaccion</field>
        <field name="arch" type="xml">
            <list string="Transacciones" decoration-success="estado in ('pagado','aplicado','completado')"
                  decoration-muted="estado in ('expirado','reembolsado')"
                  decoration-warning="estado == 'pendiente'">
                <field name="referencia"/>
                <field name="create_date"/>
                <field name="estacion_id"/>
                <field name="puerto"/>
                <field name="tipo_carga"/>
                <field name="metodo_pago"/>
                <field name="monto_total" widget="monetary"/>
                <field name="surge_aplicado" widget="boolean_toggle" optional="hide"/>
                <field name="estado" widget="badge"
                       decoration-success="estado in ('pagado','aplicado','completado')"
                       decoration-warning="estado == 'pendiente'"
                       decoration-muted="estado in ('expirado','reembolsado')"/>
                <field name="invoice_id" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_transaccion_form" model="ir.ui.view">
        <field name="name">cargas.transaccion.form</field>
        <field name="model">cargas.transaccion</field>
        <field name="arch" type="xml">
            <form string="Transacción">
                <header>
                    <button name="action_confirmar_pago"
                            type="object"
                            string="Confirmar pago"
                            class="btn-primary"
                            invisible="estado != 'pendiente'"/>
                    <button name="action_reembolsar"
                            type="object"
                            string="Reembolsar"
                            class="btn-warning"
                            invisible="estado not in ('pagado','aplicado')"
                            confirm="¿Confirmar el reembolso? Se generará una nota de crédito."/>
                    <field name="estado" widget="statusbar"
                           statusbar_visible="pendiente,pagado,aplicado,completado"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="not invoice_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Factura</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="referencia"/>
                        <h1><field name="referencia" readonly="1"/></h1>
                    </div>

                    <group>
                        <group>
                            <field name="estacion_id"/>
                            <field name="puerto"/>
                            <field name="tipo_carga"/>
                            <field name="minutos"/>
                        </group>
                        <group>
                            <field name="metodo_pago"/>
                            <field name="monto_base" widget="monetary"/>
                            <field name="surge_aplicado"/>
                            <field name="monto_total" widget="monetary"/>
                            <field name="monto_bs"/>
                            <field name="tasa_cambio"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <group>
                        <group string="Pago">
                            <field name="referencia_pago"/>
                            <field name="telefono_cliente"/>
                            <field name="invoice_id" readonly="1"/>
                        </group>
                        <group string="Timestamps">
                            <field name="expira_en" readonly="1"/>
                            <field name="pagada_en" readonly="1"/>
                            <field name="aplicada_en" readonly="1"/>
                            <field name="token_activacion" readonly="1" groups="estaciones_carga.group_cargas_admin"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_transaccion_search" model="ir.ui.view">
        <field name="name">cargas.transaccion.search</field>
        <field name="model">cargas.transaccion</field>
        <field name="arch" type="xml">
            <search>
                <field name="referencia"/>
                <field name="estacion_id"/>
                <field name="referencia_pago"/>
                <field name="telefono_cliente"/>
                <filter string="Pendientes" name="pendientes" domain="[('estado','=','pendiente')]"/>
                <filter string="Pagadas" name="pagadas" domain="[('estado','=','pagado')]"/>
                <filter string="Aplicadas" name="aplicadas" domain="[('estado','=','aplicado')]"/>
                <filter string="Hoy" name="hoy"
                        domain="[('create_date','&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Con surge" name="con_surge" domain="[('surge_aplicado','=',True)]"/>
            </search>
        </field>
    </record>

    <record id="view_transaccion_pivot" model="ir.ui.view">
        <field name="name">cargas.transaccion.pivot</field>
        <field name="model">cargas.transaccion</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Transacciones">
                <field name="estacion_id" type="row"/>
                <field name="create_date" interval="day" type="col"/>
                <field name="monto_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_transaccion_graph" model="ir.ui.view">
        <field name="name">cargas.transaccion.graph</field>
        <field name="model">cargas.transaccion</field>
        <field name="arch" type="xml">
            <graph string="Análisis de Transacciones" type="bar">
                <field name="estacion_id"/>
                <field name="monto_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_transaccion" model="ir.actions.act_window">
        <field name="name">Transacciones</field>
        <field name="res_model">cargas.transaccion</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_transaccion_search"/>
    </record>

</odoo>
