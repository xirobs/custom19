<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Regla: los operadores solo ven sus propias estaciones -->
        <record id="rule_estacion_operador" model="ir.rule">
            <field name="name">Operador: solo sus estaciones</field>
            <field name="model_id" ref="model_cargas_estacion"/>
            <field name="domain_force">[('operador_id.user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_cargas_operador'))]"/>
        </record>

        <record id="rule_estacion_admin" model="ir.rule">
            <field name="name">Admin: todas las estaciones</field>
            <field name="model_id" ref="model_cargas_estacion"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_cargas_admin'))]"/>
        </record>

        <!-- Regla: transacciones por estación del operador -->
        <record id="rule_transaccion_operador" model="ir.rule">
            <field name="name">Operador: solo transacciones de sus estaciones</field>
            <field name="model_id" ref="model_cargas_transaccion"/>
            <field name="domain_force">[('estacion_id.operador_id.user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_cargas_operador'))]"/>
        </record>

        <record id="rule_transaccion_admin" model="ir.rule">
            <field name="name">Admin: todas las transacciones</field>
            <field name="model_id" ref="model_cargas_transaccion"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_cargas_admin'))]"/>
        </record>
    </data>
</odoo>