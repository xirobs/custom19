<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="creart_activity_confirm_day1" model="mail.activity.type">
            <field name="name">Confirmación día 1</field>
            <field name="summary">Confirmación día 1</field>
            <field name="sequence">10</field>
            <field name="res_model">crm.lead</field>
            <field name="delay_count">1</field>
            <field name="delay_unit">days</field>
            <field name="delay_from">current_date</field>
            <field name="icon">fa-check-circle</field>
            <field name="default_note"><![CDATA[
<p>Registrar el primer mensaje de confirmación tras el contacto o cotización.</p>
            ]]></field>
        </record>

        <record id="creart_activity_followup_3_7_15" model="mail.activity.type">
            <field name="name">Seguimiento día 3 / 7 / 15</field>
            <field name="summary">Seguimiento día 3 / 7 / 15</field>
            <field name="sequence">20</field>
            <field name="res_model">crm.lead</field>
            <field name="delay_count">3</field>
            <field name="delay_unit">days</field>
            <field name="delay_from">current_date</field>
            <field name="icon">fa-comments</field>
            <field name="default_note"><![CDATA[
<p>Recordatorios de los mensajes de seguimiento suave y de valor en los días 3, 7 y 15.</p>
            ]]></field>
        </record>

        <record id="creart_activity_call_day10" model="mail.activity.type">
            <field name="name">Llamada día 10</field>
            <field name="summary">Llamada día 10</field>
            <field name="sequence">30</field>
            <field name="res_model">crm.lead</field>
            <field name="delay_count">10</field>
            <field name="delay_unit">days</field>
            <field name="delay_from">current_date</field>
            <field name="category">phonecall</field>
            <field name="icon">fa-phone</field>
            <field name="default_note"><![CDATA[
<p>Recordatorio para la llamada telefónica directa de status.</p>
            ]]></field>
        </record>

        <record id="creart_activity_close_cycle_day30" model="mail.activity.type">
            <field name="name">Cierre de ciclo día 30</field>
            <field name="summary">Cierre de ciclo día 30</field>
            <field name="sequence">40</field>
            <field name="res_model">crm.lead</field>
            <field name="delay_count">30</field>
            <field name="delay_unit">days</field>
            <field name="delay_from">current_date</field>
            <field name="icon">fa-flag-checkered</field>
            <field name="default_note"><![CDATA[
<p>Último contacto antes de mover el lead a reactivación.</p>
            ]]></field>
        </record>

        <record id="creart_activity_meeting_demo" model="mail.activity.type">
            <field name="name">Reunión / Demo</field>
            <field name="summary">Reunión / Demo</field>
            <field name="sequence">50</field>
            <field name="res_model">crm.lead</field>
            <field name="delay_count">0</field>
            <field name="delay_unit">days</field>
            <field name="delay_from">current_date</field>
            <field name="icon">fa-handshake-o</field>
            <field name="default_note"><![CDATA[
<p>Para reuniones agendadas de prospección B2B o networking.</p>
            ]]></field>
        </record>

        <record id="creart_activity_send_quote" model="mail.activity.type">
            <field name="name">Enviar cotización</field>
            <field name="summary">Enviar cotización</field>
            <field name="sequence">60</field>
            <field name="res_model">crm.lead</field>
            <field name="delay_count">0</field>
            <field name="delay_unit">days</field>
            <field name="delay_from">current_date</field>
            <field name="icon">fa-file-text-o</field>
            <field name="default_note"><![CDATA[
<p>Recordatorio para elaborar y enviar la propuesta formal.</p>
            ]]></field>
        </record>

    </data>
</odoo>
