            <field name="name">CreArt 3DP (Lun–Sáb)</field>
            <field name="code">CREART_MX</field>
            <field name="country_id" ref="base.mx"/>
            <field name="workdays">0,1,2,3,4,5</field>
            <field name="daily_hours">7.75</field>
            <field name="note">Ventanas CreArt: 05–07, 10–12:45, 16–18 y 19–20 h (aprox. 7.75 h/día).</field>
        </record>

    </data>
