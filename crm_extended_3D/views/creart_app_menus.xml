<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <delete model="ir.actions.act_url" search="[('url', '=', '/creart/app')]"/>
        <record id="view_creart_3dp_dashboard_form" model="ir.ui.view">
            <field name="name">creart.3dp.dashboard.form</field>
            <field name="model">creart.3dp.dashboard</field>
            <field name="arch" type="xml">
                <form string="Tablero CreArt 3DP" create="0" delete="0">
                    <header>
                        <button name="action_refresh_dashboard" type="object" string="Actualizar" class="btn-primary"/>
                        <button name="action_open_pipeline_graph" type="object" string="Ver gráfico del pipeline" class="btn-secondary"/>
                    </header>
                    <sheet>
                        <div class="oe_title"><h1>Tablero CreArt 3DP</h1></div>
                        <group>
                            <group string="Ventas">
                                <field name="currency_id" invisible="1"/>
                                <field name="kpi_sold_month" widget="monetary"/>
                                <field name="kpi_sold_delta" widget="monetary"/>
                                <field name="kpi_average_ticket" widget="monetary"/>
                                <field name="kpi_receivable" widget="monetary"/>
                                <field name="kpi_conversion"/>
                                <field name="kpi_cycle_days"/>
                            </group>
                            <group string="Pronóstico">
                                <field name="kpi_open_value" widget="monetary"/>
                                <field name="kpi_weighted" widget="monetary"/>
                                <field name="kpi_forecast_total" widget="monetary"/>
                                <field name="kpi_confidence"/>
                                <field name="kpi_months_of_data"/>
                            </group>
                            <group string="Producción">
                                <field name="jobs_active"/>
                                <field name="jobs_printing"/>
                                <field name="jobs_queue"/>
                                <field name="kpi_overdue"/>
                            </group>
                            <group string="Atención">
                                <field name="kpi_unpriced"/>
                                <field name="jobs_not_profitable"/>
                                <field name="jobs_material_shortage"/>
                                <field name="avg_margin_percent"/>
                            </group>
                        </group>
                        <div class="alert alert-info" role="status" invisible="kpi_confidence != 'baja'">
                            Aún hay pocos datos de ventas: toma el pronóstico como referencia, no como meta.
                        </div>
                        <group string="Accesos">
                            <button name="action_open_active_jobs" type="object" string="Trabajos activos" class="btn-link"/>
                            <button name="action_open_printing_jobs" type="object" string="Imprimiendo" class="btn-link"/>
                            <button name="action_open_not_profitable" type="object" string="No rentables" class="btn-link"/>
                            <button name="action_open_material_shortage" type="object" string="Faltante de material" class="btn-link"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_creart_open_dashboard" model="ir.actions.server">
            <field name="name">Tablero CreArt 3DP</field>
            <field name="model_id" ref="model_creart_3dp_dashboard"/>
            <field name="state">code</field>
            <field name="code">action = model.action_open_dashboard()</field>
        </record>
        <menuitem id="menu_creart_kpi" name="Tablero"
                  parent="menu_creart_root" action="action_creart_open_dashboard" sequence="4"/>

        <record id="view_creart_team_add_wizard_form" model="ir.ui.view">
            <field name="name">creart.team.add.wizard.form</field>
            <field name="model">creart.team.add.wizard</field>
            <field name="arch" type="xml">
                <form string="Agregar al equipo de la app">
                    <div class="alert alert-info" role="status">
                        Las personas del equipo entran directo a la app CreArt (celular o computadora)
                        y pueden registrar trabajos, cotizar, avanzar producción y usar la agenda.
                    </div>
                    <group>
                        <field name="mode" widget="radio" options="{'horizontal': true}"/>
                    </group>
                    <group invisible="mode != 'existing'">
                        <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"
                               placeholder="Busca por nombre o correo…" required="mode == 'existing'"/>
                    </group>
                    <group invisible="mode != 'new'">
                        <group>
                            <field name="name" required="mode == 'new'" placeholder="Ej. Antonio Graterol"/>
                            <field name="email" required="mode == 'new'" widget="email" placeholder="correo@ejemplo.com"/>
                            <field name="phone" widget="phone"/>
                        </group>
                        <group>
                            <field name="access_type" widget="radio"/>
                            <field name="send_invitation"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_add" type="object" string="Agregar al equipo" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_creart_team_add_wizard" model="ir.actions.act_window">
            <field name="name">Agregar al equipo</field>
            <field name="res_model">creart.team.add.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        <record id="view_creart_team_users_search" model="ir.ui.view">
            <field name="name">res.users.creart.team.search</field>
            <field name="model">res.users</field>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <search string="Equipo en la app">
                    <field name="name"/>
                    <field name="login"/>
                    <filter name="filter_team" string="En el equipo" domain="[('creart_team_access', '=', True)]"/>
                    <filter name="filter_not_team" string="Fuera del equipo" domain="[('creart_team_access', '=', False)]"/>
                    <separator/>
                    <filter name="filter_portal" string="Portal" domain="[('share', '=', True)]"/>
                    <filter name="filter_internal" string="Internos" domain="[('share', '=', False)]"/>
                </search>
            </field>
        </record>
        <record id="view_creart_team_users_list" model="ir.ui.view">
            <field name="name">res.users.creart.team.list</field>
            <field name="model">res.users</field>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <list string="Equipo en la app" editable="bottom" create="0" delete="0">
                    <header>
                        <button name="%(crm_extended_3D.action_creart_team_add_wizard)d" type="action"
                                string="Agregar al equipo" class="btn-primary" display="always"/>
                    </header>
                    <field name="name" readonly="1"/>
                    <field name="login" readonly="1"/>
                    <field name="share" string="Usuario portal" readonly="1"/>
                    <field name="creart_team_access" widget="boolean_toggle"/>
                </list>
            </field>
        </record>
        <record id="action_creart_team_users" model="ir.actions.act_window">
            <field name="name">Equipo en la app</field>
            <field name="res_model">res.users</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_creart_team_users_list"/>
            <field name="search_view_id" ref="view_creart_team_users_search"/>
            <field name="context">{'search_default_filter_team': 1}</field>
            <field name="help" type="html">
                <p>Usa «Agregar al equipo» o activa aquí a las personas del equipo: entrarán directo a la app CreArt (celular o computadora).</p>
                <p>Pueden ser usuarios internos o de portal.</p>
            </field>
        </record>
        <menuitem id="menu_creart_config_team" name="Equipo en la app"
                  parent="menu_creart_config_root" action="action_creart_team_users"
                  groups="base.group_erp_manager" sequence="45"/>
    </data>
</odoo>
