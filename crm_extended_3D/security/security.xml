<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="module_category_crm_extended_3d">
            <field name="name">CRM Extended 3D</field>
            <field name="description">User access level for this module</field>
            <field name="sequence">3</field>
        </record>
        <record id="privilege_crm_extended_3d" model="res.groups.privilege">
            <field name="name">CRM Extended 3D</field>
            <field name="category_id" ref="module_category_crm_extended_3d"/>
        </record>
        <record id="crm_extended_3D.group_crm_user" model="res.groups">
            <field name="name">User: CRM</field>
            <field name="privilege_id" ref="privilege_crm_extended_3d"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="crm_extended_3D.group_crm_manager" model="res.groups">
            <field name="name">Manager: CRM</field>
            <field name="privilege_id" ref="privilege_crm_extended_3d"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('crm_extended_3D.group_crm_user'))]"/>
        </record>
        <record id="group_creart_commercial_director" model="res.groups">
            <field name="name">Dirección Comercial CreArt</field>
            <field name="privilege_id" ref="privilege_crm_extended_3d"/>
            <field name="implied_ids" eval="[(4, ref('crm_extended_3D.group_crm_manager'))]"/>
        </record>
    </data>
</odoo>
