<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bita_platform_view_kanban" model="ir.ui.view">
        <field name="name">bita.platform.kanban</field>
        <field name="model">bita.platform</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="enforce"/>
                <templates>
                    <t t-name="card" class="flex-row align-items-center gap-3">
                        <field name="image" widget="image" options="{'size': [64, 64]}"/>
                        <div class="flex-grow-1">
                            <field name="name" class="fw-bold fs-5 d-block"/>
                            <field name="tagline" class="text-muted small d-block"/>
                            <div class="mt-1 small">
                                <span t-if="record.enforce.raw_value" class="badge text-bg-success">Control activo</span>
                                <span t-else="" class="badge text-bg-warning">Control apagado</span>
                                <span class="ms-2"><field name="active_count"/> vigentes</span>
                                <span class="ms-2 text-warning"><field name="expiring_count"/> por vencer</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="bita_platform_view_form" model="ir.ui.view">
        <field name="name">bita.platform.form</field>
        <field name="model">bita.platform</field>
        <field name="arch" type="xml">
            <form string="Plataforma">
                <header>
                    <button name="action_grant_courtesy" type="object" string="Dar prueba / cortesía a usuarios actuales"
                            invisible="enforce"
                            help="Crea suscripciones de prueba (o cortesía) para quienes ya tienen permisos, para que nadie se quede fuera al encender el control."/>
                    <button name="action_enforce" type="object" string="Encender control por suscripción"
                            class="btn-primary" invisible="enforce"
                            confirm="Quien no tenga suscripción vigente perderá los permisos de esta plataforma. ¿Continuar?"/>
                    <button name="action_stop_enforce" type="object" string="Apagar control"
                            invisible="not enforce"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_subscriptions" type="object" class="oe_stat_button" icon="fa-id-card">
                            <field name="active_count" widget="statinfo" string="Vigentes"/>
                        </button>
                        <button name="action_view_subscriptions" type="object" class="oe_stat_button" icon="fa-hourglass-half">
                            <field name="expiring_count" widget="statinfo" string="Por vencer"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Control activo" bg_color="text-bg-success" invisible="not enforce"/>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <field name="tagline" placeholder="Lema"/>
                    </div>
                    <group>
                        <group string="Acceso">
                            <field name="enforce" readonly="1"/>
                            <field name="trial_months"/>
                            <field name="grace_days"/>
                            <field name="notice_days"/>
                            <field name="courtesy_until" invisible="enforce"/>
                        </group>
                        <group string="Precios de referencia">
                            <field name="price_month"/>
                            <field name="price_year"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="code" groups="base.group_no_one"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Permisos que controla">
                        <field name="group_ids" widget="many2many_tags" nolabel="1" colspan="2"/>
                        <field name="default_group_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bita_platform_action" model="ir.actions.act_window">
        <field name="name">Plataformas</field>
        <field name="res_model">bita.platform</field>
        <field name="view_mode">kanban,form</field>
    </record>
</odoo>
