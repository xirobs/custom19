<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_bita" model="ir.module.category">
            <field name="name">Suscripciones BitaScout</field>
            <field name="sequence">61</field>
        </record>
        <record id="res_groups_privilege_bita" model="res.groups.privilege">
            <field name="name">Suscripciones BitaScout</field>
            <field name="sequence">61</field>
            <field name="category_id" ref="module_category_bita"/>
        </record>
        <record id="group_bita_manager" model="res.groups">
            <field name="name">Administrador de suscripciones</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_bita"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
    <data noupdate="1">
        <!-- Cada usuario ve sus propias suscripciones; el administrador ve todas -->
        <record id="rule_bita_subscription_own" model="ir.rule">
            <field name="name">Suscripciones: las propias</field>
            <field name="model_id" ref="model_bita_subscription"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('base.group_portal'))]"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_bita_subscription_manager" model="ir.rule">
            <field name="name">Suscripciones: administrador ve todas</field>
            <field name="model_id" ref="model_bita_subscription"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_bita_manager'))]"/>
        </record>
    </data>
</odoo>
