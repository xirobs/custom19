<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_bni_user" model="res.groups">
        <field name="name">BNI: Asistencia (Usuario)</field>
        <field name="comment">Puede tomar asistencia, registrar observaciones y consultar reportes.</field>
    </record>

    <record id="group_bni_manager" model="res.groups">
        <field name="name">BNI: Administrador</field>
        <field name="comment">Configura eventos y miembros, abre/cierra sesiones y elimina registros.</field>
        <field name="implied_ids" eval="[(4, ref('group_bni_user'))]"/>
    </record>

    <!-- Los administradores de Odoo obtienen el rol de Administrador BNI -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_bni_manager'))]"/>
    </record>

    <!-- Reglas multiempresa -->
    <record id="rule_bni_member_company" model="ir.rule">
        <field name="name">BNI Miembro: multiempresa</field>
        <field name="model_id" ref="model_bni_member"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bni_event_company" model="ir.rule">
        <field name="name">BNI Evento: multiempresa</field>
        <field name="model_id" ref="model_bni_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bni_attendance_company" model="ir.rule">
        <field name="name">BNI Asistencia: multiempresa</field>
        <field name="model_id" ref="model_bni_attendance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bni_member_note_company" model="ir.rule">
        <field name="name">BNI Observación: multiempresa</field>
        <field name="model_id" ref="model_bni_member_note"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bni_member_movement_company" model="ir.rule">
        <field name="name">BNI Movimiento: multiempresa</field>
        <field name="model_id" ref="model_bni_member_movement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
