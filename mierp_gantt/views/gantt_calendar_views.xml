<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_gantt_calendar_list" model="ir.ui.view">
        <field name="name">mierp.gantt.calendar.list</field>
        <field name="model">mierp.gantt.calendar</field>
        <field name="arch" type="xml">
            <list string="Working Calendars">
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
                <field name="workdays"/>
                <field name="daily_hours"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_gantt_calendar_form" model="ir.ui.view">
        <field name="name">mierp.gantt.calendar.form</field>
        <field name="model">mierp.gantt.calendar</field>
        <field name="arch" type="xml">
            <form string="Working Calendar">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Standard Mon-Fri 8h"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="country_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="workdays" placeholder="0,1,2,3,4"/>
                            <field name="daily_hours"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="holidays" string="Holidays">
                            <field name="holiday_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="is_recurring" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page name="note" string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gantt_calendar" model="ir.actions.act_window">
        <field name="name">Working Calendars</field>
        <field name="res_model">mierp.gantt.calendar</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
