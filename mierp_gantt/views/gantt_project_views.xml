<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_gantt_project_kanban" model="ir.ui.view">
        <field name="name">mierp.gantt.project.kanban</field>
        <field name="model">mierp.gantt.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_color_#{record.color.raw_value}">
                            <div class="o_kanban_record_top mb8">
                                <div class="o_kanban_record_headings flex-grow-1">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <div class="text-muted small"><field name="code"/></div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6"><i class="fa fa-play me-1" title="Start"/><field name="date_start"/></div>
                                <div class="col-6 text-end"><i class="fa fa-flag-checkered me-1" title="End"/><field name="date_end"/></div>
                            </div>
                            <div class="row mt-1">
                                <div class="col-12"><i class="fa fa-tasks me-1" title="Tasks"/><field name="task_count"/> tasks</div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-12">
                                    <button name="action_open_gantt" type="object"
                                            class="btn btn-sm btn-primary w-100">
                                        Open Gantt
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_gantt_project_list" model="ir.ui.view">
        <field name="name">mierp.gantt.project.list</field>
        <field name="model">mierp.gantt.project</field>
        <field name="arch" type="xml">
            <list string="Gantt Projects">
                <field name="name"/>
                <field name="code"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="task_count"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'active'"
                       decoration-muted="state == 'draft'"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'on_hold'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_gantt_project_form" model="ir.ui.view">
        <field name="name">mierp.gantt.project.form</field>
        <field name="model">mierp.gantt.project</field>
        <field name="arch" type="xml">
            <form string="Gantt Project">
                <header>
                    <button name="action_open_gantt" type="object" string="Open Gantt" class="oe_highlight"
                            icon="fa-bar-chart"/>
                    <button name="action_create_baseline" type="object" string="Snapshot Baseline"
                            icon="fa-camera"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_gantt" type="object" class="oe_stat_button" icon="fa-bar-chart">
                            <field name="task_count" widget="statinfo" string="Tasks"/>
                        </button>
                        <button name="%(action_gantt_baseline)d" type="action" class="oe_stat_button"
                                icon="fa-camera">
                            <field name="baseline_count" widget="statinfo" string="Baselines"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Project name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="calendar_id"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="tasks" string="Tasks">
                            <field name="task_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="wbs"/>
                                    <field name="name"/>
                                    <field name="parent_id"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="duration_days"/>
                                    <field name="progress_pct" widget="percentage"/>
                                    <field name="is_milestone" widget="boolean_toggle"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page name="description" string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_gantt_project" model="ir.actions.act_window">
        <field name="name">Gantt Projects</field>
        <field name="res_model">mierp.gantt.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Gantt project</p>
            <p>Schedule tasks, manage dependencies, track baselines and visualise the critical path.</p>
        </field>
    </record>

</odoo>
