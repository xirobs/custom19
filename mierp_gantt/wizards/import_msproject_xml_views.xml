<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_import_msproject_form" model="ir.ui.view">
        <field name="name">mierp.gantt.import.msproject.form</field>
        <field name="model">mierp.gantt.import.msproject</field>
        <field name="arch" type="xml">
            <form string="Import MSPDI XML">
                <group>
                    <field name="project_id"/>
                    <field name="file_data" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                    <field name="replace_existing" widget="boolean_toggle"/>
                </group>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_msproject" model="ir.actions.act_window">
        <field name="name">Import from MS Project (.xml)</field>
        <field name="res_model">mierp.gantt.import.msproject</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
